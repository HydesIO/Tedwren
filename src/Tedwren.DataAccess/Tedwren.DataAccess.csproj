<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dapper over both engines; provider-specific ADO.NET drivers for SQL Server and PostgreSQL.
         Wired here in Phase 7; consumed by the shared repository base and dialects in Phase 8. -->
