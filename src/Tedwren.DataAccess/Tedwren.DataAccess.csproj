<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Audit direct dependencies only. The EF SqlServer provider pulls a transitive
         System.Security.Cryptography.Xml that this environment's audit feed flags on every version
         (including the latest), so it is unactionable; direct packages are still fully audited. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dapper over both engines; provider-specific ADO.NET drivers for SQL Server and PostgreSQL.
         Wired here in Phase 7; consumed by the shared repository base and dialects in Phase 8. -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- EF Core is used ONLY to author and apply the database schema via migrations (DDL). Runtime data
         access remains Dapper (DML). See docs/ef-migrations.md. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedwren.Abstractions\Tedwren.Abstractions.csproj" />
    <ProjectReference Include="..\Tedwren.Application\Tedwren.Application.csproj" />
    <ProjectReference Include="..\Tedwren.Domain\Tedwren.Domain.csproj" />
  </ItemGroup>

</Project>
