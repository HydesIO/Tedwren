@page "/operative/profile"
@inject OperativeDataService Data

@* The operative's own profile — identity, employer, compliance and emergency contact (M3), mirroring ProfilePage. *@

<div class="tw-screen">
    <h1 class="tw-screen__title">Profile</h1>

    @if (_loading)
    {
        <TwCard><TwSkeleton Lines="5" /></TwCard>
    }
    else if (_profile is null)
    {
        <div class="tw-banner tw-banner--warning">Couldn't load your profile.</div>
    }
    else
    {
        <TwCard>
            <div class="tw-profile__name">@_profile.Name</div>
            <dl class="tw-rows">
                <div class="tw-row-pair"><dt>Trade</dt><dd>@(_profile.Trade ?? "—")</dd></div>
                <div class="tw-row-pair"><dt>Employer</dt><dd>@_profile.Company</dd></div>
                <div class="tw-row-pair"><dt>Mobile</dt><dd>@(_profile.Phone ?? "—")</dd></div>
                <div class="tw-row-pair"><dt>Compliance</dt><dd>@_profile.StatusLabel</dd></div>
                <div class="tw-row-pair"><dt>Emergency contact</dt><dd>@EmergencyContact</dd></div>
            </dl>
        </TwCard>
    }

    <div class="tw-screen__footnote"><a href="/operative">Back to home</a></div>
</div>

@code {
    private OperativeDetailDto? _profile;
    private bool _loading = true;

    private string EmergencyContact => _profile?.EmergencyContactName is null
        ? "—"
        : $"{_profile.EmergencyContactName} · {_profile.EmergencyContactPhone}";

    /// <summary>Loads the operative's profile when the page opens.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Data.GetProfileAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _profile = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
