@page "/operative/hazard"
@inject IOutboxStore Outbox
@inject SyncEngine Sync
@inject IConnectivityService Connectivity
@inject OperativeDataService Data
@inject WebGeolocation Geo

@* Report a hazard / near-miss (M5) — mirrors the native ReportHazardPage: hse-module-gated (hidden when off),
   queued to the outbox and synced when online. Same enqueue as the app, so the sync path is shared. *@

<div class="tw-screen">
    <h1 class="tw-screen__title">Report hazard</h1>

    @if (_checking)
    {
        <TwCard><TwSkeleton Lines="3" /></TwCard>
    }
    else if (!_canReport)
    {
        <div class="tw-banner tw-banner--warning">Hazard reporting isn't enabled for your organisation. You can still capture evidence.</div>
    }
    else
    {
        <div class="tw-banner tw-banner--info">
            Add a photo, type and description. It's saved on your device, uploads when you're online, and your manager reviews it.
        </div>

        <div class="tw-field">
            <label class="tw-label" for="kind">Type</label>
            <select id="kind" class="tw-input" @bind="_kind">
                @foreach (var (label, value) in Kinds)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>

        <div class="tw-field">
            <label class="tw-label" for="severity">Severity</label>
            <select id="severity" class="tw-input" @bind="_severity">
                @foreach (var severity in Severities)
                {
                    <option value="@severity">@severity</option>
                }
            </select>
        </div>

        <TwPhotoInput @key="_photoInputKey" OnCaptured="OnPhoto" />

        <div class="tw-field">
            <label class="tw-label" for="description">Description</label>
            <textarea id="description" class="tw-input" rows="4" @bind="_description" placeholder="Describe what you saw"></textarea>
        </div>

        <div class="tw-field">
            <label class="tw-label" for="location">Location</label>
            <input id="location" class="tw-input" @bind="_location" placeholder="e.g. Level 3, east core" />
        </div>

        @if (_result is not null)
        {
            <div class="tw-banner tw-banner--@_bannerSeverity">@_result</div>
        }

        <button type="button" class="tw-btn tw-btn--primary tw-btn--block" @onclick="SaveAsync" disabled="@_busy">Report hazard</button>
    }

    <div class="tw-screen__footnote"><a href="/operative">Back to home</a></div>
</div>

@code {
    private static readonly (string Label, string Value)[] Kinds =
    {
        ("Near miss", "NearMiss"), ("Hazard", "Hazard"), ("Unsafe act", "UnsafeAct"), ("Unsafe condition", "UnsafeCondition"),
    };

    private static readonly string[] Severities = { "Low", "Medium", "High" };
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private bool _checking = true;
    private bool _canReport;
    private string _kind = "NearMiss";
    private string _severity = "Medium";
    private string? _description;
    private string? _location;
    private byte[]? _photo;
    private string? _photoType;
    private int _photoInputKey;
    private string? _result;
    private string _bannerSeverity = "success";
    private bool _busy;

    /// <summary>Checks the hse module entitlement (from the cached dashboard) before showing the form.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dashboard = await Data.GetDashboardAsync();
            _canReport = dashboard?.CanReportHazards ?? false;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _canReport = false;
        }
        finally
        {
            _checking = false;
        }
    }

    private void OnPhoto(TwPhotoInput.PhotoCapture capture)
    {
        _photo = capture.Bytes;
        _photoType = capture.ContentType;
    }

    /// <summary>Queues the hazard report to the outbox (like the app) and nudges a sync.</summary>
    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_description))
        {
            ShowResult("Describe what you saw.", "warning");
            return;
        }

        _busy = true;
        try
        {
            var clientId = Guid.NewGuid();
            var capturedUtc = DateTimeOffset.UtcNow;
            var geo = await Geo.TryGetAsync();
            var request = new MobileReportHazardRequest(
                clientId, _kind, _description!.Trim(), Clean(_location), geo?.Latitude, geo?.Longitude, null, _severity, null, capturedUtc);

            await Outbox.EnqueueAsync(new OutboxItem
            {
                Id = clientId,
                Kind = HazardOutboxHandler.ItemKind,
                PayloadJson = JsonSerializer.Serialize(request, Json),
                PhotoBytes = _photo,
                PhotoContentType = _photoType,
                CreatedUtc = capturedUtc,
            });
            Sync.RequestSync();

            ShowResult(Connectivity.IsConnected ? "Saved — uploading now." : "Saved on your device — it'll upload when you're online.", "success");
            _photo = null;
            _photoType = null;
            _description = string.Empty;
            _location = string.Empty;
            _photoInputKey++;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ShowResult("Couldn't save. Please try again.", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void ShowResult(string text, string severity)
    {
        _result = text;
        _bannerSeverity = severity;
    }
}
