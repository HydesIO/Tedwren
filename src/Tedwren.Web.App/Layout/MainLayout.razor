@inherits LayoutComponentBase
@implements IDisposable
@inject EmulatorState State
@inject NavigationManager Nav
@inject ManagerSessionManager ManagerSession
@inject WebConnectivityService Connectivity

@* The emulator shell: the "device lab" chrome (brand, device-size toggle, theme toggle) around the device frame.
   Every screen renders inside an ErrorBoundary so an API/render error surfaces a recoverable panel rather than
   blanking the whole app — mirroring the console's MainLayout hardening — and the boundary resets on navigation. *@

<div class="tw-emulator">
    <header class="tw-emulator__bar">
        <div class="tw-emulator__brand">
            <img src="images/logo-icon.svg" alt="" class="tw-emulator__logo" />
            <div>
                <div class="tw-emulator__title">Tedwren mobile emulator</div>
                <div class="tw-emulator__subtitle">Same screens · same API · phone &amp; tablet only</div>
            </div>
        </div>
        <div class="tw-emulator__controls">
            <div class="tw-seg" role="group" aria-label="Device size">
                <button type="button" class="tw-seg__btn @(State.Device == DevicePreset.Phone ? "is-active" : null)"
                        @onclick="() => State.SetDevice(DevicePreset.Phone)">Phone</button>
                <button type="button" class="tw-seg__btn @(State.Device == DevicePreset.Tablet ? "is-active" : null)"
                        @onclick="() => State.SetDevice(DevicePreset.Tablet)">Tablet</button>
            </div>
            <button type="button" class="tw-iconbtn" @onclick="State.ToggleTheme"
                    aria-label="@(State.IsDarkMode ? "Switch to light theme" : "Switch to dark theme")">
                @(State.IsDarkMode ? "☀" : "☾")
            </button>
            <button type="button" class="tw-iconbtn @(Connectivity.IsConnected ? null : "is-offline")" @onclick="ToggleConnectivity"
                    title="@(Connectivity.IsConnected ? "Online — click to simulate offline" : "Offline — click to go back online")"
                    aria-label="@(Connectivity.IsConnected ? "Simulate offline" : "Go back online")">
                @(Connectivity.IsConnected ? "🌐" : "✈")
            </button>
        </div>
    </header>

    <main class="tw-emulator__stage">
        <DeviceFrame Device="State.Device" Dark="State.IsDarkMode" Offline="!Connectivity.IsConnected">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="tw-screen tw-screen--center">
                        <div class="tw-empty__glyph">⚠</div>
                        <h1 class="tw-screen__title">Something went wrong</h1>
                        <p class="tw-muted">This screen hit an unexpected error. You can try again.</p>
                        <button type="button" class="tw-btn tw-btn--primary" @onclick="Recover">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </DeviceFrame>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    /// <summary>Subscribes to chrome changes, navigation (to reset the error boundary), and manager session expiry.</summary>
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        ManagerSession.SessionExpired += OnManagerSessionExpired;
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnConnectivityChanged(object? sender, bool connected) => InvokeAsync(StateHasChanged);

    // Flips the emulator between online and offline so offline capture/queue/drain-on-reconnect can be tested.
    private void ToggleConnectivity() => Connectivity.SetConnected(!Connectivity.IsConnected);

    // A caught error on one screen must not stick to the next — recover the boundary whenever the route changes.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _errorBoundary?.Recover();

    // The console token can't be silently refreshed once its refresh token is gone — route back to manager sign-in.
    private void OnManagerSessionExpired(object? sender, EventArgs e) =>
        InvokeAsync(() => Nav.NavigateTo("/manager/sign-in"));

    private void Recover() => _errorBoundary?.Recover();

    /// <summary>Unsubscribes from the shell events.</summary>
    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        ManagerSession.SessionExpired -= OnManagerSessionExpired;
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
    }
}
