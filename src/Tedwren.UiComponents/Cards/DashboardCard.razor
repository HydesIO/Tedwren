@* Generic bordered / shadowed card shell with a title row and optional footer link. *@

<section class="dash-card">
    @if (!string.IsNullOrEmpty(Title) || HeaderActions is not null)
    {
        <header class="dash-card__header">
            <div class="dash-card__titles">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h3 class="dash-card__title">@Title</h3>
                }
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="dash-card__subtitle">@Subtitle</p>
                }
            </div>
            @if (HeaderActions is not null)
            {
                <div class="dash-card__actions">@HeaderActions</div>
            }
        </header>
    }

    <div class="dash-card__body @(_hasHeader ? null : "dash-card__body--no-header")">
        @Body
    </div>

    @if (!string.IsNullOrEmpty(FooterLinkText))
    {
        <footer class="dash-card__footer">
            <a href="@(FooterLinkHref ?? "#")" class="dash-card__footer-link">
                @FooterLinkText
                <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
            </a>
        </footer>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public string? FooterLinkText { get; set; }
    [Parameter] public string? FooterLinkHref { get; set; }

    private bool _hasHeader => !string.IsNullOrEmpty(Title) || HeaderActions is not null;
}
