@* Top bar: page title, global search, notifications, help, profile menu. *@

<header class="topbar">
    <div class="topbar__lead">
        @if (ShowMenuButton)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                           Size="Size.Medium"
                           aria-label="Toggle navigation"
                           OnClick="OnMenuClick" />
        }
        <h1 class="topbar__title">@PageTitle</h1>
    </div>

    <div class="topbar__search">
        <button type="button" class="topbar__search-trigger" @onclick="OnOpenSearch" aria-label="Open search (Ctrl K)">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="topbar__search-icon" />
            <span class="topbar__search-text">Search operatives, sites, permits…</span>
            <span class="topbar__search-keys">
                <kbd>Ctrl</kbd><kbd>K</kbd>
            </span>
        </button>
    </div>

    <div class="topbar__actions">
        <MudIconButton Icon="@(IsDark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       Size="Size.Medium"
                       aria-label="@(IsDark ? "Switch to light theme" : "Switch to dark theme")"
                       OnClick="OnToggleTheme" />
        <NotificationsMenu Notifications="Notifications" ViewAllHref="@NotificationsHref" />
        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline"
                       Size="Size.Medium"
                       aria-label="Help" />
        <div class="topbar__divider" aria-hidden="true"></div>
        <ProfileMenu UserName="@CurrentUserName" UserRole="@CurrentUserRole"
                     AvatarUrl="@CurrentUserAvatarUrl" OnSignOut="OnSignOut" />
    </div>
</header>

@code {
    [Parameter] public string PageTitle { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<NotificationEntry> Notifications { get; set; } = Array.Empty<NotificationEntry>();
    [Parameter] public string NotificationsHref { get; set; } = "/notifications";
    [Parameter] public string CurrentUserName { get; set; } = string.Empty;
    [Parameter] public string CurrentUserRole { get; set; } = string.Empty;
    [Parameter] public string? CurrentUserAvatarUrl { get; set; }
    [Parameter] public bool ShowMenuButton { get; set; }
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public EventCallback OnMenuClick { get; set; }
    [Parameter] public EventCallback OnOpenSearch { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }
}
