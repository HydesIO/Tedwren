@* Avatar + name + role with a slim custom dropdown (no bulky MudMenu). *@

<Flyout Align="Flyout.FlyoutAlign.Right" Width="248px">
    <Trigger>
        <button type="button" class="profile" aria-label="Open profile menu">
            <span class="profile__avatar" aria-hidden="true">
                @if (!string.IsNullOrEmpty(AvatarUrl))
                {
                    <img src="@AvatarUrl" alt="" />
                }
                else
                {
                    <span>@Initials</span>
                }
            </span>
            <span class="profile__meta">
                <span class="profile__name">@UserName</span>
                <span class="profile__role">@UserRole</span>
            </span>
            <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" Class="profile__chevron" />
        </button>
    </Trigger>
    <ChildContent>
        <div class="menu">
            <div class="menu__header">
                <span class="menu__avatar" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(AvatarUrl))
                    {
                        <img src="@AvatarUrl" alt="" />
                    }
                    else
                    {
                        <span>@Initials</span>
                    }
                </span>
                <span class="menu__id">
                    <span class="menu__name">@UserName</span>
                    <span class="menu__role">@UserRole</span>
                </span>
            </div>

            <div class="menu__list">
                <a class="menu__item" href="@ProfileHref">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                    <span>Profile</span>
                </a>
                <a class="menu__item" href="@SettingsHref">
                    <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />
                    <span>Settings</span>
                </a>
            </div>

            <div class="menu__divider"></div>

            <div class="menu__list">
                <button type="button" class="menu__item menu__item--danger" @onclick="OnSignOut">
                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                    <span>Sign out</span>
                </button>
            </div>
        </div>
    </ChildContent>
</Flyout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = default!;
    [Parameter] public string UserRole { get; set; } = string.Empty;
    [Parameter] public string? AvatarUrl { get; set; }
    [Parameter] public string ProfileHref { get; set; } = "#";
    [Parameter] public string SettingsHref { get; set; } = "/system-configuration";
    [Parameter] public EventCallback OnSignOut { get; set; }

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(UserName)) return "?";
            var parts = UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
            };
        }
    }
}
