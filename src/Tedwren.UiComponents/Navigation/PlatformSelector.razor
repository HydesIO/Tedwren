@* Bordered dropdown for the active tenant / platform / environment. *@

<div class="platform-selector">
    <MudMenu FullWidth="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
        <ActivatorContent>
            <div class="platform-selector__trigger" role="button" tabindex="0" aria-label="Select platform">
                <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" Class="platform-selector__lead" />
                <span class="platform-selector__label">@SelectedLabel</span>
                <MudIcon Icon="@Icons.Material.Outlined.UnfoldMore" Size="Size.Small" Class="platform-selector__chevron" />
            </div>
        </ActivatorContent>
        <ChildContent>
            @foreach (var option in Options)
            {
                <MudMenuItem OnClick="@(() => OnSelected.InvokeAsync(option))">@option</MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
</div>

@code {
    [Parameter, EditorRequired] public string SelectedLabel { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> Options { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnSelected { get; set; }
}
