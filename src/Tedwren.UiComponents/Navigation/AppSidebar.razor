@* Application sidebar: brand mark, nav list, environment panel, collapse control. *@

<nav class="sidebar @(IsCollapsed ? "sidebar--collapsed" : null)" aria-label="Primary">
    <div class="sidebar__brand">
        @if (!string.IsNullOrEmpty(LogoUrl))
        {
            <img class="sidebar__logo-img" src="@LogoUrl" alt="@BrandName" width="32" height="32" />
        }
        else
        {
            <div class="sidebar__logo" aria-hidden="true">@BrandName.Substring(0, 1)</div>
        }
        @if (!IsCollapsed)
        {
            <span class="sidebar__wordmark">@BrandName</span>
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft"
                           Size="Size.Small"
                           Class="sidebar__collapse"
                           aria-label="Collapse sidebar"
                           OnClick="ToggleCollapse" />
        }
    </div>

    <div class="sidebar__nav">
        @if (IsCollapsed)
        {
            @* Collapsed rail has no room to expand groups, so render every destination as a flat icon row. *@
            @foreach (var leaf in NavItems.SelectMany(n => n.Leaves()))
            {
                <SidebarNavItem Icon="@leaf.Icon"
                                Label="@leaf.Label"
                                IsCollapsed="true"
                                IsActive="@IsActive(leaf)"
                                OnClick="@(() => OnNavigate.InvokeAsync(leaf))" />
            }
        }
        else
        {
            @foreach (var item in NavItems)
            {
                @if (item.HasChildren)
                {
                    <SidebarNavItem Icon="@item.Icon"
                                    Label="@item.Label"
                                    HasChildren="true"
                                    IsExpanded="@IsExpanded(item)"
                                    OnClick="@(() => ToggleGroup(item))" />
                    @if (IsExpanded(item))
                    {
                        <div class="sidebar__group">
                            @foreach (var child in item.Children!)
                            {
                                <SidebarNavItem Icon="@child.Icon"
                                                Label="@child.Label"
                                                IsChild="true"
                                                IsActive="@IsActive(child)"
                                                OnClick="@(() => OnNavigate.InvokeAsync(child))" />
                            }
                        </div>
                    }
                }
                else
                {
                    <SidebarNavItem Icon="@item.Icon"
                                    Label="@item.Label"
                                    IsActive="@IsActive(item)"
                                    OnClick="@(() => OnNavigate.InvokeAsync(item))" />
                }
            }
        }
    </div>

    @if (!IsCollapsed && Environment is not null)
    {
        <EnvironmentPanel EnvironmentName="@Environment.Name"
                          Version="@Environment.Version"
                          Build="@Environment.Build"
                          IsHealthy="@Environment.IsHealthy" />
    }
</nav>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }
    [Parameter] public string BrandName { get; set; } = "Tedwren";
    [Parameter] public string? LogoUrl { get; set; }
    [Parameter] public string? ActiveRoute { get; set; }
    [Parameter] public IReadOnlyList<NavItem> NavItems { get; set; } = Array.Empty<NavItem>();
    [Parameter] public EnvironmentInfo? Environment { get; set; }
    [Parameter] public EventCallback<NavItem> OnNavigate { get; set; }

    // Labels of expandable groups the user (or the active route) has opened. Only relevant when expanded.
    private readonly HashSet<string> _expandedGroups = new(StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        // Keep the group holding the current page open, so navigating to a child (e.g. Users) never hides it.
        foreach (var group in NavItems.Where(n => n.HasChildren))
        {
            if (group.Children!.Any(IsActive))
            {
                _expandedGroups.Add(group.Label);
            }
        }
    }

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private bool IsExpanded(NavItem group) => _expandedGroups.Contains(group.Label);

    private void ToggleGroup(NavItem group)
    {
        if (!_expandedGroups.Remove(group.Label))
        {
            _expandedGroups.Add(group.Label);
        }
    }

    private bool IsActive(NavItem item)
        => !string.IsNullOrEmpty(ActiveRoute)
           && !string.IsNullOrEmpty(item.Href)
           && ActiveRoute!.TrimStart('/').Equals(item.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);

    /// <summary>Lightweight view model for the environment panel.</summary>
    public sealed record EnvironmentInfo(string Name, string Version, string Build, bool IsHealthy);
}
