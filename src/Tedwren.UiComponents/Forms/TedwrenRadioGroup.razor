@* Wrapped MudRadioGroup with consistent label-above / helper / validation styling.
   A single choice from a small, always-visible option list. *@

<FormField Label="@Label" Required="Required"
           HelperText="@HelperText" Error="Error" ErrorText="@ErrorText">
    <MudRadioGroup T="string" Value="@Value" ValueChanged="@ValueChanged">
        @foreach (var option in Options)
        {
            <MudRadio T="string" Value="@option" Color="Color.Primary" Dense="true" Disabled="@Disabled">@option</MudRadio>
        }
    </MudRadioGroup>
</FormField>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IEnumerable<string> Options { get; set; } = Array.Empty<string>();
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
