@* Wrapped MudStepper for multi-step flows (onboarding, compliance pack builder).
   Consumers supply MudStep children; this standardises the stepper chrome. *@

<div class="tedwren-stepper">
    @* MudBlazor 8.x MudStepper API: linearity is expressed as NonLinear (the inverse of Linear), and the
       active-step accent is CurrentStepColor. MudStepper has no Variant/Color parameters — passing them
       silently splats them as no-op HTML attributes (MUD0002), so they are not used here. *@
    <MudStepper ActiveIndex="@ActiveIndex"
                ActiveIndexChanged="@OnActiveIndexChanged"
                OnPreviewInteraction="@OnPreviewInteraction"
                NonLinear="@(!Linear)"
                Class="tedwren-stepper__mud"
                CurrentStepColor="Color.Primary">
        <ChildContent>
            @ChildContent
        </ChildContent>
    </MudStepper>
</div>

@code {
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public bool Linear { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Fires before a step interaction (e.g. pressing Next, or activating a step header) is applied,
    /// so a consumer can validate the current step and cancel the move by setting
    /// <see cref="StepperInteractionEventArgs.Cancel"/>. Forwarded straight to the underlying MudStepper.
    /// </summary>
    [Parameter] public Func<StepperInteractionEventArgs, Task>? OnPreviewInteraction { get; set; }

    private async Task OnActiveIndexChanged(int index)
    {
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }
}
