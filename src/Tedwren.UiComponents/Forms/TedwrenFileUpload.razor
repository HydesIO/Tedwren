@using Microsoft.AspNetCore.Components.Forms
@* Card photo / document upload with drag-and-drop and a selected-file preview.
   UI-only for this phase: files are listed but not persisted anywhere. *@

<FormField Label="@Label" Required="Required" HelperText="@HelperText"
           Error="Error" ErrorText="@ErrorText">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                   FilesChanged="OnFilesChanged"
                   Accept="@Accept"
                   MaximumFileCount="@MaxFiles"
                   Hidden="false"
                   Class="file-upload">
        <ActivatorContent>
            <div class="file-upload__dropzone">
                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Class="file-upload__icon" />
                <span class="file-upload__primary">@PromptText</span>
                <span class="file-upload__secondary">@HintText</span>
            </div>
        </ActivatorContent>
    </MudFileUpload>
</FormField>

@if (_files.Count > 0)
{
    <ul class="file-upload__list">
        @foreach (var file in _files)
        {
            <li class="file-upload__item">
                <MudIcon Icon="@IconFor(file.Name)" Size="Size.Small" Class="file-upload__item-icon" />
                <div class="file-upload__item-meta">
                    <span class="file-upload__item-name">@file.Name</span>
                    <span class="file-upload__item-size">@FormatSize(file.Size)</span>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Close"
                               Size="Size.Small"
                               aria-label="@($"Remove {file.Name}")"
                               OnClick="@(() => Remove(file))" />
            </li>
        }
    </ul>
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string PromptText { get; set; } = "Drag & drop, or click to upload";
    [Parameter] public string HintText { get; set; } = "PNG, JPG or PDF up to 10MB";
    [Parameter] public string? Accept { get; set; } = ".png,.jpg,.jpeg,.pdf";
    [Parameter] public int MaxFiles { get; set; } = 10;
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> FilesChanged { get; set; }

    private readonly List<IBrowserFile> _files = new();

    private async Task OnFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is null) return;
        _files.Clear();
        _files.AddRange(files);
        await FilesChanged.InvokeAsync(_files);
    }

    private async Task Remove(IBrowserFile file)
    {
        _files.Remove(file);
        await FilesChanged.InvokeAsync(_files);
    }

    private static string IconFor(string name)
        => name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Outlined.PictureAsPdf
            : Icons.Material.Outlined.Image;

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576.0:0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B",
    };
}
