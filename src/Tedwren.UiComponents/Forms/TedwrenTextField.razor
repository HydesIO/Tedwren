@* Wrapped MudTextField with consistent label-above / helper / validation styling. *@

<FormField Label="@Label" For="@_id" Required="Required"
           HelperText="@HelperText" Error="Error" ErrorText="@ErrorText">
    <MudTextField T="string"
                  id="@_id"
                  Value="@Value"
                  ValueChanged="@ValueChanged"
                  Immediate="@Immediate"
                  Placeholder="@Placeholder"
                  Lines="@Lines"
                  InputType="@InputType"
                  Disabled="@Disabled"
                  ReadOnly="@ReadOnly"
                  Error="@Error"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  FullWidth="true"
                  Adornment="@(string.IsNullOrEmpty(AdornmentIcon) ? Adornment.None : Adornment.Start)"
                  AdornmentIcon="@AdornmentIcon" />
</FormField>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public InputType InputType { get; set; } = InputType.Text;
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? AdornmentIcon { get; set; }

    private readonly string _id = "tf-" + Guid.NewGuid().ToString("N")[..8];
}
