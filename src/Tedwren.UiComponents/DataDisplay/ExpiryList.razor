@using Tedwren.UiComponents.Models
@* Repeated "item / site / expiry / days remaining" rows. *@

<ul class="expiry-list">
    @foreach (var item in Items)
    {
        <li class="expiry-list__row">
            <div class="expiry-list__main">
                <span class="expiry-list__title">@item.Title</span>
                <span class="expiry-list__site">@item.Site</span>
            </div>
            <div class="expiry-list__right">
                <span class="expiry-list__date">@item.ExpiresOn.ToString("dd MMM yyyy")</span>
                <StatusPill Label="@DaysLabel(item)" Status="item.Status" />
            </div>
        </li>
    }
</ul>

@code {
    [Parameter] public IEnumerable<ExpiryItem> Items { get; set; } = Array.Empty<ExpiryItem>();

    // Builds the "days remaining" label. Written as an if-chain rather than a switch
    // expression on purpose: a switch arm whose relational pattern starts with '<'
    // (e.g. "< 0 =>") sits at statement position inside a Razor @code block, where the
    // parser treats the leading '<' as an HTML markup transition and truncates the method.
    private static string DaysLabel(ExpiryItem item)
    {
        var days = item.DaysRemaining;
        if (days < 0) return $"Expired {Math.Abs(days)}d ago";
        if (days == 0) return "Expires today";
        if (days == 1) return "1 day left";
        return $"{days} days left";
    }
}
