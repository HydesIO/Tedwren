@typeparam TItem
@using Tedwren.UiComponents.Feedback

@* Generic sortable / filterable table wrapper over MudTable. Client-side search + filters. *@

<div class="data-table">
    <div class="data-table__toolbar">
        @if (Searchable)
        {
            <div class="data-table__search">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="data-table__search-icon" />
                <input class="data-table__search-input"
                       type="search"
                       placeholder="@SearchPlaceholder"
                       aria-label="@SearchPlaceholder"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
        }

        @foreach (var col in _filterColumns)
        {
            <MudSelect T="string"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Placeholder="@col.Title"
                       Value="@GetFilter(col.Title)"
                       ValueChanged="@(v => SetFilter(col.Title, v))"
                       Class="data-table__filter">
                @foreach (var option in _filterOptions[col.Title])
                {
                    <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                }
            </MudSelect>
        }

        @if (_hasActiveFilters)
        {
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       OnClick="ClearFilters">
                Clear
            </MudButton>
        }

        @if (Actions is not null)
        {
            <div class="data-table__actions">@Actions</div>
        }
    </div>

    <MudTable T="TItem"
              Items="@Items"
              Filter="@FilterPredicate"
              Hover="true"
              Dense="false"
              Elevation="0"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="HandleRowClick"
              RowClass="@(OnRowClick.HasDelegate ? "data-table__row--clickable" : null)"
              Class="data-table__mud">
        <HeaderContent>
            @foreach (var col in Columns)
            {
                <MudTh Class="@(col.AlignRight ? "data-table__th--right" : null)">
                    @if (col.Sortable && col.Value is not null)
                    {
                        <MudTableSortLabel T="TItem" SortBy="@(item => col.Value(item) ?? string.Empty)">
                            @col.Title
                        </MudTableSortLabel>
                    }
                    else
                    {
                        @col.Title
                    }
                </MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @foreach (var col in Columns)
            {
                <MudTd DataLabel="@col.Title" Class="@(col.AlignRight ? "data-table__td--right" : null)">
                    @if (col.CellTemplate is not null)
                    {
                        @col.CellTemplate(context)
                    }
                    else
                    {
                        @col.TextOf(context)
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@EmptyIcon"
                        Title="@EmptyTitle"
                        Description="@(_hasActiveFilters || !string.IsNullOrWhiteSpace(_search) ? "No records match your search or filters." : EmptyDescription)" />
        </NoRecordsContent>
        <PagerContent>
            @if (ShowPager)
            {
                <MudTablePager PageSizeOptions="@PageSizeOptions" />
            }
        </PagerContent>
    </MudTable>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public IReadOnlyList<DataColumn<TItem>> Columns { get; set; } = Array.Empty<DataColumn<TItem>>();
    [Parameter] public bool Searchable { get; set; } = true;
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";
    [Parameter] public bool ShowPager { get; set; } = true;
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 10, 25, 50 };
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    // Empty-state copy
    [Parameter] public string EmptyIcon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter] public string EmptyTitle { get; set; } = "Nothing here yet";
    [Parameter] public string EmptyDescription { get; set; } = "There are no records to display.";

    private string _search = string.Empty;
    private readonly Dictionary<string, string?> _filters = new();
    private IReadOnlyList<DataColumn<TItem>> _filterColumns = Array.Empty<DataColumn<TItem>>();
    private readonly Dictionary<string, IReadOnlyList<string>> _filterOptions = new();

    private bool _hasActiveFilters => _filters.Values.Any(v => !string.IsNullOrEmpty(v));

    protected override void OnParametersSet()
    {
        _filterColumns = Columns.Where(c => c.Filterable).ToList();
        _filterOptions.Clear();
        foreach (var col in _filterColumns)
        {
            _filterOptions[col.Title] = Items
                .Select(col.TextOf)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .OrderBy(s => s)
                .ToList();
        }
    }

    private string? GetFilter(string title) => _filters.TryGetValue(title, out var v) ? v : null;

    private void SetFilter(string title, string? value) => _filters[title] = value;

    private void ClearFilters()
    {
        _filters.Clear();
        _search = string.Empty;
    }

    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private bool FilterPredicate(TItem item)
    {
        // Text search across searchable columns.
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            var match = Columns
                .Where(c => c.Searchable)
                .Any(c => c.TextOf(item).Contains(term, StringComparison.OrdinalIgnoreCase));
            if (!match) return false;
        }

        // Distinct-value column filters.
        foreach (var (title, value) in _filters)
        {
            if (string.IsNullOrEmpty(value)) continue;
            var col = _filterColumns.FirstOrDefault(c => c.Title == title);
            if (col is null) continue;
            if (!string.Equals(col.TextOf(item), value, StringComparison.Ordinal)) return false;
        }

        return true;
    }

    private Task HandleRowClick(TableRowClickEventArgs<TItem> args)
        => OnRowClick.HasDelegate && args.Item is not null
            ? OnRowClick.InvokeAsync(args.Item)
            : Task.CompletedTask;
}
