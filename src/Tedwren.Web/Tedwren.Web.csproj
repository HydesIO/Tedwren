<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Content types + IContentProvider live in Abstractions so the product-owned compliance-pack
         viewer can reuse the same site/brand content (Plan §3, §4.1). -->
    <ProjectReference Include="..\Tedwren.Abstractions\Tedwren.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON content files are read from the content root at runtime; copy them to the publish output
         so a published app finds them. In dev/test the content root is the project dir (source files). -->
    <Content Update="Content\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Single source of truth for design tokens: the file lives in Tedwren.Client. It is copied into
       this project's wwwroot at build so the site can serve it and no colour/spacing literal is ever
       duplicated. The copy is git-ignored (see .gitignore) — the client file remains the only source. -->
  <Target Name="ShareTokensCss" BeforeTargets="BeforeBuild;BeforeRebuild">
    <Copy SourceFiles="..\Tedwren.Client\wwwroot\css\tokens.css"
          DestinationFiles="wwwroot\css\tokens.css"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Same single-source discipline for the brand logo: the SVG lives in Tedwren.Client and is copied
       into this project's wwwroot at build so the marketing header/footer serve the same mark as the
       app. The copy is git-ignored (see .gitignore) — the client file remains the only source. -->
  <Target Name="ShareBrandLogo" BeforeTargets="BeforeBuild;BeforeRebuild">
    <MakeDir Directories="wwwroot\images" />
    <Copy SourceFiles="..\Tedwren.Client\wwwroot\images\logo-icon.svg"
          DestinationFiles="wwwroot\images\logo-icon.svg"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
