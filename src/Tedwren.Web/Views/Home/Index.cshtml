@inject Tedwren.Abstractions.Services.IContentProvider Content
@{
    ViewData["Title"] = null; // Home renders the brand alone as the title.
    var home = Content.Home;
    var sub = Content.FindProduct("Subcontractor");
    var main = Content.FindProduct("MainContractor");
}

@* ---- HERO ---------------------------------------------------------------------------------- *@
<section class="band hero">
    <span class="hero__blob" aria-hidden="true"></span>
    <div class="band__inner hero__inner">
        <div>
            <p class="kicker hero__eyebrow">Construction workforce compliance</p>
            <h1 class="hero__title">@home.HeroHeading</h1>
            <p class="hero__sub">@home.HeroSubheading</p>
            <div class="hero__actions button-row">
                @await Component.InvokeAsync("Cta", new { action = CtaAction.BookDemo })
                <a class="cta cta--secondary" href="#how">See how it works</a>
            </div>
            <div class="audience">
                <span class="audience__label">I'm a</span>
                <div class="segmented" role="tablist" aria-label="Choose your role">
                    <button type="button" role="tab" data-audience-btn="sub" class="is-active" aria-selected="true">Subcontractor</button>
                    <button type="button" role="tab" data-audience-btn="main" aria-selected="false">Main Contractor</button>
                </div>
            </div>
        </div>
        <div class="frame-wrap">
            @await Component.InvokeAsync("ProductFrame", new { variant = ProductFrameVariant.SiteRegister })
        </div>
    </div>
</section>

@* ---- PROBLEM ------------------------------------------------------------------------------- *@
<section class="band band--surface">
    <div class="band__inner reveal">
        <div class="section-head">
            <p class="kicker">The problem</p>
            <h2 class="section-title">@home.ProblemHeading</h2>
        </div>
        <p class="section-lede">@home.ProblemBody</p>
    </div>
</section>

@* ---- TWO PRODUCTS (tabbed) ----------------------------------------------------------------- *@
<section class="band" id="products">
    <div class="band__inner">
        <div class="products-head reveal">
            <div class="section-head" style="margin-bottom:0;">
                <p class="kicker">Two products, one record</p>
                <h2 class="section-title">Built for both sides of the site</h2>
            </div>
            <div class="segmented" role="tablist" aria-label="Product">
                <button type="button" role="tab" data-audience-btn="sub" class="is-active" aria-selected="true">Subcontractor</button>
                <button type="button" role="tab" data-audience-btn="main" aria-selected="false">Main Contractor</button>
            </div>
        </div>

        @if (sub is not null)
        {
            <div class="tabpanel is-active reveal" data-audience-panel="sub" data-audience-default="sub">
                <div>
                    <h3 class="tabpanel__title">@sub.Tagline</h3>
                    <p class="tabpanel__promise">@sub.HeroCopy</p>
                    <ul class="ticklist">
                        @foreach (var f in sub.Features)
                        {
                            <li>@f.Heading</li>
                        }
                    </ul>
                    <a class="cta cta--primary" href="@sub.Slug">Explore for subcontractors →</a>
                </div>
                <div class="frame-wrap">
                    @await Component.InvokeAsync("ProductFrame", new { variant = ProductFrameVariant.CompliancePack })
                </div>
            </div>
        }

        @if (main is not null)
        {
            <div class="tabpanel reveal" data-audience-panel="main">
                <div>
                    <h3 class="tabpanel__title">@main.Tagline</h3>
                    <p class="tabpanel__promise">@main.HeroCopy</p>
                    <ul class="ticklist">
                        @foreach (var f in main.Features)
                        {
                            <li>@f.Heading</li>
                        }
                    </ul>
                    <a class="cta cta--primary" href="@main.Slug">Explore for main contractors →</a>
                </div>
                <div class="frame-wrap">
                    @await Component.InvokeAsync("ProductFrame", new { variant = ProductFrameVariant.Dashboard })
                </div>
            </div>
        }
    </div>
</section>

@* ---- DIFFERENTIATORS ----------------------------------------------------------------------- *@
<section class="band band--surface">
    <div class="band__inner reveal">
        <div class="section-head">
            <p class="kicker">Why Tedwren</p>
            <h2 class="section-title">Designed around construction sites, not office workflows</h2>
        </div>
        @await Component.InvokeAsync("Differentiators")
    </div>
</section>

@* ---- RETROFIT BANNER (ink) ----------------------------------------------------------------- *@
<section class="band band--ink">
    <div class="band__inner retrofit reveal">
        <div>
            <p class="kicker">Beyond the gate</p>
            <h2 class="section-title">Workforce management when there isn't a site gate</h2>
            <p class="section-lede">Retrofit, social housing and planned-maintenance programmes can involve hundreds of occupied properties, with operatives travelling directly to individual addresses — no turnstile, cabin or QR code in sight.</p>
            <span class="retrofit__line">One programme. Hundreds of properties. One workforce view.</span>
        </div>
        <svg viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:auto;">
            <g stroke="currentColor" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.5">
                <line x1="160" y1="100" x2="42" y2="34"/><line x1="160" y1="100" x2="30" y2="120"/>
                <line x1="160" y1="100" x2="70" y2="176"/><line x1="160" y1="100" x2="270" y2="30"/>
                <line x1="160" y1="100" x2="290" y2="110"/><line x1="160" y1="100" x2="240" y2="176"/>
            </g>
            <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.8">
                <rect x="30" y="20" width="24" height="24" rx="2"/><rect x="18" y="106" width="24" height="24" rx="2"/>
                <rect x="58" y="162" width="24" height="24" rx="2"/><rect x="258" y="16" width="24" height="24" rx="2"/>
                <rect x="278" y="96" width="24" height="24" rx="2"/><rect x="228" y="162" width="24" height="24" rx="2"/>
            </g>
            <circle cx="160" cy="100" r="26" fill="var(--color-brand)"/>
            <text x="160" y="104" text-anchor="middle" font-size="10" fill="#fff" font-family="sans-serif">HUB</text>
        </svg>
    </div>
</section>

@* ---- HOW IT WORKS -------------------------------------------------------------------------- *@
<section class="band" id="how">
    <div class="band__inner reveal">
        <div class="section-head">
            <p class="kicker">How it works</p>
            <h2 class="section-title">From worker record to site-ready</h2>
        </div>
        @await Component.InvokeAsync("HowItWorks")
    </div>
</section>

@* ---- TRUST STRIP --------------------------------------------------------------------------- *@
<section class="band band--surface band--tight">
    <div class="band__inner reveal">
        @await Component.InvokeAsync("TrustStrip")
    </div>
</section>

@* ---- CLOSING CTA (ink) --------------------------------------------------------------------- *@
<section class="band band--ink cta-band">
    <div class="band__inner cta-band__inner reveal">
        <h2 class="cta-band__title">@home.ClosingHeading</h2>
        <p class="section-lede" style="margin-bottom:var(--spacing-24);">@home.ClosingBody</p>
        <div class="button-row">
            @await Component.InvokeAsync("Cta", new { action = CtaAction.BookDemo })
            @await Component.InvokeAsync("Cta", new { action = CtaAction.StartPilot, secondary = true })
        </div>
    </div>
</section>
