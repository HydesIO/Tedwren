@model IReadOnlyList<TrustPoint>
@if (Model.Count > 0)
{
    <section class="trust-strip" aria-label="Why you can trust Tedwren">
        <ul class="trust-strip__list">
            @foreach (var point in Model)
            {
                <li class="trust-strip__item">@point.Claim</li>
            }
        </ul>
    </section>
}
