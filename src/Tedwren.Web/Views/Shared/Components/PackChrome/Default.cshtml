@using Tedwren.Web.ViewComponents
@model PackChromeModel
@if (Model.IsFooter)
{
    <footer class="pack-chrome pack-chrome--footer">
        <span class="pack-chrome__entity">
            @* Shared brand mark (copied from Tedwren.Client at build); decorative, name follows. *@
            <img class="pack-chrome__logo" src="~/images/logo-icon.svg" alt="" width="20" height="20" />
            Shared securely via @Model.LegalEntity
        </span>
        @* utm_source=pack so pack-driven bookings are attributable (Web Plan §4.1). No sign-up wall. *@
        <a class="cta cta--primary" href="@Model.DemoUrl" rel="noopener">Book a demo</a>
    </footer>
}
else
{
    <header class="pack-chrome pack-chrome--header">
        <span class="pack-chrome__brand">
            @* Shared brand mark (copied from Tedwren.Client at build); decorative, wordmark follows. *@
            <img class="pack-chrome__logo" src="~/images/logo-icon.svg" alt="" width="24" height="24" />
            @Model.BrandName
        </span>
        <a class="pack-chrome__demo" href="@Model.DemoUrl" rel="noopener">Book a demo</a>
    </header>
}
