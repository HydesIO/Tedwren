@model IReadOnlyList<Differentiator>
<div class="differentiators">
    @foreach (var item in Model)
    {
        <div class="differentiator @(item.Highlight ? "differentiator--highlight" : null)">
            <h3 class="differentiator__heading">@item.Heading</h3>
            <p class="differentiator__body">@item.Body</p>
        </div>
    }
</div>
