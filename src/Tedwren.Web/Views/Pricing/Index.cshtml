@using Tedwren.Web.Seo
@inject Tedwren.Abstractions.Services.IContentProvider Content
@{
    var pricing = Content.PricingPage;
    ViewData["Title"] = "Pricing";
    ViewData["MetaDescription"] = pricing.MetaDescription;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
@* SoftwareApplication schema on the pricing page (Web Plan §10); helper returns the whole <script> block. *@
@Html.Raw(JsonLd.SoftwareApplication(Content.Site, baseUrl + "/pricing"))

@* ---- INTRO --------------------------------------------------------------------------------- *@
<section class="band hero">
    <span class="hero__blob" aria-hidden="true"></span>
    <div class="band__inner">
        <div class="section-head" style="max-width:52ch;">
            <p class="kicker">Pricing</p>
            <h1 class="section-title">@pricing.Heading</h1>
            <p class="section-lede">@pricing.Intro</p>
        </div>
    </div>
</section>

@* ---- PLANS --------------------------------------------------------------------------------- *@
<section class="band band--surface">
    <div class="band__inner reveal">
        @await Component.InvokeAsync("PricingTable")
    </div>
</section>

@* ---- CLARIFIERS ---------------------------------------------------------------------------- *@
<section class="band">
    <div class="band__inner reveal">
        <div class="section-head">
            <p class="kicker">The fine print</p>
            <h2 class="section-title">In plain English</h2>
        </div>
        <ul class="pricing-clarifiers__list">
            @foreach (var clarifier in pricing.Clarifiers)
            {
                <li class="pricing-clarifiers__item">@clarifier</li>
            }
        </ul>
    </div>
</section>

@* ---- TRUST --------------------------------------------------------------------------------- *@
<section class="band band--surface">
    <div class="band__inner reveal">
        <div class="section-head">
            <p class="kicker">No surprises</p>
            <h2 class="section-title">Pricing you can trust</h2>
        </div>
        <ul class="pricing-trust__list">
            @foreach (var note in pricing.TrustNotes)
            {
                <li class="pricing-trust__item">@note.Claim</li>
            }
        </ul>
    </div>
</section>

@* ---- CLOSING CTA --------------------------------------------------------------------------- *@
<section class="band band--ink cta-band">
    <div class="band__inner cta-band__inner reveal">
        <h2 class="cta-band__title">Not sure which band you're in?</h2>
        <p class="section-lede" style="margin-bottom:var(--spacing-24);">Book a short demo and we'll map it to how you actually work.</p>
        <div class="button-row">
            @await Component.InvokeAsync("Cta", new { action = CtaAction.BookDemo })
        </div>
    </div>
</section>
