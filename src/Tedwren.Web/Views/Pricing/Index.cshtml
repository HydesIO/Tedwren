@using Tedwren.Web.Seo
@inject Tedwren.Abstractions.Services.IContentProvider Content
@{
    var pricing = Content.PricingPage;
    ViewData["Title"] = "Pricing";
    ViewData["MetaDescription"] = pricing.MetaDescription;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
@* SoftwareApplication schema on the pricing page (Web Plan §10); helper returns the whole <script> block. *@
@Html.Raw(JsonLd.SoftwareApplication(Content.Site, baseUrl + "/pricing"))

<section class="pricing-intro">
    <h1 class="section-heading">@pricing.Heading</h1>
    <p class="pricing-intro__body">@pricing.Intro</p>
</section>

@await Component.InvokeAsync("PricingTable")

<section class="pricing-clarifiers">
    <h2 class="section-heading">The fine print, in plain English</h2>
    <ul class="pricing-clarifiers__list">
        @foreach (var clarifier in pricing.Clarifiers)
        {
            <li class="pricing-clarifiers__item">@clarifier</li>
        }
    </ul>
</section>

@await Component.InvokeAsync("TrustStrip", new { })

<section class="pricing-trust">
    <ul class="pricing-trust__list">
        @foreach (var note in pricing.TrustNotes)
        {
            <li class="pricing-trust__item">@note.Claim</li>
        }
    </ul>
</section>

<section class="closing">
    <h2 class="closing__heading">Not sure which band you're in?</h2>
    <div class="closing__actions">
        @await Component.InvokeAsync("Cta", new { action = CtaAction.BookDemo })
    </div>
</section>
