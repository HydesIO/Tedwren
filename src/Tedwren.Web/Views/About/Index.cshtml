@inject Tedwren.Abstractions.Services.IContentProvider Content
@{
    var about = Content.About;
    ViewData["Title"] = "About";
    ViewData["MetaDescription"] = about.MetaDescription;
}

@* ---- INTRO --------------------------------------------------------------------------------- *@
<section class="band hero">
    <span class="hero__blob" aria-hidden="true"></span>
    <div class="band__inner">
        <div class="section-head" style="max-width:56ch;">
            <p class="kicker">About Tedwren</p>
            <h1 class="section-title">@about.Heading</h1>
            <p class="section-lede">@about.Intro</p>
        </div>
    </div>
</section>

@* ---- STORY --------------------------------------------------------------------------------- *@
<section class="band band--surface">
    <div class="band__inner reveal">
        <div class="about-sections">
            @foreach (var part in about.Sections)
            {
                <div class="about-section">
                    <h2 class="about-section__heading">@part.Heading</h2>
                    <p class="about-section__body">@part.Body</p>
                </div>
            }
        </div>
    </div>
</section>

@* ---- CLOSING CTA --------------------------------------------------------------------------- *@
<section class="band band--ink cta-band">
    <div class="band__inner cta-band__inner reveal">
        <h2 class="cta-band__title">Want to see it in action?</h2>
        <div class="button-row">
            @await Component.InvokeAsync("Cta", new { action = CtaAction.BookDemo })
        </div>
    </div>
</section>
