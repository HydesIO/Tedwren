@inject Tedwren.Abstractions.Services.IContentProvider Content
@model PartnerApplicationRequest
@{
    var partners = Content.Partners;
    ViewData["Title"] = "Partners";
    ViewData["MetaDescription"] = partners.MetaDescription;
}

<section class="partners-intro">
    <h1 class="section-heading">@partners.Heading</h1>
    <p class="partners-intro__body">@partners.Intro</p>
</section>

@* §7.3 exclusion, stated plainly and prominently — the programme is never a route to site access. *@
<section class="partners-exclusion" role="note">
    <p>@partners.ExclusionStatement</p>
</section>

<section class="partners-how">
    <h2 class="section-heading">How it works</h2>
    <div class="partners-how__grid">
        @foreach (var step in partners.HowItWorks)
        {
            <div class="partners-how__card">
                <h3 class="partners-how__heading">@step.Heading</h3>
                <p class="partners-how__body">@step.Body</p>
            </div>
        }
    </div>
</section>

<section class="partners-terms">
    <h2 class="section-heading">Commission</h2>
    <ul class="partners-terms__list">
        @foreach (var term in partners.CommissionTerms)
        {
            <li class="partners-terms__item">@term</li>
        }
    </ul>
</section>

<section class="partners-apply">
    <h2 class="section-heading">Apply to become a partner</h2>
    <p class="lead__intro">We review every application. Approval is a separate step — submitting this form does not activate anything.</p>

    <form class="lead-form" method="post" asp-controller="Partners" asp-action="Index">
        <input type="hidden" asp-for="RenderedAtUnixMs" />
        <div class="hp" aria-hidden="true">
            <label>Website<input asp-for="Website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="lead-form__field">
            <label asp-for="Name"></label>
            <input asp-for="Name" autocomplete="name" />
            <span asp-validation-for="Name" class="lead-form__error"></span>
        </div>
        <div class="lead-form__field">
            <label asp-for="Company"></label>
            <input asp-for="Company" autocomplete="organization" />
            <span asp-validation-for="Company" class="lead-form__error"></span>
        </div>
        <div class="lead-form__field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="lead-form__error"></span>
        </div>
        <div class="lead-form__field">
            <label asp-for="HowTheyWork"></label>
            <textarea asp-for="HowTheyWork" rows="4"></textarea>
            <span asp-validation-for="HowTheyWork" class="lead-form__error"></span>
        </div>
        <div class="lead-form__field">
            <label asp-for="RelationshipToSites"></label>
            <textarea asp-for="RelationshipToSites" rows="3"></textarea>
            <span asp-validation-for="RelationshipToSites" class="lead-form__error"></span>
        </div>
        <div class="lead-form__check">
            <label><input asp-for="ControlsSiteAccess" type="checkbox" /> @Html.DisplayNameFor(m => m.ControlsSiteAccess)</label>
        </div>

        <button class="cta cta--primary" type="submit">Submit application</button>
    </form>
</section>
