<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tedwren.Mobile.Controls — the native MAUI control kit + design system for the field app.
    It ports the web design tokens (src/Tedwren.Client/wwwroot/css/tokens.css) into MAUI resource
    dictionaries (light/dark) and provides the reusable Tw* controls, so the app reads as one system with
    the console without embedding the MudBlazor/web components. Targets Android + iOS only (per requirement).
    Builds on a MAUI-capable machine/CI (needs the maui-android/maui-ios workloads); see docs/mobile-app-build.md.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tedwren.Mobile.Controls</RootNamespace>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
