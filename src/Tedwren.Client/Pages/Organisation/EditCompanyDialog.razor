@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Services
@inject IOrganisationService Org
@inject ISnackbar Snackbar

@* Edit a company's details and persist via IOrganisationService.UpdateCompanyAsync. *@

<MudDialog>
    <DialogContent>
        <div class="edit-company">
            <TedwrenTextField Label="Company name" @bind-Value="_name" Required="true"
                              Error="_submitted && string.IsNullOrWhiteSpace(_name)" ErrorText="Company name is required." />
            <TedwrenTextField Label="Company type" @bind-Value="_type" />
            <TedwrenTextField Label="Primary trade" @bind-Value="_trade" />
            <TedwrenTextField Label="Registration number" @bind-Value="_regNumber" />
            <TedwrenTextField Label="Address" @bind-Value="_address" />
            <TedwrenTextField Label="Contact name" @bind-Value="_contactName" />
            <TedwrenTextField Label="Contact email" @bind-Value="_contactEmail" InputType="InputType.Email" />
            <TedwrenTextField Label="Contact phone" @bind-Value="_contactPhone" InputType="InputType.Telephone" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CompanyDetailDto Company { get; set; } = default!;

    private string? _name;
    private string? _type;
    private string? _trade;
    private string? _regNumber;
    private string? _address;
    private string? _contactName;
    private string? _contactEmail;
    private string? _contactPhone;
    private bool _submitted;
    private bool _busy;

    protected override void OnInitialized()
    {
        _name = Company.Name;
        _type = Company.Type;
        _trade = Company.Trade;
        _regNumber = Company.RegistrationNumber;
        _address = Company.Address;
        _contactName = Company.ContactName;
        _contactEmail = Company.ContactEmail;
        _contactPhone = Company.ContactPhone;
    }

    private async Task SaveAsync()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Company name is required.", Severity.Error);
            return;
        }

        _busy = true;
        var ok = await Org.UpdateCompanyAsync(Company.Id, new UpdateCompanyRequest(
            _name!, _type, _trade, _regNumber, _address, _contactName, _contactEmail, _contactPhone));
        _busy = false;

        if (ok)
        {
            Snackbar.Add("Company updated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_name!));   // return the new name so the caller can follow the slug
        }
        else
        {
            Snackbar.Add("Could not update the company.", Severity.Error);
        }
    }
}
