@page "/organisation/{Slug}"
@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject IOrganisationService Org
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_company?.Name ?? "Company") · Tedwren</PageTitle>

@if (_company is null)
{
    <PageHeader Title="Company not found" />
    <DashboardCard>
        <Body>
            <EmptyState Icon="@Icons.Material.Outlined.Business"
                        Title="Company not found"
                        Description="This company doesn't exist.">
                <Action>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/organisation">
                        Back to organisation
                    </MudButton>
                </Action>
            </EmptyState>
        </Body>
    </DashboardCard>
}
else
{
    <DetailHeader Title="@_company.Name"
                  Subtitle="@Subtitle(_company)"
                  StatusLabel="@_company.StatusLabel"
                  Status="ComplianceStatusView.ToStatusKind(_company.State)"
                  AvatarText="@Initials(_company.Name)"
                  Breadcrumbs="_crumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit" OnClick="EditAsync">
                Edit
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.FolderShared" OnClick="@(() => Nav.NavigateTo("/compliance-packs"))">
                Compliance pack
            </MudButton>
        </Actions>
    </DetailHeader>

    <div class="detail-tabs">
        <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="detail-tabs__panel">
            <MudTabPanel Text="Overview">
                <DashboardCard Title="Company details">
                    <Body>
                        <KeyValueList Items="_overview" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Documents ({_company.Documents.Count})")">
                <DashboardCard>
                    <Body>
                        <div class="detail-actions-row">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                                       OnClick="AddDocumentAsync">Add document</MudButton>
                        </div>
                        <DataTable TItem="CompanyDocumentDto"
                                   Items="_company.Documents"
                                   Columns="_docColumns"
                                   SearchPlaceholder="Search documents…"
                                   EmptyTitle="No documents"
                                   EmptyDescription="Add a company document — insurance, accreditation or policy — to track it."
                                   EmptyIcon="@Icons.Material.Outlined.Description" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Operatives ({_company.Operatives.Count})")">
                <DashboardCard>
                    <Body>
                        <DataTable TItem="CompanyOperativeDto"
                                   Items="_company.Operatives"
                                   Columns="_opColumns"
                                   SearchPlaceholder="Search operatives…"
                                   OnRowClick="OpenOperative"
                                   EmptyTitle="No operatives"
                                   EmptyIcon="@Icons.Material.Outlined.Engineering" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private CompanyDetailDto? _company;
    private List<KeyValueList.Pair> _overview = new();
    private List<DataColumn<CompanyDocumentDto>> _docColumns = new();
    private List<DataColumn<CompanyOperativeDto>> _opColumns = new();
    private IReadOnlyList<DetailHeader.Crumb> _crumbs = Array.Empty<DetailHeader.Crumb>();

    protected override async Task OnParametersSetAsync()
    {
        _company = await Org.GetCompanyAsync(Slug);
        if (_company is null) return;

        _crumbs = new List<DetailHeader.Crumb>
        {
            new("Organisation", "/organisation"),
            new(_company.Name),
        };

        _overview = new()
        {
            new("Company type", _company.Type ?? "—"),
            new("Primary trade", _company.Trade ?? "—"),
            new("Registration number", _company.RegistrationNumber ?? "—"),
            new("Workforce compliance", _company.CompliancePercent is null ? "Pending" : $"{_company.CompliancePercent.Value:0}%"),
            new("Registered address", _company.Address ?? "—"),
            new("Operatives", _company.Operatives.Count.ToString()),
            new("Primary contact", _company.ContactName ?? "—"),
            new("Email", _company.ContactEmail ?? "—"),
            new("Phone", _company.ContactPhone ?? "—"),
        };

        _docColumns = new()
        {
            new() { Title = "Document", Value = d => d.Name },
            new() { Title = "Type", Value = d => d.Type, Filterable = true },
            new()
            {
                Title = "Expires", Value = d => d.ExpiresOn ?? DateOnly.MaxValue, Searchable = false,
                CellTemplate = d => @<span>@(d.ExpiresOn?.ToString("dd MMM yyyy") ?? "—")</span>
            },
            new()
            {
                Title = "Status", Text = d => d.StatusLabel, Sortable = false, Filterable = true,
                CellTemplate = d => @<StatusPill Label="@d.StatusLabel" Status="ComplianceStatusView.ToStatusKind(d.State)" />
            },
            new()
            {
                Title = "Version", Value = d => d.Version, Searchable = false,
                CellTemplate = d => @<span>v@d.Version</span>
            },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false, Sortable = false,
                CellTemplate = d => @<div class="op-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Upgrade"
                               OnClick="@(() => NewVersionAsync(d))">New version</MudButton>
                    @if (d.Version > 1)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Outlined.History"
                                   OnClick="@(() => ShowHistoryAsync(d))">History</MudButton>
                    }
                </div>
            },
        };

        _opColumns = new()
        {
            new() { Title = "Name", Value = o => o.Name },
            new() { Title = "Trade", Value = o => o.Trade ?? "—", Filterable = true },
            new()
            {
                Title = "Status", Text = o => o.StatusLabel, Sortable = false, Filterable = true,
                CellTemplate = o => @<StatusPill Label="@o.StatusLabel" Status="ComplianceStatusView.ToStatusKind(o.State)" />
            },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false, Sortable = false,
                CellTemplate = o => @<div @onclick:stopPropagation="true" class="op-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Badge"
                               OnClick="@(() => ShowCardsAsync(o))">Qualifications</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               StartIcon="@Icons.Material.Outlined.Schedule"
                               Href="@($"/my-hours?person={o.PersonId}&company={_company!.Id}")" Target="_blank">Hours</MudButton>
                </div>
            },
        };
    }

    // Open by (company, engagement) id, not the name slug: this operative may belong to a company other than
    // the signed-in tenant, which the slug lookup cannot resolve — the cause of "no operative found" (UAT-007).
    private void OpenOperative(CompanyOperativeDto op)
    {
        if (_company is null) return;
        Nav.NavigateTo($"/workforce/{_company.Id}/{op.EngagementId}");
    }

    // Records a company document via the add-document dialog (UAT-006): the Documents tab previously had no way
    // to add one. Metadata only for now (file-binary upload is a later change).
    private async Task AddDocumentAsync()
    {
        if (_company is null)
        {
            return;
        }

        var parameters = new DialogParameters<AddCompanyDocumentDialog> { { x => x.CompanyId, _company.Id } };
        var dialog = await Dialogs.ShowAsync<AddCompanyDocumentDialog>("Add document", parameters, TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false, Data: CreateCompanyDocumentRequest request })
        {
            await Org.AddCompanyDocumentAsync(request);
            Snackbar.Add($"Added \"{request.Name}\".", Severity.Success);
            await OnParametersSetAsync();   // reload so the new document shows and the count updates
        }
    }

    // Records a new version of a document (MC-27): the prior version is retained and hidden from the library,
    // reachable via History. Prefills the dialog from the current version so only the changed details are edited.
    private async Task NewVersionAsync(CompanyDocumentDto document)
    {
        if (_company is null)
        {
            return;
        }

        var parameters = new DialogParameters<AddCompanyDocumentDialog>
        {
            { x => x.CompanyId, _company.Id },
            { x => x.Heading, $"New version of \"{document.Name}\"" },
            { x => x.ConfirmText, "Save new version" },
            { x => x.GuidanceText, "Record the replacement document. It becomes the current version in the library; the previous version is kept and remains available under History." },
            { x => x.InitialName, document.Name },
            { x => x.InitialType, document.Type },
            { x => x.InitialExpires, document.ExpiresOn },
        };
        var dialog = await Dialogs.ShowAsync<AddCompanyDocumentDialog>("New version", parameters, TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false, Data: CreateCompanyDocumentRequest request })
        {
            var newId = await Org.SupersedeCompanyDocumentAsync(new SupersedeCompanyDocumentRequest(
                _company.Id, document.Id, request.Name, request.Type, request.ExpiresOn, request.Reference));
            Snackbar.Add(newId is not null ? $"Saved version {document.Version + 1} of \"{request.Name}\"." : "Could not save the new version.",
                newId is not null ? Severity.Success : Severity.Error);
            if (newId is not null)
            {
                await OnParametersSetAsync();
            }
        }
    }

    // Shows a document's full version history (MC-27) in a read-only dialog.
    private async Task ShowHistoryAsync(CompanyDocumentDto document)
    {
        if (_company is null)
        {
            return;
        }

        var versions = await Org.GetCompanyDocumentVersionsAsync(_company.Id, document.Id);
        var parameters = new DialogParameters<DocumentHistoryDialog>
        {
            { x => x.DocumentName, document.Name },
            { x => x.Versions, versions },
        };
        await Dialogs.ShowAsync<DocumentHistoryDialog>("Version history", parameters, TedwrenDialog.Medium());
    }

    // Opens the edit dialog and reloads on save (persists via IOrganisationService.UpdateCompanyAsync).
    private async Task EditAsync()
    {
        var parameters = new DialogParameters<EditCompanyDialog> { { x => x.Company, _company! } };
        var dialog = await Dialogs.ShowAsync<EditCompanyDialog>("Edit company", parameters, TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false, Data: string newName })
        {
            var newSlug = Tedwren.Abstractions.Slug.From(newName);
            if (!string.Equals(newSlug, Slug, StringComparison.OrdinalIgnoreCase))
            {
                // The slug follows the name; navigating updates the route and reloads via OnParametersSetAsync.
                Nav.NavigateTo($"/organisation/{newSlug}");
            }
            else
            {
                await OnParametersSetAsync();   // same slug — reload the updated fields in place
            }
        }
    }

    // Opens the operative's server-computed qualification cards (SF-7/SF-8), keyed by real person id.
    private async Task ShowCardsAsync(CompanyOperativeDto op)
    {
        var parameters = new DialogParameters<QualificationCardsDialog> { { x => x.PersonId, op.PersonId } };
        await Dialogs.ShowAsync<QualificationCardsDialog>($"{op.Name} — qualifications", parameters, TedwrenDialog.Large());
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : parts[0][..1].ToUpperInvariant();
    }

    // "Type · Trade", omitting empty parts so a null Type/Trade (onboarding/invite-trade companies) never
    // renders a dangling or bare "·" separator (mirrors SiteDetail.Subtitle).
    private static string Subtitle(CompanyDetailDto c)
        => string.Join(" · ", new[] { c.Type, c.Trade }.Where(v => !string.IsNullOrWhiteSpace(v)));
}
