@page "/organisation/add"
@using Tedwren.Abstractions.Common
@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Services
@inject IReferenceDataService Reference
@inject IOrganisationService Org
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Add company · Tedwren</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0" />

<PageHeader Title="Add company" Subtitle="Register a company and its accreditations" />

<div class="form-page">
    <FormSection Title="Company details" Description="Basic identifying information for the company.">
        <TedwrenTextField Label="Company name" @bind-Value="_name" Required="true"
                          Placeholder="e.g. Meridian Construction Ltd"
                          Error="_submitted && string.IsNullOrWhiteSpace(_name)"
                          ErrorText="Company name is required." />
        <TedwrenSelect T="string" Label="Company type" @bind-Value="_type" Required="true"
                       Options="_companyTypes" Placeholder="Select a type"
                       Error="_submitted && string.IsNullOrWhiteSpace(_type)"
                       ErrorText="Select a company type." />
        <TedwrenSelect T="string" Label="Product" @bind-Value="_product" Required="true"
                       Options="_products" Placeholder="Select a product"
                       Error="_submitted && string.IsNullOrWhiteSpace(_product)"
                       ErrorText="Select the product this company is on."
                       HelperText="Subcontractor (time &amp; attendance + compliance packs) or Main contractor (workforce management + site entry). Sets the default console (SF-22)." />
        <TedwrenSelect T="string" Label="Primary trade" @bind-Value="_trade"
                       Options="_trades" Placeholder="Select a trade" />
        <TedwrenTextField Label="Registration number" @bind-Value="_regNumber"
                          Placeholder="e.g. 09876543"
                          HelperText="Companies House number, if applicable." />
    </FormSection>

    <FormSection Title="Primary contact" Description="Who we contact about this company.">
        <TedwrenTextField Label="Contact name" @bind-Value="_contactName" Placeholder="Full name" />
        <TedwrenTextField Label="Contact email" @bind-Value="_contactEmail"
                          InputType="InputType.Email" Placeholder="name@company.com" />
        <TedwrenTextField Label="Contact phone" @bind-Value="_contactPhone"
                          InputType="InputType.Telephone" Placeholder="+44 …" />
    </FormSection>

    <FormSection Title="Accreditations" Description="Upload accreditation and insurance documents.">
        <div class="form-page__full">
            <TedwrenFileUpload Label="Documents"
                               HelperText="e.g. SSIP certificate, employer's liability insurance."
                               HintText="PDF, PNG or JPG up to 10MB" />
        </div>
    </FormSection>

    <FormActions>
        <Secondary>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        </Secondary>
        <Primary>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save company</MudButton>
        </Primary>
    </FormActions>
</div>

@code {
    private string? _name;
    private string? _type;
    private string? _product;
    private string? _trade;
    private string? _regNumber;
    private string? _contactName;
    private string? _contactEmail;
    private string? _contactPhone;
    private bool _submitted;

    // The typed product (OrgType) is chosen as a friendly label, then mapped to the enum on save.
    private const string SubcontractorLabel = "Subcontractor";
    private const string MainContractorLabel = "Main contractor";
    private static readonly IReadOnlyList<string> _products = new[] { SubcontractorLabel, MainContractorLabel };

    private IReadOnlyList<string> _companyTypes = Array.Empty<string>();
    private IReadOnlyList<string> _trades = Array.Empty<string>();

    /// <summary>Maps the chosen product label to the typed product discriminator (SF-22), or null when unset.</summary>
    private static OrgType? ToOrgType(string? product) => product switch
    {
        MainContractorLabel => OrgType.MainContractor,
        SubcontractorLabel => OrgType.Subcontractor,
        _ => null,
    };

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Organisation", "/organisation"),
        new("Add company", null, disabled: true),
    };

    protected override async Task OnInitializedAsync()
    {
        _companyTypes = await Reference.GetListAsync(ReferenceListKeys.CompanyTypes);
        _trades = await Reference.GetListAsync(ReferenceListKeys.Trades);
    }

    private async Task Save()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_type) || string.IsNullOrWhiteSpace(_product))
        {
            Snackbar.Add("Please fix the highlighted fields.", Severity.Error);
            return;
        }

        // Persists the new company via the Web API (SF-1). The product (OrgType) drives the default module
        // bundle and the post-login console divergence (SF-22).
        await Org.CreateCompanyAsync(new CreateCompanyRequest(
            _name!, _type, _trade, _regNumber, Address: null, _contactName, _contactEmail, _contactPhone, ToOrgType(_product)));

        Snackbar.Add($"Company \"{_name}\" saved.", Severity.Success);
        Nav.NavigateTo("/organisation");
    }

    private void Cancel() => Nav.NavigateTo("/organisation");
}
