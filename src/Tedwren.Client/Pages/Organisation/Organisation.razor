@page "/organisation"
@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject IOrganisationService Org
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>Organisation · Tedwren</PageTitle>

<PageHeader Title="Organisation Management" Subtitle="Companies, documents and accreditations">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.RocketLaunch"
                   OnClick="@(() => Nav.NavigateTo("/onboarding"))">
            Add client
        </MudButton>
        @* Invite a trade to onboard themselves — uploads their own RAMS/insurance/accreditations for review (UAT-023). *@
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck"
                   OnClick="@(() => Nav.NavigateTo("/trade-approvals"))">
            Trade approvals
        </MudButton>
        @* Full set-up & configuration wizard for a subcontractor (spec Stage 1 / §4). *@
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.GroupAdd"
                   OnClick="@(() => Nav.NavigateTo("/subcontractors/onboard"))">
            Onboard subcontractor
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ForwardToInbox"
                   OnClick="InviteTradeAsync">
            Invite trade
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Nav.NavigateTo("/organisation/add"))">
            Add company
        </MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="CompanySummary"
                   Items="_companies"
                   Columns="_columns"
                   Loading="_loading"
                   OnRowClick="OpenCompany"
                   SearchPlaceholder="Search companies…"
                   EmptyTitle="No companies yet"
                   EmptyDescription="Add a company to start managing its documents and accreditations."
                   EmptyIcon="@Icons.Material.Outlined.Business" />
    </Body>
</DashboardCard>

@code {
    private IReadOnlyList<CompanySummary> _companies = Array.Empty<CompanySummary>();
    private List<DataColumn<CompanySummary>> _columns = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _companies = await Org.GetCompaniesAsync();
        _loading = false;
    }

    // Opens the invite-trade dialog; on success the new trade company appears in the list (UAT-023).
    private async Task InviteTradeAsync()
    {
        var dialog = await Dialogs.ShowAsync<InviteTradeDialog>("Invite trade", TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // Navigate by the stable id (not the name slug) so two companies whose names slugify identically are both
    // reachable and never resolve to the wrong record (F15); the detail lookup accepts an id or a slug.
    private void OpenCompany(CompanySummary company) => Nav.NavigateTo($"/organisation/{company.Id}");

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Company", Value = c => c.Name },
            new() { Title = "Type", Value = c => c.Type ?? "—", Filterable = true },
            new() { Title = "Trade", Value = c => c.Trade ?? "—", Filterable = true },
            new() { Title = "Operatives", Value = c => c.Operatives, AlignRight = true },
            new()
            {
                Title = "Compliance", Value = c => c.CompliancePercent ?? -1, AlignRight = true, Searchable = false,
                CellTemplate = c => @<span>@(c.CompliancePercent is null ? "—" : c.CompliancePercent.Value.ToString("0") + "%")</span>
            },
            new()
            {
                Title = "Status", Text = c => c.StatusLabel, Filterable = true, Sortable = false,
                CellTemplate = c => @<StatusPill Label="@c.StatusLabel" Status="ComplianceStatusView.ToStatusKind(c.State)" />
            },
        };
    }
}
