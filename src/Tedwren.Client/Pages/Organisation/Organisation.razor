@page "/organisation"
@inject IListSampleDataService Data
@inject NavigationManager Nav

<PageTitle>Organisation · Tedwren</PageTitle>

<PageHeader Title="Organisation Management" Subtitle="Companies, documents and accreditations">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Nav.NavigateTo("/organisation/add"))">
            Add company
        </MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="Company"
                   Items="_companies"
                   Columns="_columns"
                   Loading="_loading"
                   SearchPlaceholder="Search companies…"
                   EmptyTitle="No companies yet"
                   EmptyDescription="Add a company to start managing its documents and accreditations."
                   EmptyIcon="@Icons.Material.Outlined.Business" />
    </Body>
</DashboardCard>

@code {
    private IReadOnlyList<Company> _companies = Array.Empty<Company>();
    private List<DataColumn<Company>> _columns = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await Task.Delay(400); // simulate a fetch so the loading skeleton is visible
        _companies = Data.GetCompanies();
        _loading = false;
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Company", Value = c => c.Name },
            new() { Title = "Type", Value = c => c.Type, Filterable = true },
            new() { Title = "Trade", Value = c => c.Trade, Filterable = true },
            new() { Title = "Operatives", Value = c => c.Operatives, AlignRight = true },
            new()
            {
                Title = "Compliance", Value = c => c.CompliancePercent, AlignRight = true, Searchable = false,
                CellTemplate = c => @<span>@c.CompliancePercent.ToString("0")%</span>
            },
            new()
            {
                Title = "Status", Text = c => c.StatusLabel, Filterable = true, Sortable = false,
                CellTemplate = c => @<StatusPill Label="@c.StatusLabel" Status="c.Status" />
            },
        };
    }
}
