@page "/time-attendance"
@using Tedwren.Abstractions.Common
@using Tedwren.Abstractions.Contracts.Timesheets
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject ITimesheetService Timesheets
@inject ITenantState Tenant
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Time &amp; Attendance · Tedwren</PageTitle>

<PageHeader Title="Time &amp; Attendance" Subtitle="Weekly timesheets — review, approve and return for correction">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_loading"
                   OnClick="ExportCsv">Export CSV</MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="TimesheetSummaryDto"
                   Items="_timesheets"
                   Columns="_columns"
                   Loading="_loading"
                   OnRowClick="OpenDetail"
                   SearchPlaceholder="Search operative…"
                   EmptyTitle="No timesheets"
                   EmptyDescription="No timesheets exist for this valuation period."
                   EmptyIcon="@Icons.Material.Outlined.Schedule" />
    </Body>
</DashboardCard>

@code {
    // The current Monday-anchored week for the signed-in company.
    private static readonly DateOnly WeekStart = CurrentWeekStart();

    private IReadOnlyList<TimesheetSummaryDto> _timesheets = Array.Empty<TimesheetSummaryDto>();
    private List<DataColumn<TimesheetSummaryDto>> _columns = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        BuildColumns();
        await LoadAsync();
    }

    private static DateOnly CurrentWeekStart()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return today.AddDays(-(((int)today.DayOfWeek + 6) % 7));   // back to Monday
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _timesheets = await Timesheets.GetForCompanyWeekAsync(Tenant.CurrentCompanyId, WeekStart);
        _loading = false;
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Operative", Value = t => t.OperativeName, Filterable = true },
            new()
            {
                Title = "Week starting", Value = t => t.WeekStart, Searchable = false,
                CellTemplate = t => @<span>@t.WeekStart.ToString("dd MMM yyyy")</span>
            },
            new()
            {
                Title = "Hours", Value = t => t.TotalHours, Searchable = false,
                CellTemplate = t => @<span>@t.TotalHours.ToString("0.##")</span>
            },
            new()
            {
                Title = "Status", Value = t => t.StatusLabel, Searchable = false, Filterable = true,
                CellTemplate = t => @<StatusPill Label="@t.StatusLabel" Status="@ToStatusKind(t.Status)" />
            },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false,
                CellTemplate = t => @<div class="timesheet-actions">
                    @if (t.Status == TimesheetState.Submitted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => ApproveAsync(t))">Approve</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   OnClick="@(() => ReturnAsync(t))">Return</MudButton>
                    }
                </div>
            },
        };
    }

    // Opens the timesheet detail dialog for line-level corrections (R16) and scope-configurable approval (SUB-9).
    private async Task OpenDetail(TimesheetSummaryDto timesheet)
    {
        var parameters = new DialogParameters<TimesheetDetailDialog>
        {
            { x => x.TimesheetId, timesheet.Id },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<TimesheetDetailDialog>($"{timesheet.OperativeName} — timesheet", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: true })
        {
            await LoadAsync();
        }
    }

    // Approves the whole timesheet (SUB-9 scope = All).
    private async Task ApproveAsync(TimesheetSummaryDto timesheet)
    {
        var result = await Timesheets.ApproveAsync(timesheet.Id, new ApproveTimesheetRequest("You", ApprovalScope.All));
        if (result is not null)
        {
            Snackbar.Add($"Approved {timesheet.OperativeName}'s timesheet.", Severity.Success);
            await LoadAsync();
        }
    }

    // Returns the timesheet for correction with a reason (never "denied", R18).
    private async Task ReturnAsync(TimesheetSummaryDto timesheet)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Return {timesheet.OperativeName}'s timesheet for correction?" },
            { x => x.ConfirmText, "Return" },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Return timesheet", parameters);
        var outcome = await dialog.Result;
        if (outcome is { Canceled: false })
        {
            var result = await Timesheets.ReturnAsync(timesheet.Id, new ReturnTimesheetRequest("You", "Please review the recorded hours."));
            if (result is not null)
            {
                Snackbar.Add($"Returned {timesheet.OperativeName}'s timesheet for correction.", Severity.Info);
                await LoadAsync();
            }
        }
    }

    // Renders the company-week CSV export and downloads it in the browser (real download in both modes).
    private async Task ExportCsv()
    {
        var csv = await Timesheets.ExportCompanyWeekCsvAsync(Tenant.CurrentCompanyId, WeekStart);
        var rows = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length - 1;
        var fileName = $"tedwren-timesheets-{WeekStart:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("tedwrenDownload", fileName, "text/csv", csv);
        Snackbar.Add($"Exported {rows} timesheet rows to {fileName}.", Severity.Success);
    }

    private static StatusKind ToStatusKind(TimesheetState status) => status switch
    {
        TimesheetState.Approved => StatusKind.Success,
        TimesheetState.Submitted => StatusKind.Warning,
        TimesheetState.Returned => StatusKind.Danger,
        _ => StatusKind.Neutral,
    };
}
