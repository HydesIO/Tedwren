@page "/login"
@layout AuthLayout
@using Tedwren.Client.Services
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Sign in · Tedwren</PageTitle>

<div class="auth-form__brand">
    <img src="images/logo-icon.svg" alt="" />
    <span>Tedwren</span>
</div>

<h1 class="auth-form__title">Sign In</h1>
<p class="auth-form__subtitle">Enter your credentials to access your account</p>

@if (_error is not null)
{
    <div class="mb-4"><BannerAlert Severity="StatusKind.Danger" Title="Sign-in failed" Message="@_error" /></div>
}

<EditForm Model="this" OnValidSubmit="Submit">
    <TedwrenTextField Label="Username or Email" @bind-Value="_email" InputType="InputType.Email"
                      Placeholder="name@company.com" Required="true" />
    <TedwrenTextField Label="Password" @bind-Value="_password" InputType="InputType.Password"
                      Placeholder="Your password" Required="true" />

    <div class="auth-form__actions">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Size="Size.Large" Disabled="_busy"
                   StartIcon="@Icons.Material.Outlined.Login">Login</MudButton>
    </div>
</EditForm>

<div class="auth-form__links">
    <MudLink Href="/forgot-password" Color="Color.Primary" Typo="Typo.body2">Forgot Password?</MudLink>
</div>

@code {
    private string? _email;
    private string? _password;
    private string? _error;
    private bool _busy;

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Enter your email and password.";
            return;
        }

        _busy = true;
        var ok = await Auth.LoginAsync(_email!.Trim(), _password!);
        _busy = false;
        if (ok)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _error = "Those credentials were not recognised.";
        }
    }
}
