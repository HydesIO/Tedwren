@page "/forgot-password"
@layout AuthLayout
@using Tedwren.Client.Services
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Forgot password · Tedwren</PageTitle>

<div class="auth-form__brand">
    <img src="images/logo-icon.svg" alt="" />
    <span>Tedwren</span>
</div>

@if (_sent)
{
    <h1 class="auth-form__title">Check your inbox</h1>
    <p class="auth-form__subtitle">
        If an account exists for <strong>@_submittedEmail</strong>, we've sent a link to reset your
        password. The link expires in one hour.
    </p>

    <div class="auth-form__actions">
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Size="Size.Large" StartIcon="@Icons.Material.Outlined.ArrowBack">Back to sign in</MudButton>
    </div>
}
else
{
    <h1 class="auth-form__title">Forgot Password?</h1>
    <p class="auth-form__subtitle">
        Enter the email address for your account and we'll send you a link to reset your password.
    </p>

    <EditForm Model="this" OnValidSubmit="Submit">
        <TedwrenTextField Label="Email" @bind-Value="_email" InputType="InputType.Email"
                          Placeholder="name@company.com" Required="true" />

        <div class="auth-form__actions">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Disabled="_busy"
                       StartIcon="@Icons.Material.Outlined.Send">Send reset link</MudButton>
        </div>
    </EditForm>

    <div class="auth-form__links">
        <MudLink Href="/login" Color="Color.Primary" Typo="Typo.body2">Back to sign in</MudLink>
    </div>
}

@code {
    private string? _email;
    private string _submittedEmail = string.Empty;
    private bool _busy;
    private bool _sent;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            return;
        }

        _busy = true;
        _submittedEmail = _email!.Trim();
        // The result is deliberately not inspected: the confirmation is identical whether or not the address
        // is registered, so the page never discloses which emails have accounts (no enumeration).
        await Auth.RequestPasswordResetAsync(_submittedEmail);
        _busy = false;
        _sent = true;
    }
}
