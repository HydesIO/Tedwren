@page "/reset-password"
@layout AuthLayout
@using Tedwren.Client.Services
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Reset password · Tedwren</PageTitle>

<div class="auth-form__brand">
    <img src="images/logo-icon.svg" alt="" />
    <span>Tedwren</span>
</div>

<h1 class="auth-form__title">Choose a new password</h1>
<p class="auth-form__subtitle">Set a new password for your Tedwren console account.</p>

@if (_error is not null)
{
    <div class="mb-4"><BannerAlert Severity="StatusKind.Danger" Title="Could not reset password" Message="@_error" /></div>
}

<EditForm Model="this" OnValidSubmit="Submit">
    <TedwrenTextField Label="New password" @bind-Value="_password" InputType="InputType.Password"
                      Placeholder="At least 8 characters" Required="true" />
    <TedwrenTextField Label="Confirm password" @bind-Value="_confirm" InputType="InputType.Password"
                      Placeholder="Re-enter your password" Required="true" />

    <div class="auth-form__actions">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Size="Size.Large" Disabled="_busy"
                   StartIcon="@Icons.Material.Outlined.LockReset">Reset password</MudButton>
    </div>
</EditForm>

<div class="auth-form__links">
    <MudLink Href="/login" Color="Color.Primary" Typo="Typo.body2">Back to sign in</MudLink>
</div>

@code {
    private string? _password;
    private string? _confirm;
    private string? _error;
    private bool _busy;
    private string _token = string.Empty;

    protected override void OnInitialized()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && Uri.UnescapeDataString(parts[0]) == "token")
            {
                _token = Uri.UnescapeDataString(parts[1]);
            }
        }
    }

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_password) || _password!.Length < 8)
        {
            _error = "Choose a password of at least 8 characters.";
            return;
        }

        if (_password != _confirm)
        {
            _error = "The passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "This reset link is missing its token.";
            return;
        }

        _busy = true;
        var ok = await Auth.ResetPasswordAsync(_token, _password!);
        _busy = false;
        if (ok)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _error = "This reset link is invalid or has expired. Request a new one from the sign-in page.";
        }
    }
}
