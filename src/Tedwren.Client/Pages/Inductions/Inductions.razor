@page "/inductions"
@using Tedwren.Abstractions.Contracts.Inductions
@using Tedwren.Abstractions.Services
@inject IInductionService InductionSvc
@inject ITenantState Tenant
@inject NavigationManager Nav

<PageTitle>Inductions · Tedwren</PageTitle>

<PageHeader Title="Inductions" Subtitle="Site inductions — different content and quizzes per site type (MC-3, MC-15)">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   Href="/inductions/new">Add induction</MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="InductionTemplateDto"
                   Items="_templates"
                   Columns="_columns"
                   Loading="_loading"
                   OnRowClick="EditTemplate"
                   SearchPlaceholder="Search inductions…"
                   EmptyTitle="No inductions yet"
                   EmptyDescription="Add an induction to configure its content, quiz and pass mark."
                   EmptyIcon="@Icons.Material.Outlined.PlayCircle" />
    </Body>
</DashboardCard>

@code {
    private bool _loading = true;
    private IReadOnlyList<InductionTemplateDto> _templates = Array.Empty<InductionTemplateDto>();
    private List<DataColumn<InductionTemplateDto>> _columns = new();

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        BuildColumns();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _templates = await InductionSvc.GetTemplatesAsync(Tenant.CurrentCompanyId);
        _loading = false;
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Name", Value = t => t.Name },
            new() { Title = "Validity", Value = t => t.ValidityDays, Searchable = false, AlignRight = true,
                    CellTemplate = t => @<span>@t.ValidityDays days</span> },
            new() { Title = "Pass mark", Value = t => t.PassMark, Searchable = false, AlignRight = true },
            new() { Title = "Steps", Value = t => t.Steps.Count, Searchable = false, AlignRight = true },
            new() { Title = "Questions", Value = t => t.QuestionCount, Searchable = false, AlignRight = true },
            new()
            {
                Title = "", Sortable = false, Searchable = false, AlignRight = true,
                CellTemplate = t =>
                    @<MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                StartIcon="@Icons.Material.Outlined.Edit"
                                OnClick="@(() => EditTemplate(t))">Edit</MudButton>
            },
        };
    }

    private void EditTemplate(InductionTemplateDto template) => Nav.NavigateTo($"/inductions/{template.Id}/edit");
}
