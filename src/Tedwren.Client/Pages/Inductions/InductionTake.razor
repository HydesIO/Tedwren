@page "/induct"
@layout RecipientLayout
@using Tedwren.Abstractions.Contracts.Forms
@using Tedwren.Abstractions.Contracts.Inductions
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Pages.Forms
@using Tedwren.Client.Services
@inject IInductionService Inductions
@inject ITenantState Tenant
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Induction · Tedwren</PageTitle>

<div class="induct">
    @switch (_phase)
    {
        case Phase.Start:
            <DashboardCard Title="Start your induction" Subtitle="Complete this on your phone before coming to site.">
                <Body>
                    <div class="induct__form">
                        @* Anonymous tokenised link (UAT-018): the induction is fixed by the link, so we name it rather than offer a picker. *@
                        @if (_isLinkMode && _linkView is not null)
                        {
                            <p class="induct__intro">@($"{_linkView.CompanyName} has asked you to complete the “{_linkView.TemplateName}” induction. Enter your name to begin.")</p>
                        }
                        <TedwrenTextField Label="Your full name" @bind-Value="_name" Required="true"
                                          Error="_submitted && string.IsNullOrWhiteSpace(_name)" ErrorText="Your name is required." />
                        @if (!_isLinkMode)
                        {
                            <TedwrenSelect T="string" Label="Induction" Value="_templateName"
                                           Options="_templateNames" Placeholder="Select an induction"
                                           ValueChanged="@(v => _templateName = v)" />
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync"
                                   Disabled="@StartDisabled">Start</MudButton>
                        @if (_loadError)
                        {
                            <BannerAlert Severity="StatusKind.Warning" Title="Couldn't load the induction" Message="@_loadErrorMessage" />
                        }
                        else if (!_isLinkMode && _templates.Count == 0 && !_busy)
                        {
                            <BannerAlert Severity="StatusKind.Info" Title="No inductions available"
                                         Message="There are no inductions to complete for this company yet." />
                        }
                    </div>
                </Body>
            </DashboardCard>
            break;

        case Phase.Steps when _activeForm is not null:
            <DashboardCard Title="@_activeForm.Name" Subtitle="Complete this form, then submit to mark the step done.">
                <Body>
                    <DynamicFormRenderer @ref="_renderer" Sections="_activeForm.Sections" />
                    <div class="induct__nav">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CancelForm" Disabled="_busy">Back</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitFormAsync" Disabled="_busy">Submit form</MudButton>
                    </div>
                </Body>
            </DashboardCard>
            break;

        case Phase.Steps:
            <DashboardCard Title="@_session!.TemplateName" Subtitle="Work through each step. Required steps must be completed.">
                <Body>
                    <div class="induct__steps">
                        @foreach (var step in _session.Steps)
                        {
                            var done = _session.CompletedStepIds.Contains(step.Id);
                            <div class="induct__step @(done ? "induct__step--done" : null)">
                                <div class="induct__step-text">
                                    <span class="induct__step-label">@step.Label</span>
                                    <span class="induct__step-kind">@step.Kind@(step.Required ? " · required" : "")</span>
                                </div>
                                @if (done)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" />
                                }
                                else if (step.Kind == "Form")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="@(() => OpenFormAsync(step.Id))" Disabled="_busy">Complete form</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="@(() => CompleteStepAsync(step.Id))" Disabled="_busy">Mark done</MudButton>
                                }
                            </div>
                        }
                    </div>
                    <div class="induct__nav">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AfterSteps"
                                   Disabled="!RequiredStepsDone">Continue</MudButton>
                    </div>
                </Body>
            </DashboardCard>
            break;

        case Phase.Quiz:
            <DashboardCard Title="Quiz" Subtitle="@($"Answer all questions. Pass mark {_session!.PassMark}%.")">
                <Body>
                    @foreach (var q in _session.Questions)
                    {
                        <div class="induct__question">
                            <p class="induct__prompt">@q.Prompt</p>
                            @for (var i = 0; i < q.Options.Count; i++)
                            {
                                var idx = i;
                                <label class="induct__option">
                                    <input type="radio" name="@q.Id" checked="@(_answers.TryGetValue(q.Id, out var a) && a == idx)"
                                           @onchange="@(() => _answers[q.Id] = idx)" />
                                    <span>@q.Options[idx]</span>
                                </label>
                            }
                        </div>
                    }
                    @if (_lastResult is { Passed: false })
                    {
                        <BannerAlert Severity="StatusKind.Danger" Title="Not passed"
                                     Message="@($"You scored {_lastResult.Correct}/{_lastResult.Total}. Review the steps and try again.")" />
                    }
                    <div class="induct__nav">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitQuizAsync"
                                   Disabled="_busy || _answers.Count < _session.Questions.Count">Submit answers</MudButton>
                    </div>
                </Body>
            </DashboardCard>
            break;

        case Phase.Sign:
            <DashboardCard Title="Sign and confirm" Subtitle="Confirm you have completed this induction (MC-5).">
                <Body>
                    <div class="induct__form">
                        <TedwrenTextField Label="Type your full name to sign" @bind-Value="_signature" Required="true"
                                          Error="_submitted && string.IsNullOrWhiteSpace(_signature)" ErrorText="A signature is required." />
                        <TedwrenToggle Label="Consent to share my induction record"
                                       Description="Optional — lets your induction be shared with the main contractor (MC-20)."
                                       Value="_consent" ValueChanged="@(v => _consent = v)" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinalizeAsync" Disabled="_busy">Finish induction</MudButton>
                    </div>
                </Body>
            </DashboardCard>
            break;

        case Phase.Done:
            <DashboardCard Title="Induction complete">
                <Body>
                    <div class="induct__done">
                        <MudIcon Icon="@Icons.Material.Outlined.Verified" Color="Color.Success" Size="Size.Large" />
                        <p>You're all set, @_session!.PersonName.</p>
                        <p class="induct__ref">Reference: <strong>@_session.CompletionReference</strong></p>
                        @if (_session.ExpiresUtc is { } exp)
                        {
                            <p class="induct__exp">Valid until @exp.LocalDateTime.ToString("dd MMM yyyy")</p>
                        }
                    </div>
                </Body>
            </DashboardCard>
            break;
    }
</div>

@code {
    private enum Phase { Start, Steps, Quiz, Sign, Done }

    private Phase _phase = Phase.Start;
    private bool _busy;
    private bool _submitted;
    private bool _loadError;

    private IReadOnlyList<InductionTemplateDto> _templates = Array.Empty<InductionTemplateDto>();
    private IReadOnlyList<string> _templateNames = Array.Empty<string>();
    private string? _templateName;
    private string? _name;

    // Shareable tokenised link (UAT-018): when a ?token= is present the induction runs anonymously, fixed by the link.
    private bool _isLinkMode;
    private string _token = string.Empty;
    private string? _passcode;
    private InductionLinkViewDto? _linkView;
    private string _loadErrorMessage = string.Empty;

    private bool StartDisabled =>
        _busy || (_isLinkMode ? _linkView is null : _templates.Count == 0);

    private InductionSessionDto? _session;
    private readonly Dictionary<string, int> _answers = new();
    private QuizResultDto? _lastResult;
    private string? _signature;
    private bool _consent;

    // The form step currently being completed (requirement 5): the fetched published form and the step it belongs to.
    private FormTemplateDto? _activeForm;
    private string? _activeFormStepId;
    private DynamicFormRenderer? _renderer;

    private bool RequiredStepsDone =>
        _session is not null && _session.Steps.Where(s => s.Required).All(s => _session.CompletedStepIds.Contains(s.Id));

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        try
        {
            ParseQuery();
            if (_isLinkMode)
            {
                // UAT-018: the worker reaches this from a shared token link with no console account. The induction is
                // fixed by the link, resolved anonymously — no bearer token, no template listing, no tenant context.
                _linkView = await Inductions.GetLinkAsync(_token, _passcode);
                if (_linkView is null)
                {
                    _loadError = true;
                    _loadErrorMessage = "This link cannot be opened. It may have expired, or the passcode is incorrect. Ask whoever sent it for a new link.";
                }
                else
                {
                    _name = _linkView.Name;
                    _templateName = _linkView.TemplateName;
                }
            }
            else
            {
                // Admin preview from the console: hydrate auth so the templates call carries the bearer token. The
                // recipient layout doesn't initialise auth, so without this the templates call returned 401 and the
                // page crashed with an unhandled error and a redirect to /login (UAT-019).
                await Auth.InitializeAsync();
                await Tenant.InitializeAsync();
                _templates = await Inductions.GetTemplatesAsync(Tenant.CurrentCompanyId);
                _templateNames = _templates.Select(t => t.Name).ToList();
                _templateName = _templateNames.FirstOrDefault();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _loadError = true;
            _loadErrorMessage = _isLinkMode
                ? "This link cannot be opened just now. Please reload the page, or ask whoever sent it for a new link."
                : "Make sure you're signed in to the console, then reload this page. To preview an induction, open it again from the Induction Records page.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartAsync()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Enter your name.", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            if (_isLinkMode)
            {
                _session = await Inductions.StartFromLinkAsync(_token, _passcode, _name!.Trim());
                if (_session is null)
                {
                    Snackbar.Add("This link cannot be opened.", Severity.Error);
                    return;
                }
            }
            else
            {
                var template = _templates.FirstOrDefault(t => t.Name == _templateName);
                if (template is null)
                {
                    Snackbar.Add("Choose an induction.", Severity.Error);
                    return;
                }

                _session = await Inductions.StartAsync(new StartInductionRequest(
                    Tenant.CurrentCompanyId, template.Id, Guid.NewGuid(), _name!.Trim()));
            }

            _phase = Phase.Steps;
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // Reads the shareable-link token/passcode from the query string (UAT-018), mirroring the self-onboarding page.
    private void ParseQuery()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(parts[0]);
            var value = Uri.UnescapeDataString(parts[1]);
            if (key == "token")
            {
                _token = value;
                _isLinkMode = !string.IsNullOrWhiteSpace(value);
            }
            else if (key == "passcode")
            {
                _passcode = value;
            }
        }
    }

    private async Task CompleteStepAsync(string stepId)
    {
        _busy = true;
        var updated = await Inductions.CompleteStepAsync(_session!.Id, stepId);
        _busy = false;
        if (updated is not null)
        {
            _session = updated;
        }
    }

    // Loads the published form attached to a Form step and shows it for completion (requirement 5).
    private async Task OpenFormAsync(string stepId)
    {
        _busy = true;
        try
        {
            var form = await Inductions.GetSessionFormAsync(_session!.Id, stepId);
            if (form is null)
            {
                Snackbar.Add("This form is not available yet.", Severity.Warning);
                return;
            }

            _activeForm = form;
            _activeFormStepId = stepId;
        }
        finally
        {
            _busy = false;
        }
    }

    // Submits the completed form; on success the step is marked done and the session refreshed.
    private async Task SubmitFormAsync()
    {
        if (_activeForm is null || _activeFormStepId is null || _renderer is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var request = new CreateFormSubmissionRequest(
                _activeForm.Id, "Induction", null, null, _renderer.GetAnswers(), _renderer.GetFiles());
            var updated = await Inductions.SubmitSessionFormAsync(_session!.Id, _activeFormStepId, request);
            if (updated is not null)
            {
                _session = updated;
                Snackbar.Add("Form submitted.", Severity.Success);
                CancelForm();
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // Closes the active form without submitting, returning to the step list.
    private void CancelForm()
    {
        _activeForm = null;
        _activeFormStepId = null;
        _renderer = null;
    }

    // Moves past the steps: to the quiz if there are questions, otherwise straight to signing.
    private void AfterSteps() => _phase = _session!.Questions.Count > 0 ? Phase.Quiz : Phase.Sign;

    private async Task SubmitQuizAsync()
    {
        _busy = true;
        _lastResult = await Inductions.SubmitQuizAsync(_session!.Id, new SubmitQuizRequest(_answers));
        _busy = false;

        if (_lastResult is { Passed: true })
        {
            _phase = Phase.Sign;
        }
        else
        {
            _answers.Clear();   // let them retry
        }
    }

    private async Task FinalizeAsync()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_signature))
        {
            Snackbar.Add("Type your name to sign.", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            var finalised = await Inductions.FinalizeAsync(_session!.Id, new FinalizeInductionRequest(_signature!.Trim(), _consent));
            if (finalised is not null)
            {
                _session = finalised;
                _phase = Phase.Done;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not finish: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
