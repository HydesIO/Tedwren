@page "/inductions/new"
@page "/inductions/{TemplateId:guid}/edit"
@using Tedwren.Abstractions.Contracts.Forms
@using Tedwren.Abstractions.Contracts.Inductions
@using Tedwren.Abstractions.Contracts.Sites
@using Tedwren.Abstractions.Services
@using Tedwren.UiComponents.Forms
@inject IInductionService InductionSvc
@inject ISiteService Sites
@inject IFormTemplateService Forms
@inject ITenantState Tenant
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_isNew ? "New induction" : "Edit induction") · Tedwren</PageTitle>

<PageHeader Title="@(_isNew ? "New induction" : "Edit induction")"
            Subtitle="Configure the induction — content, quiz, pass mark and attempts (MC-15)" />

<div class="form-page">
    @if (_loading || _template is null)
    {
        <DashboardCard><Body><AsyncContent Loading="true" Variant="LoadingSkeleton.SkeletonVariant.Card" Rows="6" /></Body></DashboardCard>
    }
    else
    {
        <FormSection Title="Induction details" Description="Name, media and how long a completion stays valid.">
            <TedwrenTextField Label="Induction name" @bind-Value="_name" />
            <TedwrenSelect T="string" Label="Applies to site" @bind-Value="_site" Options="_siteNames" Placeholder="All sites" />
            <TedwrenTextField Label="Video / document URL" @bind-Value="_mediaUrl" Placeholder="https://…" />
            <MudNumericField T="int" Label="Valid for (days)" @bind-Value="_validityDays" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div class="form-page__full">
                <TedwrenToggle Label="Mandatory before first site entry" @bind-Value="_mandatory"
                               Description="A valid induction is a condition of site entry (MC-8)." />
            </div>
        </FormSection>

        <FormSection Title="Quiz" Description="Scored on the server; answers never reach the worker's device (R5).">
            <MudNumericField T="int" Label="Pass mark (correct answers)" @bind-Value="_passMark" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField T="int" Label="Attempts allowed" @bind-Value="_attemptLimit" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div class="form-page__full">
                @foreach (var q in _questions)
                {
                    <MudPaper Class="pa-4 mb-3" Outlined="true" @key="q">
                        <TedwrenTextField Label="Question" @bind-Value="q.Prompt" />
                        <ChipInput Label="Options" @bind-Value="q.Options" Placeholder="Type an option, then Enter"
                                   HelperText="Add each answer choice as a chip." />
                        <MudNumericField T="int" Label="Correct option number (1-based)" @bind-Value="q.CorrectDisplay" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete"
                                   OnClick="@(() => _questions.Remove(q))">Remove question</MudButton>
                    </MudPaper>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddQuestion">Add question</MudButton>
            </div>
        </FormSection>

        @* The capture steps a worker completes are data-driven and configurable here — the tester asked whether
           fields could be added/removed without a developer (UAT-027/028). Built-in steps (identity, emergency
           contact, declaration, media, signature) and attached Forms Library forms sit in one ordered list. *@
        <FormSection Title="Capture steps" Description="What a worker completes during the induction (MC-2/MC-3). Add, remove and reorder steps, and attach Forms Library forms for custom capture (requirement 5) — no developer needed.">
            <div class="form-page__full">
                @if (_steps.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No steps yet — add one below.</MudText>
                }
                else
                {
                    @for (var i = 0; i < _steps.Count; i++)
                    {
                        var index = i;
                        var step = _steps[index];
                        <MudPaper Class="pa-3 mb-2" Outlined="true" @key="step">
                            <div class="induction-step">
                                <MudIcon Icon="@StepIcon(step.Kind)" Size="Size.Small" Class="induction-step__icon" />
                                <div class="induction-step__fields">
                                    <TedwrenTextField Label="@($"{StepKindLabel(step.Kind)} — label shown to the worker")" @bind-Value="step.Label" />
                                    <TedwrenToggle Label="Required" Description="A required step must be completed before finishing."
                                                   @bind-Value="step.Required" />
                                </div>
                                <div class="induction-step__actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small"
                                                   Disabled="index == 0" OnClick="@(() => MoveStep(index, -1))" aria-label="Move up" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small"
                                                   Disabled="index == _steps.Count - 1" OnClick="@(() => MoveStep(index, 1))" aria-label="Move down" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => _steps.RemoveAt(index))" aria-label="Remove step" />
                                </div>
                            </div>
                            @if (step.Kind == "Form")
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Attached form: @FormName(step.Reference)</MudText>
                            }
                        </MudPaper>
                    }
                }

                <div class="induction-step__add">
                    <TedwrenSelect T="string" Label="Add a built-in step" Value="@_selectedKind"
                                   ValueChanged="AddBuiltInStep" Options="_addableKindLabels" Placeholder="Choose a step type" />
                    <TedwrenSelect T="string" Label="Attach a published form" Value="@_selectedForm"
                                   ValueChanged="AddFormStep" Options="_publishedFormNames" Placeholder="Choose a form" />
                </div>
            </div>
        </FormSection>

        <FormActions>
            <Secondary>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => Nav.NavigateTo("/inductions"))">Cancel</MudButton>
            </Secondary>
            <Primary>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                           StartIcon="@Icons.Material.Outlined.Publish" OnClick="Publish">Publish induction</MudButton>
            </Primary>
        </FormActions>
    }
</div>

@code {
    /// <summary>The induction template being edited; null routes to a new template seeded from the default (MC-3).</summary>
    [Parameter] public Guid? TemplateId { get; set; }

    private bool _isNew => TemplateId is null;
    private bool _loading = true;
    private bool _initialized;
    private Guid? _loadedFor;

    private InductionTemplateAuthoringDto? _template;
    private IReadOnlyList<SiteSummary> _sites = Array.Empty<SiteSummary>();
    private IReadOnlyList<string> _siteNames = Array.Empty<string>();
    private bool _busy;

    private string _name = string.Empty;
    private string? _site;
    private string? _mediaUrl;
    private int _validityDays = 365;
    private bool _mandatory = true;
    private int _passMark;
    private int _attemptLimit = 3;
    private readonly List<QuestionEdit> _questions = new();

    private IReadOnlyList<FormTemplateSummaryDto> _publishedForms = Array.Empty<FormTemplateSummaryDto>();
    private IReadOnlyList<string> _publishedFormNames = Array.Empty<string>();

    // The ordered, editable capture steps (UAT-027/028). Built-in kinds plus attached Forms Library forms.
    private readonly List<StepEdit> _steps = new();
    private string? _selectedForm;
    private string? _selectedKind;

    // Built-in step kinds an admin can add, as friendly label → InductionStepKind name (the DTO Kind string).
    private static readonly IReadOnlyDictionary<string, string> AddableKinds = new Dictionary<string, string>
    {
        ["Confirm identity"] = "Identity",
        ["Qualification cards"] = "Cards",
        ["Emergency contact"] = "EmergencyContact",
        ["Declaration"] = "Declaration",
        ["Video / document"] = "Media",
        ["Signature"] = "Signature",
    };
    private static readonly IReadOnlyList<string> _addableKindLabels = AddableKinds.Keys.ToList();

    protected override async Task OnParametersSetAsync()
    {
        // Load once per resolved route (guards against CreateDefaultTemplateAsync firing on every parameter set).
        if (_initialized && _loadedFor == TemplateId) return;
        _initialized = true;
        _loadedFor = TemplateId;

        await Tenant.InitializeAsync();
        _sites = await Sites.GetSitesAsync();
        _siteNames = _sites.Select(s => s.Name).ToList();
        _publishedForms = (await Forms.GetTemplatesAsync()).Where(f => f.Status == "Published").ToList();
        _publishedFormNames = _publishedForms.Select(f => f.Name).ToList();
        await LoadAsync();
    }

    // Adds the chosen published form as a Form step (its family id is the step reference).
    private void AddFormStep(string? formName)
    {
        _selectedForm = null;
        var form = _publishedForms.FirstOrDefault(f => f.Name == formName);
        if (form is null || _steps.Any(s => s.Kind == "Form" && s.Reference == form.FamilyId.ToString()))
        {
            return;
        }

        _steps.Add(new StepEdit
        {
            Id = Guid.NewGuid().ToString("N"),
            Kind = "Form",
            Label = form.Name,
            Required = true,
            Reference = form.FamilyId.ToString(),
        });
    }

    // Adds a built-in capture step of the chosen kind (UAT-027/028).
    private void AddBuiltInStep(string? kindLabel)
    {
        _selectedKind = null;
        if (kindLabel is null || !AddableKinds.TryGetValue(kindLabel, out var kind))
        {
            return;
        }

        _steps.Add(new StepEdit
        {
            Id = Guid.NewGuid().ToString("N"),
            Kind = kind,
            Label = StepKindLabel(kind),
            Required = true,
        });
    }

    // Moves a step up or down in the order.
    private void MoveStep(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _steps.Count)
        {
            return;
        }

        (_steps[index], _steps[target]) = (_steps[target], _steps[index]);
    }

    private string FormName(string? familyId) =>
        _publishedForms.FirstOrDefault(f => f.FamilyId.ToString() == familyId)?.Name ?? "—";

    // Friendly label + icon for a step kind (the DTO Kind string is the InductionStepKind name).
    private static string StepKindLabel(string kind) => kind switch
    {
        "Identity" => "Confirm identity",
        "Cards" => "Qualification cards",
        "EmergencyContact" => "Emergency contact",
        "Declaration" => "Declaration",
        "Media" => "Video / document",
        "Signature" => "Signature",
        "Form" => "Form",
        _ => kind,
    };

    private static string StepIcon(string kind) => kind switch
    {
        "Identity" => Icons.Material.Outlined.Badge,
        "Cards" => Icons.Material.Outlined.CreditCard,
        "EmergencyContact" => Icons.Material.Outlined.ContactPhone,
        "Declaration" => Icons.Material.Outlined.FactCheck,
        "Media" => Icons.Material.Outlined.PlayCircle,
        "Signature" => Icons.Material.Outlined.Draw,
        "Form" => Icons.Material.Outlined.Dashboard,
        _ => Icons.Material.Outlined.Checklist,
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // "new" seeds the form from the shipped default WITHOUT persisting (create-on-publish, see Publish);
            // "edit" loads the given template. Seeding without a write means cancelling "Add induction" no
            // longer leaves an orphan template in the /inductions list.
            _template = TemplateId is { } editId
                ? await InductionSvc.GetTemplateForEditAsync(editId)
                : await InductionSvc.GetDefaultTemplateForEditAsync();
            if (_template is null) return;

            _name = _template.Name;
            // Load the current "applies to site" selection so re-editing doesn't silently reset it to
            // "All sites" (UAT-017). Mapped from the stored SiteId back to the site name the select shows;
            // a null SiteId means all sites (the placeholder).
            _site = _sites.FirstOrDefault(s => s.Id == _template.SiteId)?.Name;
            _mediaUrl = _template.MediaUrl;
            _validityDays = _template.ValidityDays;
            _mandatory = _template.Mandatory;
            _passMark = _template.PassMark;
            _attemptLimit = _template.AttemptLimit;
            _questions.Clear();
            _questions.AddRange(_template.Questions.Select(q => new QuestionEdit
            {
                Id = q.Id,
                Prompt = q.Prompt,
                Options = q.Options.Select(ChipOption.Create).ToList(),
                CorrectDisplay = q.CorrectOptionIndex + 1,
            }));

            _steps.Clear();
            _steps.AddRange(_template.Steps.Select(s => new StepEdit
            {
                Id = s.Id,
                Kind = s.Kind,
                Label = s.Label,
                Required = s.Required,
                Reference = s.Reference,
            }));
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddQuestion() => _questions.Add(new QuestionEdit
    {
        Options = new List<ChipOption> { ChipOption.Create("Yes"), ChipOption.Create("No") },
        CorrectDisplay = 1,
    });

    private async Task Publish()
    {
        if (_template is null) return;

        var questions = _questions
            .Where(q => !string.IsNullOrWhiteSpace(q.Prompt))
            .Select(q =>
            {
                var options = q.Options.Select(o => o.Text.Trim()).Where(t => t.Length > 0).ToList();
                var correct = Math.Clamp(q.CorrectDisplay - 1, 0, Math.Max(0, options.Count - 1));
                return new InductionQuizAuthoringDto(q.Id, q.Prompt.Trim(), options, correct);
            })
            .ToList();

        _busy = true;
        try
        {
            // Persist the chosen "applies to site" (UAT-017): map the selected name back to its id, or null
            // (all sites) when nothing is chosen. Previously this ignored the picker and re-saved the old id.
            var siteId = string.IsNullOrWhiteSpace(_site)
                ? (Guid?)null
                : _sites.FirstOrDefault(s => s.Name == _site)?.Id;
            // Persist the full, admin-edited capture step list in its current order (UAT-027/028).
            var steps = _steps
                .Where(s => !string.IsNullOrWhiteSpace(s.Label))
                .Select(s => new InductionStepDto(s.Id, s.Kind, s.Label.Trim(), s.Required, s.Reference))
                .ToList();
            // Create-on-publish: a brand-new induction is persisted only now — create the row from the default,
            // then apply the admin's edits — so an opened-then-cancelled builder never leaves an orphan template.
            var templateId = _isNew
                ? await InductionSvc.CreateDefaultTemplateAsync(new CreateInductionTemplateRequest(
                    Tenant.CurrentCompanyId, string.IsNullOrWhiteSpace(_name) ? "Site induction" : _name.Trim(), _validityDays, _passMark))
                : _template.Id;
            var updated = await InductionSvc.UpdateTemplateAsync(templateId, new UpdateInductionTemplateRequest(
                _name, _validityDays, _passMark, _attemptLimit, _mandatory, _mediaUrl, siteId, steps, questions));
            if (updated is not null)
            {
                Snackbar.Add("Induction published.", Severity.Success);
                Nav.NavigateTo("/inductions");
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class QuestionEdit
    {
        public string Id { get; set; } = string.Empty;
        public string Prompt { get; set; } = string.Empty;
        public List<ChipOption> Options { get; set; } = new();
        public int CorrectDisplay { get; set; } = 1;
    }

    /// <summary>An editable induction capture step (UAT-027/028).</summary>
    private sealed class StepEdit
    {
        public string Id { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public bool Required { get; set; } = true;
        public string? Reference { get; set; }
    }
}
