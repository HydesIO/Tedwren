@using Tedwren.Abstractions.Contracts.DemoData
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject IDemoDataService DemoData

@* Runs a demo-data seed or delete and shows live progress via the shared ProgressDialog. Started via
   IDialogService with the Operation parameter set to "seed" or "delete"; closes itself with
   DialogResult.Ok(DemoDataStatus) on success. *@

<ProgressDialog Description="@Description"
                StatusText="@StatusLine"
                Value="_progress.Completed"
                Max="_progress.Total"
                Error="@_error"
                OnClose="Close" />

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The operation to run: "seed" (which also recreates) or "delete".</summary>
    [Parameter] public string Operation { get; set; } = "seed";

    private DemoDataProgress _progress = new(true, null, "Starting…", 0, 0, 0, null);
    private DemoDataStatus? _result;
    private string? _error;
    private bool _done;

    /// <summary>What the dialog is doing, shown as the ProgressDialog description.</summary>
    private string Description => Operation == "delete"
        ? "We're removing the demonstration dataset. This may take a few moments."
        : "We're building the demonstration dataset. This may take a few moments.";

    /// <summary>Live status line: the current stage plus the completed/total stage count.</summary>
    private string StatusLine => _progress.Total > 0
        ? $"{_progress.Stage} — {_progress.Completed} of {_progress.Total} stages"
        : _progress.Stage ?? "Starting…";

    protected override async Task OnInitializedAsync()
    {
        // Kick off the operation, then poll progress until it finishes.
        var work = Operation == "delete" ? RunDeleteAsync() : RunSeedAsync();
        var poller = PollAsync();
        await Task.WhenAll(work, poller);
    }

    private async Task RunSeedAsync()
    {
        try
        {
            _result = await DemoData.SeedAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _done = true;
        }
    }

    private async Task RunDeleteAsync()
    {
        try
        {
            await DemoData.DeleteAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _done = true;
        }
    }

    private async Task PollAsync()
    {
        // Poll the server's live progress snapshot until the operation is no longer running.
        var api = DemoData as ApiDemoDataService;
        while (_error is null)
        {
            if (api is not null)
            {
                try
                {
                    _progress = await api.GetProgressAsync();
                    if (!string.IsNullOrEmpty(_progress.Error))
                    {
                        _error = _progress.Error;
                    }
                }
                catch
                {
                    // Ignore transient poll failures; the work task governs completion.
                }
            }

            await InvokeAsync(StateHasChanged);

            if (_error is not null || (_done && !_progress.Running))
            {
                break;
            }

            await Task.Delay(400);
        }

        if (_error is null)
        {
            MudDialog.Close(DialogResult.Ok(_result));
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Dismisses the dialog after a failure (the error Close button).</summary>
    private void Close() => MudDialog.Cancel();
}
