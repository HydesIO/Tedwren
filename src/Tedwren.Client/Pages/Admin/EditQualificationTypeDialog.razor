@using Tedwren.Abstractions.Contracts.Qualifications
@using Tedwren.Abstractions.Services
@inject IQualificationService Qualifications
@inject ISnackbar Snackbar

@* Add or edit a shared (platform-owned) accreditation type in the qualification-type library (SF-12). Editing can
   also delete the type when nothing references it — the server guards that and returns a reason otherwise. *@

<MudDialog>
    <DialogContent>
        <div class="tw-dialog-body">
            <DialogGuidance Text="@(_isEdit
                ? "Update this accreditation type. It applies everywhere the type is used — the trade→accreditation map, card capture and the operative app picker."
                : "Add an accreditation type to the shared library. Every customer can then map it to a trade and operatives can capture a card of this type.")" />

            <section class="tw-dialog-section">
                <h3 class="tw-dialog-section__title">Accreditation</h3>
                <div class="tw-dialog-section__grid">
                    <div class="tw-dialog-body__full">
                        <TedwrenTextField Label="Name" @bind-Value="_name" Required="true"
                                          Placeholder="e.g. Gas Safe"
                                          Error="_submitted && string.IsNullOrWhiteSpace(_name)"
                                          ErrorText="A name is required." />
                    </div>
                    <TedwrenTextField Label="Category" @bind-Value="_category"
                                      Placeholder="e.g. Health &amp; Safety" />
                    <TedwrenTextField Label="Issuer" @bind-Value="_issuer"
                                      Placeholder="e.g. Gas Safe Register" />
                    <TedwrenNumericField Label="Default validity (months)" @bind-Value="_validityMonths"
                                         HelperText="Used as the default expiry when a card of this type is captured (0 = no default)." />
                    <TedwrenToggle Label="CSCS-verifiable" @bind-Value="_isCscsVerifiable"
                                   Description="Whether this type can be checked live against CSCS (informational)." />
                </div>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        @if (_isEdit)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy">Delete</MudButton>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
            @(_isEdit ? "Save changes" : "Add accreditation")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The type being edited, or null when adding a new one.</summary>
    [Parameter] public QualificationTypeDto? Existing { get; set; }

    private string? _name;
    private string? _category;
    private string? _issuer;
    private decimal? _validityMonths = 0;
    private bool _isCscsVerifiable;
    private bool _submitted;
    private bool _busy;

    private bool _isEdit => Existing is not null;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _name = Existing.Name;
            _category = Existing.Category;
            _issuer = Existing.Issuer;
            _validityMonths = Existing.DefaultValidityMonths;
            _isCscsVerifiable = Existing.IsCscsVerifiable;
        }
    }

    // Persists the add/edit via IQualificationService, then closes with success so the page can refresh.
    private async Task SaveAsync()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("A name is required.", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            var months = (int)(_validityMonths ?? 0);
            if (_isEdit)
            {
                await Qualifications.UpdateQualificationTypeAsync(Existing!.Id,
                    new UpdateQualificationTypeRequest(_name!.Trim(), Clean(_category), Clean(_issuer), months, _isCscsVerifiable));
            }
            else
            {
                // Platform-admin management maintains the shared national library (Global: true).
                await Qualifications.CreateQualificationTypeAsync(
                    new CreateQualificationTypeRequest(_name!.Trim(), Clean(_category), Clean(_issuer), months, _isCscsVerifiable, Global: true));
            }

            Snackbar.Add(_isEdit ? "Accreditation updated." : "Accreditation added.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save the accreditation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // Deletes the type (guarded server-side; a reason is shown when it is still referenced).
    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Qualifications.DeleteQualificationTypeAsync(Existing!.Id);
            Snackbar.Add("Accreditation deleted.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
