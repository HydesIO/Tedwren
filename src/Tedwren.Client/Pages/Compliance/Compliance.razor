@page "/compliance"
@using Tedwren.Abstractions.Contracts.Qualifications
@using Tedwren.Abstractions.Services
@inject IQualificationService Qualifications
@inject IDashboardService Dashboard

<PageTitle>Compliance · Tedwren</PageTitle>

<PageHeader Title="Compliance" Subtitle="Compliance overview and qualification library" />

<div class="compliance-layout">
    <DashboardCard Title="Workforce compliance">
        <Body>
            <div class="compliance-overview">
                <DonutStat Segments="_overview.Segments"
                           CentreValue="@_overview.HeadlinePercent"
                           CentreLabel="@_overview.HeadlineLabel" />
                <LegendList Items="_overview.Legend" />
            </div>
        </Body>
    </DashboardCard>

    <DashboardCard Title="Qualification type library"
                   Subtitle="Qualifications tracked across the workforce">
        <Body>
            <DataTable TItem="QualificationTypeDto"
                       Items="_qualifications"
                       Columns="_columns"
                       Loading="_loading"
                       SearchPlaceholder="Search qualifications…"
                       EmptyTitle="No qualification types"
                       EmptyDescription="Add a qualification type to start tracking it across operatives."
                       EmptyIcon="@Icons.Material.Outlined.WorkspacePremium" />
        </Body>
    </DashboardCard>
</div>

@code {
    private ComplianceOverviewVm _overview = default!;
    private IReadOnlyList<QualificationTypeDto> _qualifications = Array.Empty<QualificationTypeDto>();
    private List<DataColumn<QualificationTypeDto>> _columns = new();
    private bool _loading = true;

    // Loads the workforce compliance overview (aggregated from current cards, SF-8) and the qualification-type
    // library, both from the Web API.
    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        var breakdown = await Dashboard.GetComplianceAsync();
        _overview = ComplianceOverviewView.From(breakdown);
        _qualifications = await Qualifications.GetQualificationTypesAsync();
        _loading = false;
    }

    // Builds the qualification-library table columns.
    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Qualification", Value = q => q.Name },
            new() { Title = "Category", Value = q => q.Category ?? "—", Filterable = true },
            new() { Title = "Issuer", Value = q => q.Issuer ?? "—", Filterable = true },
            new()
            {
                Title = "Valid for", Value = q => q.DefaultValidityMonths, AlignRight = true, Searchable = false,
                CellTemplate = q => @<span>@q.DefaultValidityMonths months</span>
            },
            new() { Title = "Held by", Value = q => q.HeldBy, AlignRight = true },
        };
    }
}
