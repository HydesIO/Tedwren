@page "/compliance"
@inject IListSampleDataService ListData
@inject IDashboardSampleDataService DashData

<PageTitle>Compliance · Tedwren</PageTitle>

<PageHeader Title="Compliance" Subtitle="Compliance overview and qualification library" />

<div class="compliance-layout">
    <DashboardCard Title="Workforce compliance">
        <Body>
            <div class="compliance-overview">
                <DonutStat Segments="_overview.Segments"
                           CentreValue="@_overview.HeadlinePercent"
                           CentreLabel="@_overview.HeadlineLabel" />
                <LegendList Items="_overview.Legend" />
            </div>
        </Body>
    </DashboardCard>

    <DashboardCard Title="Qualification type library"
                   Subtitle="Qualifications tracked across the workforce">
        <Body>
            <DataTable TItem="QualificationType"
                       Items="_qualifications"
                       Columns="_columns"
                       SearchPlaceholder="Search qualifications…"
                       EmptyTitle="No qualification types"
                       EmptyDescription="Add a qualification type to start tracking it across operatives."
                       EmptyIcon="@Icons.Material.Outlined.WorkspacePremium" />
        </Body>
    </DashboardCard>
</div>

@code {
    private ComplianceOverview _overview = default!;
    private IReadOnlyList<QualificationType> _qualifications = Array.Empty<QualificationType>();
    private List<DataColumn<QualificationType>> _columns = new();

    protected override void OnInitialized()
    {
        _overview = DashData.GetComplianceOverview();
        _qualifications = ListData.GetQualificationTypes();
        _columns = new()
        {
            new() { Title = "Qualification", Value = q => q.Name },
            new() { Title = "Category", Value = q => q.Category, Filterable = true },
            new() { Title = "Issuer", Value = q => q.Issuer, Filterable = true },
            new()
            {
                Title = "Valid for", Value = q => q.ValidMonths, AlignRight = true, Searchable = false,
                CellTemplate = q => @<span>@q.ValidMonths months</span>
            },
            new() { Title = "Held by", Value = q => q.HeldBy, AlignRight = true },
        };
    }
}
