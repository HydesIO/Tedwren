@page "/sites/{Slug}"
@using SiteDetailModel = Tedwren.UiComponents.SampleData.SiteDetail
@inject IDetailSampleDataService Details
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_site?.Name ?? "Site") · Tedwren</PageTitle>

@if (_site is null)
{
    <PageHeader Title="Site not found" />
    <DashboardCard>
        <Body>
            <EmptyState Icon="@Icons.Material.Outlined.Apartment"
                        Title="Site not found"
                        Description="This site doesn't exist in the sample data.">
                <Action>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/sites">Back to sites</MudButton>
                </Action>
            </EmptyState>
        </Body>
    </DashboardCard>
}
else
{
    <DetailHeader Title="@_site.Name"
                  Subtitle="@($"{_site.Client} · {_site.Region}")"
                  StatusLabel="@_site.StatusLabel"
                  Status="_site.Status"
                  Breadcrumbs="_crumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => Snackbar.Add("Edit site (demo).", Severity.Info))">
                Edit
            </MudButton>
        </Actions>
    </DetailHeader>

    <div class="detail-tabs">
        <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="detail-tabs__panel">
            <MudTabPanel Text="Overview">
                <DashboardCard Title="Site details">
                    <Body>
                        <KeyValueList Items="_overview" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Workforce ({_site.Workforce.Count})")">
                <DashboardCard>
                    <Body>
                        <DataTable TItem="Operative"
                                   Items="_site.Workforce"
                                   Columns="_opColumns"
                                   SearchPlaceholder="Search operatives…"
                                   OnRowClick="OpenOperative"
                                   EmptyTitle="No operatives on site"
                                   EmptyIcon="@Icons.Material.Outlined.Engineering" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Properties ({_site.Properties.Count})")">
                <DashboardCard Subtitle="Dispersed scheme — properties within this site">
                    <Body>
                        <DataTable TItem="SiteProperty"
                                   Items="_site.Properties"
                                   Columns="_propColumns"
                                   SearchPlaceholder="Search properties…"
                                   EmptyTitle="No properties"
                                   EmptyIcon="@Icons.Material.Outlined.Home" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private SiteDetailModel? _site;
    private List<KeyValueList.Pair> _overview = new();
    private List<DataColumn<Operative>> _opColumns = new();
    private List<DataColumn<SiteProperty>> _propColumns = new();
    private IReadOnlyList<DetailHeader.Crumb> _crumbs = Array.Empty<DetailHeader.Crumb>();

    protected override void OnParametersSet()
    {
        _site = Details.GetSite(Slug);
        if (_site is null) return;

        _crumbs = new List<DetailHeader.Crumb>
        {
            new("Sites & Projects", "/sites"),
            new(_site.Name),
        };

        _overview = new()
        {
            new("Client", _site.Client),
            new("Region", _site.Region),
            new("Address", _site.Address),
            new("Site manager", _site.Manager),
            new("Start date", _site.StartDate.ToString("dd MMM yyyy")),
            new("Operatives", _site.Operatives.ToString()),
            new("Workforce compliance", $"{_site.CompliancePercent:0}%"),
        };

        _opColumns = new()
        {
            new() { Title = "Name", Value = o => o.Name },
            new() { Title = "Trade", Value = o => o.Trade, Filterable = true },
            new() { Title = "Employer", Value = o => o.Company },
            new()
            {
                Title = "Status", Text = o => o.StatusLabel, Sortable = false, Filterable = true,
                CellTemplate = o => @<StatusPill Label="@o.StatusLabel" Status="o.Status" />
            },
        };

        _propColumns = new()
        {
            new() { Title = "Property", Value = p => p.Address },
            new() { Title = "Units", Value = p => p.Units, AlignRight = true },
            new()
            {
                Title = "Status", Text = p => p.StatusLabel, Sortable = false, Filterable = true,
                CellTemplate = p => @<StatusPill Label="@p.StatusLabel" Status="p.Status" />
            },
        };
    }

    private void OpenOperative(Operative op) => Nav.NavigateTo($"/workforce/{Slugs.From(op.Name)}");
}
