@page "/sites/{Slug}"
@using Tedwren.Abstractions.Contracts.Sites
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject ISiteService SiteData
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_site?.Name ?? "Site") · Tedwren</PageTitle>

@if (_loading)
{
    <PageHeader Title="Loading…" Subtitle="Fetching site details" />
    <DashboardCard>
        <Body>
            <AsyncContent Loading="true" Variant="LoadingSkeleton.SkeletonVariant.Card" Rows="6" />
        </Body>
    </DashboardCard>
}
else if (_site is null)
{
    <PageHeader Title="Site not found" />
    <DashboardCard>
        <Body>
            <EmptyState Icon="@Icons.Material.Outlined.Apartment"
                        Title="Site not found"
                        Description="This site doesn't exist.">
                <Action>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/sites">Back to sites</MudButton>
                </Action>
            </EmptyState>
        </Body>
    </DashboardCard>
}
else
{
    <DetailHeader Title="@_site.Name"
                  Subtitle="@Subtitle(_site)"
                  StatusLabel="@_site.StatusLabel"
                  Status="ComplianceStatusView.ToStatusKind(_site.State)"
                  Breadcrumbs="_crumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit" OnClick="EditAsync">
                Edit
            </MudButton>
        </Actions>
    </DetailHeader>

    <div class="detail-tabs">
        <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="detail-tabs__panel">
            <MudTabPanel Text="Overview">
                <DashboardCard Title="Site details">
                    <Body>
                        <KeyValueList Items="_overview" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Properties ({_site.Properties.Count})")">
                <DashboardCard Subtitle="@(_site.IsDispersed ? "Dispersed scheme — properties within this site" : "Properties within this site")">
                    <Body>
                        <DataTable TItem="SitePropertyDto"
                                   Items="_site.Properties"
                                   Columns="_propColumns"
                                   SearchPlaceholder="Search properties…"
                                   EmptyTitle="No properties"
                                   EmptyDescription="This site has no individual properties recorded."
                                   EmptyIcon="@Icons.Material.Outlined.Home" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private SiteDetailDto? _site;
    private bool _loading = true;
    private List<KeyValueList.Pair> _overview = new();
    private List<DataColumn<SitePropertyDto>> _propColumns = new();
    private IReadOnlyList<DetailHeader.Crumb> _crumbs = Array.Empty<DetailHeader.Crumb>();

    // Loads the site through the shared ISiteService, served from mock or the API identically (SF-6).
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _site = await SiteData.GetSiteAsync(Slug);
        _loading = false;
        if (_site is null)
        {
            return;
        }

        _crumbs = new List<DetailHeader.Crumb>
        {
            new("Sites & Projects", "/sites"),
            new(_site.Name),
        };

        _overview = new()
        {
            new("Client", _site.Client ?? "—"),
            new("Region", _site.Region ?? "—"),
            new("Address", _site.Address ?? "—"),
            new("Site type", _site.IsDispersed ? "Dispersed scheme" : "Standard site"),
            new("Point of presence", _site.HasCompound ? "Fixed (compound / gate / cabin)" : "None — phone sign-in (SF-25)"),
            new("Boundary", _site.Boundary is { } b ? $"{b.RadiusMetres:0} m radius" : (_site.IsDispersed ? "Per property" : "Not set")),
            new("Compliance", _site.CompliancePercent is { } p ? $"{p:0}%" : "Pending"),
        };

        _propColumns = new()
        {
            new() { Title = "Property", Value = p => p.Address },
            new() { Title = "Units", Value = p => p.Units, AlignRight = true },
            new()
            {
                Title = "Boundary", Value = p => p.Boundary.RadiusMetres, AlignRight = true, Searchable = false,
                CellTemplate = p => @<span>@($"{p.Boundary.RadiusMetres:0} m")</span>
            },
        };
    }

    // "Client · Region", omitting empty parts.
    private static string Subtitle(SiteDetailDto s)
        => string.Join(" · ", new[] { s.Client, s.Region }.Where(v => !string.IsNullOrWhiteSpace(v)));

    // Opens the edit dialog and reloads on save (persists via ISiteService.UpdateSiteAsync).
    private async Task EditAsync()
    {
        var parameters = new DialogParameters<EditSiteDialog> { { x => x.Site, _site! } };
        var dialog = await Dialogs.ShowAsync<EditSiteDialog>("Edit site", parameters, TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false, Data: string newName })
        {
            var newSlug = Tedwren.Abstractions.Slug.From(newName);
            if (!string.Equals(newSlug, Slug, StringComparison.OrdinalIgnoreCase))
            {
                // The slug follows the name; navigating updates the route and reloads via OnParametersSetAsync.
                Nav.NavigateTo($"/sites/{newSlug}");
            }
            else
            {
                await OnParametersSetAsync();   // same slug — reload the updated fields in place
            }
        }
    }
}
