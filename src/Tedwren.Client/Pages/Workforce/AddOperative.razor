@page "/workforce/add"
@using Tedwren.Abstractions.Contracts.Onboarding
@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Services
@inject IReferenceDataService Reference
@inject IOrganisationService Org
@inject IOnboardingService Onboarding
@inject ITenantState Tenant
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Add operative · Tedwren</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0" />

<PageHeader Title="Add operative" Subtitle="Onboard a new operative by direct entry or a self-service link" />

<div class="form-page">
    <TedwrenStepper @bind-ActiveIndex="_activeStep">
        <MudStep Title="Method" Icon="@Icons.Material.Outlined.Tune">
            <div class="add-operative__step">
                <p class="add-operative__lead">How would you like to add this operative?</p>
                <MudRadioGroup T="string" Value="_method" ValueChanged="OnMethodChanged">
                    <div class="add-operative__choice">
                        <MudRadio T="string" Value="@("direct")" Color="Color.Primary">
                            <span class="add-operative__choice-title">Direct entry</span>
                            <span class="add-operative__choice-desc">Enter the operative's details yourself now.</span>
                        </MudRadio>
                    </div>
                    <div class="add-operative__choice">
                        <MudRadio T="string" Value="@("link")" Color="Color.Primary">
                            <span class="add-operative__choice-title">Send a self-service link</span>
                            <span class="add-operative__choice-desc">The operative completes their own details and uploads their cards.</span>
                        </MudRadio>
                    </div>
                </MudRadioGroup>
            </div>
        </MudStep>

        <MudStep Title="@(_method == "link" ? "Recipient" : "Details")" Icon="@Icons.Material.Outlined.Badge">
            <div class="add-operative__step">
                @if (_method == "link")
                {
                    <div class="add-operative__grid">
                        <TedwrenTextField Label="Operative name" @bind-Value="_name" Required="true" Placeholder="Full name" />
                        <TedwrenTextField Label="Mobile or email" @bind-Value="_contact" Required="true"
                                          Placeholder="Where to send the link" />
                        <TedwrenToggle Label="Require a passcode on the link"
                                       Description="The operative must enter a one-time passcode to open the form."
                                       @bind-Value="_requirePasscode" />
                    </div>
                }
                else
                {
                    <div class="add-operative__grid">
                        <TedwrenTextField Label="Full name" @bind-Value="_name" Required="true" Placeholder="Full name" />
                        <TedwrenSelect T="string" Label="Employer" @bind-Value="_company" Options="_companyNames" Placeholder="Select a company" />
                        <TedwrenSelect T="string" Label="Trade" @bind-Value="_trade" Options="_trades" Placeholder="Select a trade" />
                        <TedwrenTextField Label="Mobile" @bind-Value="_contact" InputType="InputType.Telephone" Placeholder="+44 …" />
                    </div>
                }
            </div>
        </MudStep>

        <MudStep Title="Review" Icon="@Icons.Material.Outlined.CheckCircle">
            <div class="add-operative__step">
                <p class="add-operative__lead">Review and confirm</p>
                <dl class="add-operative__review">
                    <div><dt>Method</dt><dd>@(_method == "link" ? "Self-service link" : "Direct entry")</dd></div>
                    <div><dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_name) ? "—" : _name)</dd></div>
                    @if (_method == "link")
                    {
                        <div><dt>Send to</dt><dd>@(string.IsNullOrWhiteSpace(_contact) ? "—" : _contact)</dd></div>
                        <div><dt>Passcode</dt><dd>@(_requirePasscode ? "Required" : "Not required")</dd></div>
                    }
                    else
                    {
                        <div><dt>Employer</dt><dd>@(_company ?? "—")</dd></div>
                        <div><dt>Trade</dt><dd>@(_trade ?? "—")</dd></div>
                        <div><dt>Mobile</dt><dd>@(string.IsNullOrWhiteSpace(_contact) ? "—" : _contact)</dd></div>
                    }
                </dl>
                @if (_onboardingLink is not null)
                {
                    <BannerAlert Severity="StatusKind.Success" Title="Onboarding link created"
                                 Message="@($"Share this link with the operative{(_onboardingPasscode is null ? "" : $" (passcode {_onboardingPasscode})")}: {_onboardingLink}")" />
                }

                <div class="add-operative__finish">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _onboardingLink is not null)"
                               StartIcon="@Icons.Material.Outlined.Check" OnClick="Finish">
                        @(_method == "link" ? "Create link" : "Create operative")
                    </MudButton>
                    @if (_onboardingLink is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => Nav.NavigateTo("/workforce"))">Done</MudButton>
                    }
                </div>
            </div>
        </MudStep>
    </TedwrenStepper>
</div>

@code {
    private int _activeStep;
    private string _method = "direct";
    private string? _name;
    private string? _contact;
    private string? _trade;
    private string? _company;
    private bool _requirePasscode = true;
    private bool _busy;
    private string? _onboardingLink;
    private string? _onboardingPasscode;

    private IReadOnlyList<string> _trades = Array.Empty<string>();
    private IReadOnlyList<CompanySummary> _companies = Array.Empty<CompanySummary>();
    private IReadOnlyList<string> _companyNames = Array.Empty<string>();

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Workforce", "/workforce"),
        new("Add operative", null, disabled: true),
    };

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        _trades = await Reference.GetListAsync(ReferenceListKeys.Trades);
        _companies = await Org.GetCompaniesAsync();
        _companyNames = _companies.Select(c => c.Name).ToList();
    }

    private void OnMethodChanged(string value) => _method = value;

    private async Task Finish()
    {
        if (_method == "link")
        {
            // Create a real self-service onboarding link (SF-4/SUB-2). No email backend yet, so show the link
            // for the admin to share; the operative completes their own details and card photos there.
            _busy = true;
            var link = await Onboarding.CreateAsync(
                new CreateOnboardingLinkRequest(Tenant.CurrentCompanyId, _name, _trade, RequirePasscode: _requirePasscode), null);
            _busy = false;
            var passcodePart = link.Passcode is null ? string.Empty : $"&passcode={Uri.EscapeDataString(link.Passcode)}";
            _onboardingLink = $"{Nav.BaseUri}onboard?token={Uri.EscapeDataString(link.Token)}{passcodePart}";
            _onboardingPasscode = link.Passcode;
            return;
        }

        // Direct entry persists a real engagement via the API (SF-1/SF-2).
        var company = _companies.FirstOrDefault(c => c.Name == _company);
        if (string.IsNullOrWhiteSpace(_name) || company is null || string.IsNullOrWhiteSpace(_contact))
        {
            Snackbar.Add("Enter a name, employer and mobile number to create an operative.", Severity.Error);
            return;
        }

        _busy = true;
        var result = await Org.AddOperativeAsync(new AddOperativeRequest(
            company.Id, _name!.Trim(), _contact!.Trim(), _trade, InternalReference: null));
        _busy = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(result.Error ?? "Could not create the operative.", Severity.Error);
            return;
        }

        Snackbar.Add($"Operative \"{_name}\" added to {company.Name}.", Severity.Success);
        Nav.NavigateTo("/workforce");
    }
}
