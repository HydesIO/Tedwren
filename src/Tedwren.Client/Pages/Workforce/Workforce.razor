@page "/workforce"
@inject IListSampleDataService Data
@inject NavigationManager Nav

<PageTitle>Workforce · Tedwren</PageTitle>

<PageHeader Title="Workforce" Subtitle="Operative register, profiles and onboarding">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAddAlt"
                   OnClick="@(() => Nav.NavigateTo("/workforce/add"))">
            Add operative
        </MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="Operative"
                   Items="_operatives"
                   Columns="_columns"
                   SearchPlaceholder="Search operatives…"
                   EmptyTitle="No operatives yet"
                   EmptyDescription="Add an operative directly or send a self-service link to get started."
                   EmptyIcon="@Icons.Material.Outlined.Engineering" />
    </Body>
</DashboardCard>

@code {
    private IReadOnlyList<Operative> _operatives = Array.Empty<Operative>();
    private List<DataColumn<Operative>> _columns = new();

    protected override void OnInitialized()
    {
        _operatives = Data.GetOperatives();
        _columns = new()
        {
            new() { Title = "Name", Value = o => o.Name },
            new() { Title = "Trade", Value = o => o.Trade, Filterable = true },
            new() { Title = "Company", Value = o => o.Company, Filterable = true },
            new() { Title = "Primary site", Value = o => o.PrimarySite, Filterable = true },
            new()
            {
                Title = "Next expiry", Value = o => o.NextExpiry ?? DateOnly.MaxValue, Searchable = false,
                CellTemplate = o => @<span>@(o.NextExpiry?.ToString("dd MMM yyyy") ?? "—")</span>
            },
            new()
            {
                Title = "Status", Text = o => o.StatusLabel, Filterable = true, Sortable = false,
                CellTemplate = o => @<StatusPill Label="@o.StatusLabel" Status="o.Status" />
            },
        };
    }
}
