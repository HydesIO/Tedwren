@page "/workforce"
@using Tedwren.Abstractions.Common
@using Tedwren.Abstractions.Contracts.Workforce
@using Tedwren.Abstractions.Services
@inject IWorkforceService WorkforceSvc
@inject NavigationManager Nav

<PageTitle>Workforce · Tedwren</PageTitle>

<PageHeader Title="Workforce" Subtitle="Operative register, profiles and onboarding">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAddAlt"
                   OnClick="@(() => Nav.NavigateTo("/workforce/add"))">
            Add operative
        </MudButton>
    </Actions>
</PageHeader>

@* Active drill-down filter, e.g. arriving from a compliance legend row ("5 at risk" → those operatives, UAT-016). *@
@if (_activeStatus is { } status)
{
    <div class="workforce-filter">
        <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" />
        <span>Showing <strong>@ComplianceStatusView.Label(status)</strong> operatives (@_operatives.Count)</span>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilter">Clear filter</MudButton>
    </div>
}

<DashboardCard>
    <Body>
        <DataTable TItem="OperativeListItemDto"
                   Items="_operatives"
                   Columns="_columns"
                   Loading="_loading"
                   OnRowClick="OpenOperative"
                   SearchPlaceholder="Search operatives…"
                   EmptyTitle="No operatives yet"
                   EmptyDescription="Add an operative directly or send a self-service link to get started."
                   EmptyIcon="@Icons.Material.Outlined.Engineering" />
    </Body>
</DashboardCard>

@code {
    // Optional compliance-status drill-down from another page (e.g. the compliance legend). Matches a
    // ComplianceState enum name; anything else is ignored and the full register shows.
    [Parameter, SupplyParameterFromQuery(Name = "status")] public string? StatusFilter { get; set; }

    private IReadOnlyList<OperativeListItemDto> _all = Array.Empty<OperativeListItemDto>();
    private IReadOnlyList<OperativeListItemDto> _operatives = Array.Empty<OperativeListItemDto>();
    private List<DataColumn<OperativeListItemDto>> _columns = new();
    private bool _loading = true;
    private bool _loaded;
    private ComplianceState? _activeStatus;

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            BuildColumns();
            _all = await WorkforceSvc.ListOperativesAsync();
            _loaded = true;
            _loading = false;
        }

        _activeStatus = Enum.TryParse<ComplianceState>(StatusFilter, ignoreCase: true, out var status) ? status : null;
        _operatives = _activeStatus is { } s ? _all.Where(o => o.State == s).ToList() : _all;
    }

    private void ClearFilter() => Nav.NavigateTo("/workforce");

    private void OpenOperative(OperativeListItemDto op) => Nav.NavigateTo($"/workforce/{op.Slug}");

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Name", Value = o => o.Name },
            new() { Title = "Trade", Value = o => o.Trade ?? "—", Filterable = true },
            new() { Title = "Company", Value = o => o.Company, Filterable = true },
            new()
            {
                Title = "Next expiry", Value = o => o.NextExpiry ?? DateOnly.MaxValue, Searchable = false,
                CellTemplate = o => @<span>@(o.NextExpiry?.ToString("dd MMM yyyy") ?? "—")</span>
            },
            new()
            {
                Title = "Status", Text = o => o.StatusLabel, Filterable = true, Sortable = false,
                CellTemplate = o => @<StatusPill Label="@o.StatusLabel" Status="ComplianceStatusView.ToStatusKind(o.State)" />
            },
        };
    }
}
