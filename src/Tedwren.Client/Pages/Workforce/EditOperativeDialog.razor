@using Tedwren.Abstractions.Contracts.Organisation
@using Tedwren.Abstractions.Contracts.Workforce
@using Tedwren.Abstractions.Services
@inject IOrganisationService Org
@inject ISnackbar Snackbar

@* Edit an operative's per-company engagement (name + trade) and persist via IOrganisationService.UpdateEngagementAsync. *@

<MudDialog>
    <DialogContent>
        <div class="tw-dialog-body">
            <DialogGuidance>
                Name and trade are recorded per employer (<b>@Operative.Company</b>). The operative's mobile identity is unchanged (SF-1).
            </DialogGuidance>

            <div class="tw-dialog-body--grid">
                <TedwrenTextField Label="Name" @bind-Value="_name" Required="true"
                                  Error="_submitted && string.IsNullOrWhiteSpace(_name)" ErrorText="Name is required." />
                <TedwrenTextField Label="Trade" @bind-Value="_trade" />
            </div>

            @* Emergency contact is captured per person and shown on the overview (MC-2/UAT-010). *@
            <FormSection Title="Emergency contact" Description="Recorded for the person and shared across their employers.">
                <TedwrenTextField Label="Contact name" @bind-Value="_emergencyName" Placeholder="e.g. Jordan Doe" />
                <TedwrenTextField Label="Contact phone" @bind-Value="_emergencyPhone" Placeholder="e.g. 07700 900123" />
            </FormSection>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OperativeDetailDto Operative { get; set; } = default!;

    private string? _name;
    private string? _trade;
    private string? _emergencyName;
    private string? _emergencyPhone;
    private bool _submitted;
    private bool _busy;

    protected override void OnInitialized()
    {
        _name = Operative.Name;
        _trade = Operative.Trade;
        _emergencyName = Operative.EmergencyContactName;
        _emergencyPhone = Operative.EmergencyContactPhone;
    }

    private async Task SaveAsync()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Error);
            return;
        }

        _busy = true;
        var ok = await Org.UpdateEngagementAsync(
            Operative.CompanyId, Operative.EngagementId, new UpdateEngagementRequest(_name!, _trade));
        // Emergency contact is person-level (shared across employers); persist it alongside the engagement edit.
        await Org.UpdatePersonContactAsync(
            Operative.PersonId, new UpdatePersonContactRequest(_emergencyName, _emergencyPhone));
        _busy = false;

        if (ok)
        {
            Snackbar.Add("Operative updated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_name!));   // return the new name so the caller can follow the slug
        }
        else
        {
            Snackbar.Add("Could not update the operative — the name may already be in use for this employer.", Severity.Error);
        }
    }
}
