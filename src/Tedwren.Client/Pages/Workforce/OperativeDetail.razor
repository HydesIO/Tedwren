@page "/workforce/{Slug}"
@using Tedwren.Abstractions.Contracts.Workforce
@using Tedwren.Abstractions.Services
@inject IWorkforceService Workforce
@inject ISnackbar Snackbar

<PageTitle>@(_op?.Name ?? "Operative") · Tedwren</PageTitle>

@if (_loading)
{
    <PageHeader Title="Loading operative…" />
}
else if (_op is null)
{
    <PageHeader Title="Operative not found" />
    <DashboardCard>
        <Body>
            <EmptyState Icon="@Icons.Material.Outlined.Engineering"
                        Title="Operative not found"
                        Description="No active operative matches this link.">
                <Action>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/workforce">Back to workforce</MudButton>
                </Action>
            </EmptyState>
        </Body>
    </DashboardCard>
}
else
{
    <DetailHeader Title="@_op.Name"
                  Subtitle="@($"{_op.Trade ?? "—"} · {_op.Company}")"
                  StatusLabel="@_op.StatusLabel"
                  Status="ComplianceStatusView.ToStatusKind(_op.State)"
                  AvatarText="@Initials(_op.Name)"
                  Breadcrumbs="_crumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => Snackbar.Add("Edit operative (demo).", Severity.Info))">
                Edit
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Send" OnClick="@(() => Snackbar.Add("Self-service link sent (demo).", Severity.Info))">
                Send update link
            </MudButton>
        </Actions>
    </DetailHeader>

    <div class="detail-tabs">
        <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="detail-tabs__panel">
            <MudTabPanel Text="Overview">
                <DashboardCard Title="Operative details">
                    <Body>
                        <KeyValueList Items="_overview" />
                    </Body>
                </DashboardCard>
            </MudTabPanel>

            <MudTabPanel Text="@($"Qualifications ({_op.Qualifications.Count})")">
                @if (_op.Qualifications.Count == 0)
                {
                    <DashboardCard>
                        <Body>
                            <EmptyState Icon="@Icons.Material.Outlined.WorkspacePremium"
                                        Title="No qualifications recorded"
                                        Description="This operative has no captured cards yet." />
                        </Body>
                    </DashboardCard>
                }
                else
                {
                    <div class="qual-grid">
                        @foreach (var q in _op.Qualifications)
                        {
                            <div class="qual-card">
                                <div class="qual-card__top">
                                    <span class="qual-card__name">@q.Name</span>
                                    <StatusPill Label="@q.StatusLabel" Status="ComplianceStatusView.ToStatusKind(q.State)" />
                                </div>
                                <div class="qual-card__meta">
                                    <span>Issuer: @(q.Issuer ?? "—")</span>
                                    <span>Obtained: @(q.ObtainedOn?.ToString("dd MMM yyyy") ?? "—")</span>
                                    <span>Expires: @(q.ExpiresOn?.ToString("dd MMM yyyy") ?? "No expiry")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="History">
                <DashboardCard Title="Recent history">
                    <Body>
                        @if (_history.Count == 0)
                        {
                            <EmptyState Icon="@Icons.Material.Outlined.History"
                                        Title="No recent history"
                                        Description="Site-entry decisions for this operative will appear here." />
                        }
                        else
                        {
                            <ActivityFeed Items="_history" />
                        }
                    </Body>
                </DashboardCard>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private OperativeDetailDto? _op;
    private bool _loading = true;
    private List<KeyValueList.Pair> _overview = new();
    private List<ActivityItem> _history = new();
    private IReadOnlyList<DetailHeader.Crumb> _crumbs = Array.Empty<DetailHeader.Crumb>();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _op = await Workforce.GetOperativeBySlugAsync(Slug);
        _loading = false;
        if (_op is null) return;

        _crumbs = new List<DetailHeader.Crumb>
        {
            new("Workforce", "/workforce"),
            new(_op.Name),
        };

        _overview = new()
        {
            new("Trade", _op.Trade ?? "—"),
            new("Employer", _op.Company),
            new("Phone", _op.Phone ?? "—"),
        };

        _history = _op.History
            .Select(h => new ActivityItem(
                h.Title.Contains("blocked", StringComparison.OrdinalIgnoreCase)
                    ? Icons.Material.Outlined.Block
                    : Icons.Material.Outlined.HowToReg,
                h.Title,
                h.Detail ?? string.Empty,
                h.OccurredUtc.LocalDateTime.ToString("dd MMM yyyy HH:mm"),
                h.Title.Contains("blocked", StringComparison.OrdinalIgnoreCase) ? StatusKind.Danger : StatusKind.Success))
            .ToList();
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
