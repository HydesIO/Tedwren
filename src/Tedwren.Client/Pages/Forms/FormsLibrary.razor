@page "/forms"
@using Tedwren.Abstractions.Contracts.Forms
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject IFormTemplateService Forms
@inject IFormAssignmentService Assignments
@inject ITenantState Tenant
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Forms Library · Tedwren</PageTitle>

<PageHeader Title="Forms Library" Subtitle="Build and manage your organisation's custom forms (PRD-Phase 2)">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.LibraryAdd"
                   Disabled="_seeding" OnClick="SeedStartersAsync">Add starter forms</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   Href="/forms/new">New form</MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="FormTemplateSummaryDto"
                   Items="_templates"
                   Columns="_columns"
                   Loading="_loading"
                   SearchPlaceholder="Search forms…"
                   EmptyTitle="No forms yet"
                   EmptyDescription="Create your first custom form to start building your library."
                   EmptyIcon="@Icons.Material.Outlined.Dashboard" />
    </Body>
</DashboardCard>

@if (_assignments.Count > 0)
{
    <div class="mt-6">
        <DashboardCard Title="Assignments">
            <Body>
                <DataTable TItem="FormAssignmentDto"
                           Items="_assignments"
                           Columns="_assignmentColumns"
                           Loading="_loading"
                           SearchPlaceholder="Search assignments…"
                           EmptyTitle="No assignments"
                           EmptyDescription="Assign a published form to a site, operator or the organisation."
                           EmptyIcon="@Icons.Material.Outlined.AssignmentInd" />
            </Body>
        </DashboardCard>
    </div>
}

@code {
    private IReadOnlyList<FormTemplateSummaryDto> _templates = Array.Empty<FormTemplateSummaryDto>();
    private IReadOnlyList<FormAssignmentDto> _assignments = Array.Empty<FormAssignmentDto>();
    private List<DataColumn<FormTemplateSummaryDto>> _columns = new();
    private List<DataColumn<FormAssignmentDto>> _assignmentColumns = new();
    private bool _loading = true;
    private bool _seeding;

    private async Task SeedStartersAsync()
    {
        _seeding = true;
        try
        {
            var created = await Forms.SeedStarterTemplatesAsync();
            Snackbar.Add(created > 0 ? $"Added {created} starter form(s)." : "Starter forms are already in your library.",
                created > 0 ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        finally { _seeding = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        BuildColumns();
        BuildAssignmentColumns();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _templates = await Forms.GetTemplatesAsync();
        _assignments = await Assignments.GetAssignmentsAsync();
        _loading = false;
    }

    private void BuildAssignmentColumns()
    {
        _assignmentColumns = new()
        {
            new() { Title = "Form", Value = a => a.FormName, Filterable = true },
            new()
            {
                Title = "Assigned to", Value = a => a.Scope, Searchable = false, Filterable = true,
                CellTemplate = a => @<span>@(a.Scope == "Site" && a.SiteName is not null ? $"Site: {a.SiteName}" : a.Scope)</span>
            },
            new() { Title = "Cadence", Value = a => a.Schedule, Searchable = false, Filterable = true },
            new() { Title = "Failure alert", Value = a => a.FailureAlertEmail ?? "—", Searchable = false },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false,
                CellTemplate = a => @<MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                StartIcon="@Icons.Material.Outlined.Delete"
                                                OnClick="@(() => UnassignAsync(a))">Remove</MudButton>
            },
        };
    }

    private async Task AssignAsync(FormTemplateSummaryDto template)
    {
        var parameters = new DialogParameters<FormAssignDialog>
        {
            { x => x.FamilyId, template.FamilyId },
            { x => x.FormName, template.Name },
        };
        var dialog = await Dialogs.ShowAsync<FormAssignDialog>("Assign form", parameters, TedwrenDialog.Medium());
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task UnassignAsync(FormAssignmentDto assignment)
    {
        await Assignments.DeleteAsync(assignment.Id);
        Snackbar.Add("Assignment removed.", Severity.Info);
        await LoadAsync();
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Form", Value = t => t.Name, Filterable = true },
            new() { Title = "Description", Value = t => t.Description ?? "—", Searchable = false },
            new() { Title = "Fields", Value = t => t.FieldCount, Searchable = false, AlignRight = true },
            new() { Title = "Version", Value = t => t.Version, Searchable = false, AlignRight = true },
            new()
            {
                Title = "Status", Value = t => t.Status, Searchable = false, Filterable = true,
                CellTemplate = t => @<StatusPill Label="@t.Status" Status="@ToStatusKind(t.Status)" />
            },
            new()
            {
                Title = "Updated", Value = t => t.UpdatedUtc, Searchable = false,
                CellTemplate = t => @<span>@t.UpdatedUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
            },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false,
                CellTemplate = t => @<div class="forms-library__row-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Edit"
                               OnClick="@(() => Nav.NavigateTo($"/forms/{t.Id}/edit"))">Edit</MudButton>
                    @if (t.Status == "Published")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Outlined.EditNote"
                                   OnClick="@(() => Nav.NavigateTo($"/forms/{t.Id}/fill"))">Fill in</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Outlined.AssignmentInd"
                                   OnClick="@(() => AssignAsync(t))">Assign</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               StartIcon="@Icons.Material.Outlined.Archive"
                               OnClick="@(() => ArchiveAsync(t))">Archive</MudButton>
                </div>
            },
        };
    }

    private async Task ArchiveAsync(FormTemplateSummaryDto template)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Archive \"{template.Name}\"? It will be removed from the library (history is kept)." },
            { x => x.ConfirmText, "Archive" },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Archive form", parameters, TedwrenDialog.Small());
        if (await dialog.Result is { Canceled: false })
        {
            await Forms.ArchiveAsync(template.Id);
            Snackbar.Add($"Archived \"{template.Name}\".", Severity.Info);
            await LoadAsync();
        }
    }

    private static StatusKind ToStatusKind(string status) => status switch
    {
        "Published" => StatusKind.Success,
        "Draft" => StatusKind.Warning,
        "Archived" => StatusKind.Neutral,
        _ => StatusKind.Neutral,
    };
}
