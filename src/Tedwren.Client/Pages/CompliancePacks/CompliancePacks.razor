@page "/compliance-packs"
@using Tedwren.Abstractions.Common
@using Tedwren.Abstractions.Contracts.CompliancePacks
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject ICompliancePackService Packs
@inject ICurrentUserService CurrentUser
@inject IWorkforceService Workforce
@inject ITenantState Tenant
@inject ISnackbar Snackbar

<PageTitle>Compliance Packs · Tedwren</PageTitle>

@* Sending compliance packs is the subcontractor's defining feature (SUB-13…26). A main contractor
   receives and opens packs shared by its subcontractors (MC-19) — sending is not its core surface. *@
<PageHeader Title="Compliance Packs"
            Subtitle="@(_isMainContractor
                ? "Open and review packs shared with you by your subcontractors"
                : "Build, send and track shareable compliance evidence")" />

@if (_isMainContractor)
{
    <BannerAlert Severity="StatusKind.Info" Title="Receiving packs (MC-19)"
                 Message="Compliance packs are sent to you by your subcontractors and opened here — no account or set-up needed on their side. Building and sending packs is a subcontractor feature." />
}

<DashboardCard Class="pack-builder">
    <Body>
        <MudText Typo="Typo.h6" Class="pack-builder__title">New pack</MudText>
        <MudTextField @bind-Value="_title" Label="Pack title" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pack-builder__field" />

        <MudText Typo="Typo.subtitle2" Class="pack-builder__label">Operatives</MudText>
        <div class="pack-builder__operatives">
            @foreach (var op in _operatives)
            {
                <MudCheckBox T="bool"
                             Value="_selected.Contains(op.Id)"
                             ValueChanged="@(v => Toggle(op.Id, v))"
                             Label="@op.Name"
                             Dense="true" />
            }
        </div>

        @if (_issues.Count > 0)
        {
            <BannerAlert Severity="@(_issues.Any(i => i.Blocking) ? StatusKind.Danger : StatusKind.Warning)"
                         Title="Not-site-ready problems found"
                         Message="@IssuesSummary()" />
        }

        @if (!_canSend)
        {
            <BannerAlert Severity="StatusKind.Info" Title="Sending is restricted"
                         Message="Only Administrators and Compliance Managers can send compliance packs (SUB-22)." />
        }

        <div class="pack-builder__actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _selected.Count == 0 || !_canSend"
                       OnClick="@(() => SendAsync(false))">Check &amp; send</MudButton>
            @if (_canSend && _issues.Any(i => i.Blocking))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy"
                           OnClick="@(() => SendAsync(true))">Acknowledge &amp; send anyway</MudButton>
            }
        </div>
    </Body>
</DashboardCard>

<DashboardCard>
    <Body>
        <DataTable TItem="PackListItemDto"
                   Items="_packs"
                   Columns="_columns"
                   Loading="_loading"
                   SearchPlaceholder="Search pack title…"
                   EmptyTitle="No packs"
                   EmptyDescription="No compliance packs have been sent yet."
                   EmptyIcon="@Icons.Material.Outlined.FolderShared" />
    </Body>
</DashboardCard>

@code {
    private IReadOnlyList<(Guid Id, string Name)> _operatives = Array.Empty<(Guid, string)>();

    private string _title = "Weekly compliance pack";
    private readonly HashSet<Guid> _selected = new();
    private IReadOnlyList<ReadinessIssueDto> _issues = Array.Empty<ReadinessIssueDto>();
    private IReadOnlyList<PackListItemDto> _packs = Array.Empty<PackListItemDto>();
    private List<DataColumn<PackListItemDto>> _columns = new();
    private bool _loading = true;
    private bool _busy;

    // SUB-22: only nominated roles may send/re-issue packs (AccessRole names).
    private static readonly string[] NominatedRoles = { "Administrator", "ComplianceManager" };
    private bool _canSend;

    // The active company's product: a main contractor receives packs (MC-19); a subcontractor sends them.
    private OrgType? _product;
    private bool _isMainContractor => _product == OrgType.MainContractor;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        _product = Tenant.CurrentOrgType;
        BuildColumns();
        var currentUser = await CurrentUser.GetCurrentAsync();
        _canSend = NominatedRoles.Contains(currentUser.Role, StringComparer.OrdinalIgnoreCase);

        var operatives = await Workforce.ListOperativesAsync();
        _operatives = operatives.Select(o => (o.PersonId, o.Name)).ToList();
        _selected.UnionWith(_operatives.Select(o => o.Id));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _packs = await Packs.ListForCompanyAsync(Tenant.CurrentCompanyId);
        _loading = false;
    }

    // One-line summary of the current readiness issues for the banner (SUB-14).
    private string IssuesSummary() =>
        string.Join("; ", _issues.Select(i => $"{i.SubjectName} — {i.QualificationName}: {i.Detail}{(i.Blocking ? " (blocking)" : "")}"));

    private void Toggle(Guid id, bool selected)
    {
        if (selected) _selected.Add(id); else _selected.Remove(id);
        _issues = Array.Empty<ReadinessIssueDto>();   // selection changed — re-check before sending
    }

    // Builds/sends the pack. First attempt surfaces blocking readiness issues (SUB-14); acknowledge to proceed.
    private Task SendAsync(bool acknowledge) => BuildAsync(_title, acknowledge, supersedesPackId: null);

    // Re-issues a pack: builds a fresh snapshot for the current selection that supersedes the old pack (R7).
    private async Task ReissueAsync(PackListItemDto pack)
    {
        if (_selected.Count == 0)
        {
            Snackbar.Add("Select the operatives to include, then re-issue.", Severity.Warning);
            return;
        }

        await BuildAsync(pack.Title, acknowledge: true, supersedesPackId: pack.Id);
    }

    // Shared build path used by send and re-issue.
    private async Task BuildAsync(string title, bool acknowledge, Guid? supersedesPackId)
    {
        _busy = true;
        var request = new BuildPackRequest(
            Tenant.CurrentCompanyId, title, "You", SiteId: null, FromDate: null, ToDate: null,
            _selected.ToList(), Passcode: null, ExpiryDays: null, AcknowledgeIssues: acknowledge, SupersedesPackId: supersedesPackId);
        var result = await Packs.BuildAsync(request);
        _busy = false;

        if (!result.Sent)
        {
            _issues = result.Issues;
            Snackbar.Add("Pack not sent — resolve or acknowledge the readiness problems.", Severity.Warning);
            return;
        }

        _issues = Array.Empty<ReadinessIssueDto>();
        Snackbar.Add($"Pack sent. Passcode: {result.Passcode}", Severity.Success);
        await LoadAsync();
    }

    private async Task RevokeAsync(PackListItemDto pack)
    {
        if (await Packs.RevokeAsync(Tenant.CurrentCompanyId, pack.Id))
        {
            Snackbar.Add($"Revoked \"{pack.Title}\".", Severity.Info);
            await LoadAsync();
        }
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Pack", Value = p => p.Title, Filterable = true },
            new() { Title = "Site", Value = p => p.SiteName ?? "—", Searchable = false },
            new()
            {
                Title = "Status", Value = p => p.Status, Searchable = false, Filterable = true,
                CellTemplate = p => @<StatusPill Label="@p.Status" Status="@ToStatusKind(p.Status)" />
            },
            new()
            {
                Title = "Operatives", Value = p => p.SubjectCount, Searchable = false,
                CellTemplate = p => @<span>@p.SubjectCount</span>
            },
            new()
            {
                Title = "Opened / Downloaded", Value = p => p.OpenedCount, Searchable = false,
                CellTemplate = p => @<span>@p.OpenedCount / @p.DownloadedCount</span>
            },
            new()
            {
                Title = "Expires", Value = p => p.ExpiresUtc, Searchable = false,
                CellTemplate = p => @<span>@p.ExpiresUtc.ToString("dd MMM yyyy")</span>
            },
            new()
            {
                Title = "", Value = _ => string.Empty, Searchable = false,
                CellTemplate = p => @<div class="pack-row-actions">
                    @if (_canSend && (p.Status == "Active" || p.Status == "Expired"))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="@(() => ReissueAsync(p))">Re-issue</MudButton>
                    }
                    @if (p.Status == "Active")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   OnClick="@(() => RevokeAsync(p))">Revoke</MudButton>
                    }
                </div>
            },
        };
    }

    private static StatusKind ToStatusKind(string status) => status switch
    {
        "Active" => StatusKind.Success,
        "Expired" => StatusKind.Warning,
        "Revoked" => StatusKind.Danger,
        "Superseded" => StatusKind.Neutral,
        _ => StatusKind.Neutral,
    };
}
