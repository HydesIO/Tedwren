@page "/users"
@using Tedwren.Abstractions.Contracts.Users
@using Tedwren.Abstractions.Services
@using Tedwren.UiComponents.Models
@inject IUserService UserData
@inject NavigationManager Nav

<PageTitle>Users · Tedwren</PageTitle>

<PageHeader Title="Users" Subtitle="Console access, roles and account status">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd"
                   OnClick="InviteUser">
            Invite user
        </MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="UserDto"
                   Items="_users"
                   Columns="_columns"
                   Loading="_loading"
                   OnRowClick="OpenUser"
                   SearchPlaceholder="Search users…"
                   EmptyTitle="No users yet"
                   EmptyDescription="Invite a colleague to give them console access."
                   EmptyIcon="@Icons.Material.Outlined.People" />
    </Body>
</DashboardCard>

@code {
    private IReadOnlyList<UserDto> _users = Array.Empty<UserDto>();
    private List<DataColumn<UserDto>> _columns = new();
    private bool _loading = true;

    // Loads the users through the shared IUserService, served from mock or the API identically (SF-20).
    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        _users = await UserData.GetUsersAsync();
        _loading = false;
    }

    private void InviteUser() => Nav.NavigateTo("/users/invite");

    private void OpenUser(UserDto user) => Nav.NavigateTo($"/users/{user.Id}");

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Name", Value = u => u.Name },
            new() { Title = "Email", Value = u => u.Email, Filterable = true },
            new() { Title = "Role", Value = u => u.RoleLabel, Filterable = true },
            new()
            {
                Title = "Last active", Value = u => u.LastActiveUtc ?? DateTimeOffset.MinValue, Searchable = false,
                CellTemplate = u => @<span>@(u.LastActiveUtc is { } t ? t.LocalDateTime.ToString("dd MMM yyyy") : "—")</span>
            },
            new()
            {
                Title = "Status", Text = u => u.StatusLabel, Filterable = true, Sortable = false,
                CellTemplate = u => @<StatusPill Label="@u.StatusLabel" Status="ToStatus(u.Status)" />
            },
        };
    }

    // Maps the account status to the shared pill palette.
    private static StatusKind ToStatus(string status) => status switch
    {
        "Active" => StatusKind.Success,
        "Invited" => StatusKind.Warning,
        "Suspended" => StatusKind.Neutral,
        _ => StatusKind.Neutral,
    };
}
