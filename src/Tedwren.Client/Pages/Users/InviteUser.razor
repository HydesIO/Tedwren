@page "/users/invite"
@using Tedwren.Abstractions.Contracts.Users
@using Tedwren.Abstractions.Services
@using Tedwren.UiComponents.Models
@inject IUserService Users
@inject ITenantState Tenant
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Invite user · Tedwren</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0" />

<PageHeader Title="Invite user" Subtitle="Send an invitation and set the user's role" />

<div class="form-page">
    <FormSection Title="User details" Description="We'll email an invitation to join the workspace.">
        <TedwrenTextField Label="Full name" @bind-Value="_name" Required="true" Placeholder="Full name"
                          Error="_submitted && string.IsNullOrWhiteSpace(_name)"
                          ErrorText="Name is required." />
        <TedwrenTextField Label="Email address" @bind-Value="_email" Required="true"
                          InputType="InputType.Email" Placeholder="name@company.com"
                          Error="_submitted && !IsValidEmail(_email)"
                          ErrorText="Enter a valid email address." />
        <TedwrenSelect T="string" Label="Role" @bind-Value="_role" Required="true"
                       Options="_roleValues" Placeholder="Select a role"
                       HelperText="The role sets what the user can do. The auditor role is read-only (SF-23)."
                       Error="_submitted && string.IsNullOrWhiteSpace(_role)"
                       ErrorText="Select a role." />
    </FormSection>

    @if (SelectedRole is { } role)
    {
        <FormSection Title="What this role can do" Description="Roles set sensible defaults for console access.">
            <div class="form-page__full">
                <BannerAlert Severity="@(role.CanWrite ? StatusKind.Info : StatusKind.Warning)"
                             Title="@role.Label"
                             Message="@(role.CanWrite
                                 ? "Can view and change data within the modules the company has enabled."
                                 : "Read-only access — can view data but cannot make any changes.")" />
            </div>
        </FormSection>
    }

    @if (_acceptLink is not null)
    {
        <FormSection Title="@(_emailSent ? "Invitation emailed" : "Invitation link")"
                     Description="@(_emailSent
                         ? "We've emailed the invitation. You can also share this one-time link directly if needed."
                         : "No email was sent — share this one-time link with the invitee so they can set a password and sign in.")">
            <div class="form-page__full">
                <BannerAlert Severity="@(_emailSent ? StatusKind.Success : StatusKind.Warning)"
                             Title="@(_emailSent ? $"Invitation emailed to {_email}" : "Invitation created — email not sent")"
                             Message="@_acceptLink" />
            </div>
        </FormSection>
    }

    <FormActions>
        <Secondary>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">@(_acceptLink is null ? "Cancel" : "Done")</MudButton>
        </Secondary>
        <Primary>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send"
                       OnClick="Send" Disabled="_acceptLink is not null">Send invitation</MudButton>
        </Primary>
    </FormActions>
</div>

@code {
    private string? _name;
    private string? _email;
    private string? _role;
    private bool _submitted;

    private IReadOnlyList<RoleOption> _roles = Array.Empty<RoleOption>();
    private IReadOnlyList<string> _roleValues = Array.Empty<string>();

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Users", "/users"),
        new("Invite user", null, disabled: true),
    };

    private RoleOption? SelectedRole => _roles.FirstOrDefault(r => r.Value == _role);

    protected override async Task OnInitializedAsync()
    {
        _roles = await Users.GetRolesAsync();
        _roleValues = _roles.Select(r => r.Value).ToList();
    }

    private async Task Send()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_name) || !IsValidEmail(_email) || string.IsNullOrWhiteSpace(_role))
        {
            Snackbar.Add("Please fix the highlighted fields.", Severity.Error);
            return;
        }

        try
        {
            var result = await Users.InviteUserAsync(new InviteUserRequest(Tenant.CurrentCompanyId, _name!, _email!, _role!));
            // The API emails the branded accept-invite link when a real provider is configured. We still show
            // the one-time link as a fallback the admin can share (e.g. in local/dev where email is stubbed, or
            // if delivery failed), so an invite is never blocked by a mail issue.
            _emailSent = result.EmailSent;
            _acceptLink = $"{Nav.BaseUri}accept-invite?token={result.AcceptToken}";
            Snackbar.Add(
                result.EmailSent ? $"Invitation emailed to {_email}." : $"Invitation created for {_email} — share the link below.",
                result.EmailSent ? Severity.Success : Severity.Info);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string? _acceptLink;
    private bool _emailSent;

    private void Cancel() => Nav.NavigateTo("/users");

    private static bool IsValidEmail(string? value)
        => !string.IsNullOrWhiteSpace(value) && value.Contains('@') && value.Contains('.');
}
