@page "/permits"
@using Tedwren.Abstractions.Contracts.Permits
@using Tedwren.Abstractions.Services
@inject IPermitService PermitSvc
@inject ITenantState Tenant
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Permits · Tedwren</PageTitle>

<PageHeader Title="Permits" Subtitle="Permits to work raised for this company">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Assignment"
                   Href="/permits/new">Issue permit</MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="PermitDto"
                   Items="_permits"
                   Columns="_columns"
                   Loading="_loading"
                   SearchPlaceholder="Search permits…"
                   EmptyTitle="No permits yet"
                   EmptyDescription="Issue a permit to see it listed here."
                   EmptyIcon="@Icons.Material.Outlined.Assignment" />
    </Body>
</DashboardCard>

@code {
    private bool _loading = true;

    private IReadOnlyList<PermitDto> _permits = Array.Empty<PermitDto>();
    private List<DataColumn<PermitDto>> _columns = new();

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        BuildColumns();
        await LoadPermitsAsync();
    }

    private async Task LoadPermitsAsync()
    {
        _loading = true;
        _permits = await PermitSvc.ListForCompanyAsync(Tenant.CurrentCompanyId);
        _loading = false;
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Type", Value = p => p.PermitType, Filterable = true },
            new() { Title = "Site", Value = p => p.SiteName ?? "—", Filterable = true },
            new() { Title = "Responsible", Value = p => p.ResponsiblePerson ?? "—" },
            new()
            {
                Title = "Valid", Value = p => p.ValidFrom ?? DateOnly.MaxValue, Searchable = false,
                CellTemplate = p => @<span>@FormatPeriod(p)</span>
            },
            new() { Title = "Status", Value = p => p.Status, Filterable = true },
            new()
            {
                Title = "Actions", Value = _ => string.Empty, Searchable = false,
                CellTemplate = p => @<div class="permit-row-actions">
                    @if (p.Status is "Draft" or "Issued")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="@(() => ApprovePermit(p))">Approve</MudButton>
                    }
                    @if (p.Status is "Issued" or "Approved")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   OnClick="@(() => ClosePermit(p))">Close</MudButton>
                    }
                </div>
            },
        };
    }

    private async Task ApprovePermit(PermitDto p)
    {
        var at = string.IsNullOrWhiteSpace(p.SiteName) ? "" : $" at {p.SiteName}";
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Approve the {p.PermitType} permit{at}?" },
            { x => x.ConfirmText, "Approve" },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Approve permit", parameters, TedwrenDialog.Small());
        if (await dialog.Result is { Canceled: false })
        {
            var ok = await PermitSvc.ApproveAsync(p.Id);
            Snackbar.Add(ok ? "Permit approved." : "Could not approve the permit.", ok ? Severity.Success : Severity.Error);
            if (ok) await LoadPermitsAsync();
        }
    }

    private async Task ClosePermit(PermitDto p)
    {
        var at = string.IsNullOrWhiteSpace(p.SiteName) ? "" : $" at {p.SiteName}";
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Close the {p.PermitType} permit{at}? This marks the work complete." },
            { x => x.ConfirmText, "Close permit" },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Close permit", parameters, TedwrenDialog.Small());
        if (await dialog.Result is { Canceled: false })
        {
            var ok = await PermitSvc.CloseAsync(p.Id, null);
            Snackbar.Add(ok ? "Permit closed." : "Could not close the permit.", ok ? Severity.Success : Severity.Error);
            if (ok) await LoadPermitsAsync();
        }
    }

    private static string FormatPeriod(PermitDto p)
    {
        if (p.ValidFrom is null && p.ValidTo is null) return "—";
        var from = p.ValidFrom?.ToString("dd MMM yyyy") ?? "—";
        var to = p.ValidTo?.ToString("dd MMM yyyy") ?? "—";
        return $"{from} → {to}";
    }
}
