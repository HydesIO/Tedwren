@page "/permits"
@using Tedwren.Abstractions.Contracts.Permits
@using Tedwren.Abstractions.Services
@inject IPermitService PermitSvc
@inject ITenantState Tenant

<PageTitle>Permits · Tedwren</PageTitle>

<PageHeader Title="Permits" Subtitle="Permits to work raised for this company">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Assignment"
                   Href="/permits/new">Issue permit</MudButton>
    </Actions>
</PageHeader>

<DashboardCard>
    <Body>
        <DataTable TItem="PermitDto"
                   Items="_permits"
                   Columns="_columns"
                   Loading="_loading"
                   SearchPlaceholder="Search permits…"
                   EmptyTitle="No permits yet"
                   EmptyDescription="Issue a permit to see it listed here."
                   EmptyIcon="@Icons.Material.Outlined.Assignment" />
    </Body>
</DashboardCard>

@code {
    private bool _loading = true;

    private IReadOnlyList<PermitDto> _permits = Array.Empty<PermitDto>();
    private List<DataColumn<PermitDto>> _columns = new();

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        BuildColumns();
        await LoadPermitsAsync();
    }

    private async Task LoadPermitsAsync()
    {
        _loading = true;
        _permits = await PermitSvc.ListForCompanyAsync(Tenant.CurrentCompanyId);
        _loading = false;
    }

    private void BuildColumns()
    {
        _columns = new()
        {
            new() { Title = "Type", Value = p => p.PermitType, Filterable = true },
            new() { Title = "Site", Value = p => p.SiteName ?? "—", Filterable = true },
            new() { Title = "Responsible", Value = p => p.ResponsiblePerson ?? "—" },
            new()
            {
                Title = "Valid", Value = p => p.ValidFrom ?? DateOnly.MaxValue, Searchable = false,
                CellTemplate = p => @<span>@FormatPeriod(p)</span>
            },
            new() { Title = "Status", Value = p => p.Status, Filterable = true },
        };
    }

    private static string FormatPeriod(PermitDto p)
    {
        if (p.ValidFrom is null && p.ValidTo is null) return "—";
        var from = p.ValidFrom?.ToString("dd MMM yyyy") ?? "—";
        var to = p.ValidTo?.ToString("dd MMM yyyy") ?? "—";
        return $"{from} → {to}";
    }
}
