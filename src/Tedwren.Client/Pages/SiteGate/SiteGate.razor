@page "/site-gate"
@using Tedwren.Abstractions.Common
@using Tedwren.Abstractions.Contracts.SiteEntry
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject ISiteEntryService SiteEntry
@inject ISiteService Sites
@inject IWorkforceService Workforce
@inject ITenantState Tenant
@inject ISnackbar Snackbar

<PageTitle>@(_isSubcontractor ? "Site Attendance" : "Site Gate") · Tedwren</PageTitle>

@* The subcontractor product never presents a site-access decision (R18, SUB-12): it records attendance and
   flags outstanding cards ("recorded" / "site-ready"), never "permitted/denied/blocked". The main contractor
   product makes the actual five-check entry decision (MC-8, R10) with a manager override (MC-11). *@
<PageHeader Title="@(_isSubcontractor ? "Site Attendance" : "Site Gate")"
            Subtitle="@(_isSubcontractor
                ? "Record who is on site — attendance and required cards, and live muster"
                : "Five-check entry decision, manager override and live muster")" />

<DashboardCard>
    <Body>
        <MudText Typo="Typo.h6">@(_isSubcontractor ? "Record attendance" : "Check entry")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary gate__hint">
            @(_isSubcontractor
                ? "Select an operative to record arrival and check their required cards (SUB-7, SUB-11)."
                : "Select an operative to run the five-check entry decision (MC-8, R10).")
        </MudText>

        <AsyncContent Loading="_loading" Error="@_error" ErrorTitle="Couldn't load the gate"
                      OnRetry="LoadAsync" Variant="LoadingSkeleton.SkeletonVariant.Card" Rows="4"
                      IsEmpty="@(_operatives.Count == 0)" EmptyIcon="@Icons.Material.Outlined.Engineering"
                      EmptyTitle="No operatives" EmptyDescription="No operatives are registered for this company yet.">
            <div class="gate__operatives">
                @foreach (var op in _operatives)
                {
                    <button type="button"
                            class="@($"gate__op{(op.Id == _lastPersonId ? " gate__op--active" : string.Empty)}")"
                            @onclick="@(() => DecideAsync(op.Id))">
                        <span class="gate__op-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" />
                        </span>
                        <span class="gate__op-name">@op.Name</span>
                    </button>
                }
            </div>
        </AsyncContent>

        @if (_result is { } r)
        {
            var view = SiteGateResultPresenter.For(_product, r);
            <div class="gate__result">
                <BannerAlert Severity="@view.Severity" Title="@view.Title" Message="@view.Message" />

                <MudSimpleTable Dense="true" Class="gate__checks">
                    <thead><tr><th>Check</th><th>Outcome</th><th>Detail</th></tr></thead>
                    <tbody>
                        @foreach (var c in r.Checks)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td><StatusPill Label="@c.Outcome" Status="@ToStatusKind(c.Outcome)" /></td>
                                <td>@c.Detail</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @* Manager override of a block is a main-contractor concept (MC-11). The subcontractor product
                   never blocks, so there is nothing to override — it only records (R18). *@
                @if (view.OffersOverride)
                {
                    <div class="gate__override-row">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Outlined.AdminPanelSettings"
                                   OnClick="OverrideAsync">Manager override (today only)</MudButton>
                    </div>
                }
            </div>
        }
    </Body>
</DashboardCard>

<DashboardCard>
    <Body>
        <div class="gate__muster-head">
            <MudText Typo="Typo.h6">On site now</MudText>
            @if (_muster is { } m)
            {
                <MudText Typo="Typo.caption">As at @m.GeneratedUtc.ToString("HH:mm:ss") UTC · @_dataAgeSeconds s ago</MudText>
            }
        </div>

        @if (_muster is { } muster)
        {
            <div class="gate__cover">
                @foreach (var cover in muster.Competencies)
                {
                    <StatusPill Label="@($"{cover.Competency}: {(cover.Covered ? $"covered ({cover.HoldersOnSite})" : "NOT COVERED")}")"
                                Status="@(cover.Covered ? (cover.HoldersOnSite <= 1 ? StatusKind.Warning : StatusKind.Success) : StatusKind.Danger)" />
                }
            </div>
        }

        <DataTable TItem="MusterPersonDto"
                   Items="_musterPeople"
                   Columns="_musterColumns"
                   Loading="_loading"
                   Searchable="true"
                   SearchPlaceholder="Search people on site…"
                   EmptyTitle="Nobody on site"
                   EmptyDescription="No operatives are signed in at this site right now."
                   EmptyIcon="@Icons.Material.Outlined.Groups" />
    </Body>
</DashboardCard>

@code {
    private Guid _siteId;
    private Guid _companyId;
    private IReadOnlyList<(Guid Id, string Name)> _operatives = Array.Empty<(Guid, string)>();

    private EntryDecisionResultDto? _result;
    private Guid _lastPersonId;
    private MusterDto? _muster;
    private IReadOnlyList<MusterPersonDto> _musterPeople = Array.Empty<MusterPersonDto>();
    private int _dataAgeSeconds;

    private bool _loading = true;
    private string? _error;
    private List<DataColumn<MusterPersonDto>> _musterColumns = new();

    // The active company's product, resolved by the shell before this page renders. Subcontractors get the
    // R18-safe "recorded / site-ready" wording; a null (unknown) product keeps the main-contractor decision UI.
    private OrgType? _product;
    private bool _isSubcontractor => _product == OrgType.Subcontractor;

    protected override Task OnInitializedAsync()
    {
        _product = Tenant.CurrentOrgType;
        BuildColumns();
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            await Tenant.InitializeAsync();
            _companyId = Tenant.CurrentCompanyId;

            var sites = await Sites.GetSitesAsync();
            _siteId = sites.Count > 0 ? sites[0].Id : Guid.Empty;

            var operatives = await Workforce.ListOperativesAsync();
            _operatives = operatives.Select(o => (o.PersonId, o.Name)).ToList();

            await LoadMusterAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _error = "The site gate couldn't be loaded. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMusterAsync()
    {
        if (_siteId == Guid.Empty) return;
        _muster = await SiteEntry.GetMusterAsync(_siteId);
        _musterPeople = _muster.People;
        _dataAgeSeconds = (int)(DateTimeOffset.UtcNow - _muster.GeneratedUtc).TotalSeconds;
    }

    // Runs the five-check decision for an operative (MC-8) and shows the result and every check (R10).
    private async Task DecideAsync(Guid personId)
    {
        _lastPersonId = personId;
        _result = await SiteEntry.DecideAsync(new DecideEntryRequest(_companyId, _siteId, personId, null, null));
    }

    // Day-only manager override of a blocked decision, with a reason (MC-11).
    private async Task OverrideAsync()
    {
        _result = await SiteEntry.DecideAsync(new DecideEntryRequest(
            _companyId, _siteId, _lastPersonId, null,
            new ManagerOverrideDto("You", "Escorted on site for a supervised task")));
        if (_result.Admitted)
        {
            Snackbar.Add("Entry admitted by manager override (recorded for today).", Severity.Warning);
        }
    }

    private void BuildColumns()
    {
        _musterColumns = new()
        {
            new() { Title = "Operative", Value = p => p.Name },
            new() { Title = "Property", Value = p => p.PropertyName ?? "—", Filterable = true },
            new()
            {
                Title = "On site since", Value = p => p.SinceUtc, Searchable = false,
                CellTemplate = p => @<span>@p.SinceUtc.ToString("dd MMM HH:mm")</span>
            },
        };
    }

    private static StatusKind ToStatusKind(string outcome) => outcome switch
    {
        "Passed" => StatusKind.Success,
        "Failed" => StatusKind.Danger,
        "NotRun" => StatusKind.Neutral,
        _ => StatusKind.Neutral,
    };
}
