@page "/"
@using System.Text
@using Tedwren.Abstractions.Contracts.Dashboard
@using Tedwren.Abstractions.Services
@inject IDashboardService DashboardSvc
@inject IExpiryQueryService Expiry
@inject IAuditService Audit
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Dashboard · Tedwren</PageTitle>

<PageHeader Title="Dashboard" Subtitle="Compliance and workforce overview">
    <Actions>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.CalendarToday"
                           EndIcon="@Icons.Material.Outlined.ArrowDropDown"
                           Color="Color.Default">
                    @_rangeLabel
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @foreach (var range in _ranges)
                {
                    <MudMenuItem OnClick="@(() => SelectRange(range))">@range</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Outlined.FileDownload"
                   Color="Color.Primary"
                   OnClick="ExportAsync">
            Export
        </MudButton>
    </Actions>
</PageHeader>

@* KPI row — reflows 5 / 3 / 2 / 1 across breakpoints. *@
<AsyncContent Loading="_loading" Error="@_error" ErrorTitle="Couldn't load the dashboard"
              OnRetry="LoadAsync" Variant="LoadingSkeleton.SkeletonVariant.Kpi" Rows="5">
    <div class="dash-kpis">
        @foreach (var kpi in _kpis)
        {
            <KpiCard Title="@kpi.Title"
                     Value="@kpi.Value"
                     Icon="@kpi.Icon"
                     TrendValue="@kpi.TrendValue"
                     TrendDirection="kpi.TrendDirection"
                     Sparkline="kpi.Sparkline"
                     AccentColour="@kpi.AccentColour" />
        }
    </div>
</AsyncContent>

<div class="dash-grid">
    <div class="dash-grid__col dash-grid__col--wide">
        <DashboardCard Title="Site risk heatmap"
                       Subtitle="Workforce compliance by active site"
                       FooterLinkText="View all sites"
                       FooterLinkHref="/sites">
            <Body>
                <AsyncContent Loading="_loading" Variant="LoadingSkeleton.SkeletonVariant.Table" Rows="5"
                              IsEmpty="@(_sites.Count == 0)" EmptyTitle="No active sites"
                              EmptyDescription="Site compliance appears here once sites are set up.">
                <div class="dash-table-wrap">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th class="dash-table__num">Operatives</th>
                                <th class="dash-table__num">Compliance</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sites)
                            {
                                <tr>
                                    <td class="dash-table__site">@row.Site</td>
                                    <td class="dash-table__num">@row.Operatives</td>
                                    <td class="dash-table__num">@(row.CompliancePercent is null ? "—" : row.CompliancePercent.Value.ToString("0") + "%")</td>
                                    <td><StatusPill Label="@row.StatusLabel" Status="ComplianceStatusView.ToStatusKind(row.State)" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </AsyncContent>
            </Body>
        </DashboardCard>
    </div>

    <div class="dash-grid__col">
        <DashboardCard Title="Compliance overview"
                       FooterLinkText="Open compliance"
                       FooterLinkHref="/compliance">
            <Body>
                <AsyncContent Loading="_loading" Variant="LoadingSkeleton.SkeletonVariant.Card" Rows="3">
                <div class="dash-compliance">
                    <DonutStat Segments="_compliance.Segments"
                               CentreValue="@_compliance.HeadlinePercent"
                               CentreLabel="@_compliance.HeadlineLabel" />
                    <LegendList Items="_compliance.Legend" />
                </div>
                </AsyncContent>
            </Body>
        </DashboardCard>
    </div>

    <div class="dash-grid__col dash-grid__col--wide">
        <DashboardCard Title="Upcoming expiries"
                       Subtitle="Qualifications due in the next 30 days"
                       FooterLinkText="View all expiries"
                       FooterLinkHref="/compliance">
            <Body>
                <AsyncContent Loading="_loading" Variant="LoadingSkeleton.SkeletonVariant.List" Rows="4">
                    <ExpiryList Items="_expiries" />
                </AsyncContent>
            </Body>
        </DashboardCard>
    </div>

    <div class="dash-grid__col">
        <DashboardCard Title="Recent activity"
                       FooterLinkText="View audit log"
                       FooterLinkHref="/audit-log">
            <Body>
                <AsyncContent Loading="_loading" Variant="LoadingSkeleton.SkeletonVariant.List" Rows="4">
                    <ActivityFeed Items="_activity" />
                </AsyncContent>
            </Body>
        </DashboardCard>
    </div>
</div>

@code {
    private IReadOnlyList<KpiTile> _kpis = Array.Empty<KpiTile>();
    private ComplianceOverviewVm _compliance = ComplianceOverviewView.From(new ComplianceBreakdownDto(null, 0, 0, 0, 0, 0));
    private IReadOnlyList<ExpiryItem> _expiries = Array.Empty<ExpiryItem>();
    private IReadOnlyList<ActivityItem> _activity = Array.Empty<ActivityItem>();
    private IReadOnlyList<SiteRiskRowDto> _sites = Array.Empty<SiteRiskRowDto>();

    private static readonly string[] _ranges = { "This week", "Last 30 days", "Last 90 days", "Year to date" };
    private string _rangeLabel = "This week";

    private bool _loading = true;
    private string? _error;

    private const int ExpiryWindowDays = 30;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Loads the dashboard entirely from the Web API: KPIs / compliance / site risk from the aggregation
    // service, upcoming expiries from the expiry engine (SF-9) and recent activity from the audit trail (SF-20).
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var summary = await DashboardSvc.GetSummaryAsync();
            _kpis = BuildKpis(summary.Kpis);
            _compliance = ComplianceOverviewView.From(summary.Compliance);
            _sites = summary.SiteRisk;

            var upcoming = await Expiry.GetUpcomingAsync(ExpiryWindowDays);
            _expiries = upcoming
                .Select(e => new ExpiryItem(
                    e.QualificationName, "—", e.ExpiresOn ?? DateOnly.MaxValue, e.DaysUntilExpiry, ExpiryStatus(e.DaysUntilExpiry)))
                .ToList();

            var audit = await Audit.SearchAsync(null, null, null, null);
            _activity = audit
                .OrderByDescending(a => a.OccurredUtc)
                .Take(6)
                .Select(a => new ActivityItem(
                    Icons.Material.Outlined.History, a.Action, $"{a.Entity} · {a.Actor}",
                    a.OccurredUtc.LocalDateTime.ToString("dd MMM HH:mm"), StatusKind.Neutral))
                .ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _error = "The dashboard couldn't be loaded. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static IReadOnlyList<KpiTile> BuildKpis(DashboardKpisDto k)
    {
        var empty = Array.Empty<double>();
        return new List<KpiTile>
        {
            new("Companies", k.Companies.ToString(), Icons.Material.Outlined.Business,
                null, TrendDirection.None, empty, "var(--color-brand)"),
            new("Active operatives", k.Operatives.ToString(), Icons.Material.Outlined.Engineering,
                null, TrendDirection.None, empty, "var(--color-info)"),
            new("Compliant workforce", k.CompliancePercent is null ? "—" : $"{k.CompliancePercent.Value:0}%",
                Icons.Material.Outlined.VerifiedUser, null, TrendDirection.None, empty, "var(--color-success)"),
            new("Active sites", k.Sites.ToString(), Icons.Material.Outlined.Apartment,
                null, TrendDirection.None, empty, "var(--color-info)"),
            new("Expiring in 30 days", k.UpcomingExpiries.ToString(), Icons.Material.Outlined.Schedule,
                null, TrendDirection.None, empty, "var(--color-warning)"),
        };
    }

    private static StatusKind ExpiryStatus(int daysUntilExpiry) => daysUntilExpiry switch
    {
        <= 7 => StatusKind.Danger,
        <= 30 => StatusKind.Warning,
        _ => StatusKind.Info,
    };

    // Sets the reporting period shown on the dashboard.
    private void SelectRange(string range) => _rangeLabel = range;

    // Exports the site risk heatmap to a CSV file the browser downloads.
    private async Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("Site,Operatives,Compliance,Status");
        foreach (var row in _sites)
        {
            var percent = row.CompliancePercent is null ? "" : row.CompliancePercent.Value.ToString("0") + "%";
            csv.AppendLine($"{Escape(row.Site)},{row.Operatives},{percent},{Escape(row.StatusLabel)}");
        }

        var fileName = $"tedwren-site-risk-{DateTime.Now:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("tedwrenDownload", fileName, "text/csv", csv.ToString());
        Snackbar.Add($"Exported {_sites.Count} sites to {fileName}.", Severity.Success);
    }

    // Quotes a CSV field when it contains a comma or quote.
    private static string Escape(string value)
        => value.Contains(',') || value.Contains('"')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;
}
