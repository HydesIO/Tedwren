@inherits LayoutComponentBase
@implements IDisposable
@inject IShellSampleDataService Shell
@inject IListSampleDataService ListData
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Application shell: theme provider + sidebar + top bar + routed content. *@

<MudThemeProvider Theme="@TedwrenTheme.Instance" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell @(_sidebarCollapsed ? "app-shell--collapsed" : null) @(_isDark ? "theme-dark" : null)">
    <CommandPalette Items="_commandItems" @bind-IsOpen="_paletteOpen" OnSelect="OnCommandSelect" />
    <aside class="app-shell__sidebar">
        <AppSidebar NavItems="_navItems"
                    LogoUrl="images/logo-icon.svg"
                    BrandName="Tedwren"
                    ActiveRoute="@_activeRoute"
                    @bind-IsCollapsed="_sidebarCollapsed"
                    Platforms="@Shell.GetPlatforms()"
                    SelectedPlatform="@_selectedPlatform"
                    OnPlatformSelected="OnPlatformSelected"
                    Environment="_environment"
                    OnNavigate="OnNavigate" />
    </aside>

    <div class="app-shell__main">
        <AppTopBar PageTitle="@_pageTitle"
                   Notifications="_notifications"
                   NotificationsHref="/notifications"
                   CurrentUserName="@_user.Name"
                   CurrentUserRole="@_user.Role"
                   CurrentUserAvatarUrl="@_user.AvatarUrl"
                   ShowMenuButton="true"
                   IsDark="_isDark"
                   OnMenuClick="ToggleSidebar"
                   OnOpenSearch="OpenPalette"
                   OnToggleTheme="ToggleTheme" />

        <main class="app-shell__content" role="main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private IReadOnlyList<NavItem> _navItems = Array.Empty<NavItem>();
    private string _selectedPlatform = string.Empty;
    private ShellUser _user = new("", "");
    private AppSidebar.EnvironmentInfo? _environment;
    private string _activeRoute = "/";
    private string _pageTitle = "Dashboard";
    private IReadOnlyList<NotificationEntry> _notifications = Array.Empty<NotificationEntry>();

    private bool _isDark;
    private bool _paletteOpen;
    private IReadOnlyList<CommandItem> _commandItems = Array.Empty<CommandItem>();
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override void OnInitialized()
    {
        _navItems = Shell.GetNavItems();
        _selectedPlatform = Shell.GetSelectedPlatform();
        _user = Shell.GetCurrentUser();
        _notifications = Shell.GetNotifications();

        var env = Shell.GetEnvironment();
        _environment = new AppSidebar.EnvironmentInfo(env.Name, env.Version, env.Build, env.IsHealthy);

        _commandItems = BuildCommandItems();

        Nav.LocationChanged += OnLocationChanged;
        UpdateActiveRoute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("tedwren.shortcuts.register", _selfRef);
            var stored = await JS.InvokeAsync<string>("tedwren.theme.get");
            if (stored == "dark" && !_isDark)
            {
                _isDark = true;
                StateHasChanged();
            }
        }
        catch { /* JS not available (e.g. prerender) */ }
    }

    [JSInvokable]
    public void OnCommandKey()
    {
        _paletteOpen = true;
        StateHasChanged();
    }

    private void OpenPalette() => _paletteOpen = true;

    private void OnCommandSelect(CommandItem item) => Nav.NavigateTo(item.Href);

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        try { await JS.InvokeVoidAsync("tedwren.theme.set", _isDark ? "dark" : "light"); }
        catch { /* ignore */ }
    }

    private IReadOnlyList<CommandItem> BuildCommandItems()
    {
        var items = new List<CommandItem>();

        foreach (var nav in _navItems)
        {
            items.Add(new CommandItem(nav.Label, "Pages", nav.Icon, nav.Href, "Go to page"));
        }

        foreach (var c in ListData.GetCompanies())
        {
            items.Add(new CommandItem(c.Name, "Companies", MudBlazor.Icons.Material.Outlined.Business,
                $"/organisation/{Slugs.From(c.Name)}", c.Trade));
        }

        foreach (var o in ListData.GetOperatives())
        {
            items.Add(new CommandItem(o.Name, "Operatives", MudBlazor.Icons.Material.Outlined.Engineering,
                $"/workforce/{Slugs.From(o.Name)}", $"{o.Trade} · {o.Company}"));
        }

        foreach (var s in ListData.GetSites())
        {
            items.Add(new CommandItem(s.Name, "Sites", MudBlazor.Icons.Material.Outlined.Apartment,
                $"/sites/{Slugs.From(s.Name)}", s.Region));
        }

        return items;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateActiveRoute();
        StateHasChanged();
    }

    private void UpdateActiveRoute()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        _activeRoute = relative == "/" ? "/" : "/" + relative.TrimStart('/').Split('?', '#')[0];

        var rel = _activeRoute.TrimStart('/');
        if (rel.Length == 0)
        {
            _pageTitle = _navItems.FirstOrDefault(n => n.Href == "/")?.Label ?? "Dashboard";
            return;
        }

        // Longest-prefix match so sub-routes (e.g. /organisation/add) inherit their
        // section's title; otherwise fall back to a title-cased last segment.
        var match = _navItems
            .Where(n => n.Href != "/" && rel.StartsWith(n.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(n => n.Href.Length)
            .FirstOrDefault();

        _pageTitle = match?.Label ?? Titleize(rel.Split('/')[^1]);
    }

    private static string Titleize(string segment)
    {
        var words = segment.Replace('-', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    private void OnNavigate(NavItem item) => Nav.NavigateTo(item.Href);

    private void OnPlatformSelected(string platform) => _selectedPlatform = platform;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_selfRef is not null)
        {
            try { _ = JS.InvokeVoidAsync("tedwren.shortcuts.unregister"); } catch { /* ignore */ }
            _selfRef.Dispose();
        }
    }
}
