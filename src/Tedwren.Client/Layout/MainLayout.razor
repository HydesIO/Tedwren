@inherits LayoutComponentBase
@implements IDisposable
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject IShellSampleDataService Shell
@inject IEntitlementService Entitlements
@inject NavigationManager Nav

@* Application shell: theme provider + sidebar + top bar + routed content. *@

<MudThemeProvider Theme="@TedwrenTheme.Instance" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell @(_sidebarCollapsed ? "app-shell--collapsed" : null)">
    <aside class="app-shell__sidebar">
        <AppSidebar NavItems="_navItems"
                    LogoUrl="images/logo-icon.svg"
                    BrandName="Tedwren"
                    ActiveRoute="@_activeRoute"
                    @bind-IsCollapsed="_sidebarCollapsed"
                    Platforms="@Shell.GetPlatforms()"
                    SelectedPlatform="@_selectedPlatform"
                    OnPlatformSelected="OnPlatformSelected"
                    Environment="_environment"
                    OnNavigate="OnNavigate" />
    </aside>

    <div class="app-shell__main">
        <AppTopBar PageTitle="@_pageTitle"
                   Notifications="_notifications"
                   NotificationsHref="/notifications"
                   CurrentUserName="@_user.Name"
                   CurrentUserRole="@_user.Role"
                   CurrentUserAvatarUrl="@_user.AvatarUrl"
                   ShowMenuButton="true"
                   OnMenuClick="ToggleSidebar" />

        <main class="app-shell__content" role="main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private IReadOnlyList<NavItem> _navItems = Array.Empty<NavItem>();
    private string _selectedPlatform = string.Empty;
    private ShellUser _user = new("", "");
    private AppSidebar.EnvironmentInfo? _environment;
    private string _activeRoute = "/";
    private string _pageTitle = "Dashboard";
    private IReadOnlyList<NotificationEntry> _notifications = Array.Empty<NotificationEntry>();

    // Maps a gated nav route to the module a customer must hold for it to appear (SF-22). Routes absent from
    // this map are core console features and are always shown.
    private static readonly IReadOnlyDictionary<string, string> GatedRouteModules = new Dictionary<string, string>
    {
        ["/workforce"] = "workforce",
        ["/compliance"] = "compliance",
        ["/compliance-packs"] = "compliance",
        ["/inductions"] = "inductions",
        ["/induction-records"] = "inductions",
        ["/time-attendance"] = "time",
        ["/attendance"] = "time",
        ["/permits"] = "permits",
        ["/reports"] = "reports",
        ["/integrations"] = "integrations",
    };

    protected override async Task OnInitializedAsync()
    {
        _navItems = await GatedNavItemsAsync(Shell.GetNavItems());
        _selectedPlatform = Shell.GetSelectedPlatform();
        _user = Shell.GetCurrentUser();
        _notifications = Shell.GetNotifications();

        var env = Shell.GetEnvironment();
        _environment = new AppSidebar.EnvironmentInfo(env.Name, env.Version, env.Build, env.IsHealthy);

        Nav.LocationChanged += OnLocationChanged;
        UpdateActiveRoute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateActiveRoute();
        StateHasChanged();
    }

    private void UpdateActiveRoute()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        _activeRoute = relative == "/" ? "/" : "/" + relative.TrimStart('/').Split('?', '#')[0];

        var rel = _activeRoute.TrimStart('/');
        if (rel.Length == 0)
        {
            _pageTitle = _navItems.FirstOrDefault(n => n.Href == "/")?.Label ?? "Dashboard";
            return;
        }

        // Longest-prefix match so sub-routes (e.g. /organisation/add) inherit their
        // section's title; otherwise fall back to a title-cased last segment.
        var match = _navItems
            .Where(n => n.Href != "/" && rel.StartsWith(n.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(n => n.Href.Length)
            .FirstOrDefault();

        _pageTitle = match?.Label ?? Titleize(rel.Split('/')[^1]);
    }

    private static string Titleize(string segment)
    {
        var words = segment.Replace('-', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    // Removes nav items for modules the customer has not purchased (SF-22). Fails open on error so a
    // transient entitlement lookup failure never leaves the operator with an empty sidebar; the server
    // still enforces entitlements on every data call (Q2).
    private async Task<IReadOnlyList<NavItem>> GatedNavItemsAsync(IReadOnlyList<NavItem> all)
    {
        try
        {
            var entitlements = await Entitlements.GetForCompanyAsync(TenantContext.CurrentCompanyId);
            var enabled = entitlements.Where(e => e.Enabled)
                .Select(e => e.Key)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return all
                .Where(n => !GatedRouteModules.TryGetValue(n.Href, out var moduleKey) || enabled.Contains(moduleKey))
                .ToList();
        }
        catch
        {
            return all;
        }
    }

    private void OnNavigate(NavItem item) => Nav.NavigateTo(item.Href);

    private void OnPlatformSelected(string platform) => _selectedPlatform = platform;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
