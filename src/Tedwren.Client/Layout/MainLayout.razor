@inherits LayoutComponentBase
@implements IDisposable
@using Tedwren.Abstractions.Services
@using Tedwren.Client.Services
@inject Tedwren.Client.Services.AuthState Auth
@inject ICurrentUserService CurrentUser
@inject IExpiryQueryService Expiry
@inject IEntitlementService Entitlements
@inject IOrganisationService Org
@inject ISiteService SitesSvc
@inject IWorkforceService Workforce
@inject ITenantState Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AdminAreaOptions AdminArea

@* Application shell: theme provider + sidebar + top bar + routed content. *@

<MudThemeProvider Theme="@TedwrenTheme.Instance" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Hold back the shell (and the routed @Body) until sign-in has been confirmed. Rendering the routed
   page before the auth check completes would let it call the API with no bearer token and crash the
   renderer on the resulting 401 (D1) before the redirect to /login takes effect. *@
@if (_ready)
{
<div class="app-shell @(_sidebarCollapsed ? "app-shell--collapsed" : null) @(_isDark ? "theme-dark" : null)">
    <CommandPalette Items="_commandItems" @bind-IsOpen="_paletteOpen" OnSelect="OnCommandSelect" />
    <aside class="app-shell__sidebar">
        <AppSidebar NavItems="_navItems"
                    LogoUrl="images/logo-icon.svg"
                    BrandName="Tedwren"
                    ActiveRoute="@_activeRoute"
                    @bind-IsCollapsed="_sidebarCollapsed"
                    Platforms="@_platforms"
                    SelectedPlatform="@_selectedPlatform"
                    OnPlatformSelected="OnPlatformSelected"
                    Environment="_environment"
                    OnNavigate="OnNavigate" />
    </aside>

    <div class="app-shell__main">
        <AppTopBar PageTitle="@_pageTitle"
                   Notifications="_notifications"
                   NotificationsHref="/notifications"
                   CurrentUserName="@_userName"
                   CurrentUserRole="@_userRole"
                   CurrentUserAvatarUrl="@_userAvatarUrl"
                   ProfileHref="/profile"
                   ShowMenuButton="true"
                   IsDark="_isDark"
                   OnMenuClick="ToggleSidebar"
                   OnOpenSearch="OpenPalette"
                   OnToggleTheme="ToggleTheme"
                   OnSignOut="SignOut" />

        <main class="app-shell__content" role="main">
            @Body
        </main>
    </div>
</div>
}

@code {
    private bool _sidebarCollapsed;
    private IReadOnlyList<NavItem> _navItems = Array.Empty<NavItem>();
    private IReadOnlyList<string> _platforms = Array.Empty<string>();
    private string _selectedPlatform = string.Empty;

    // True when the shell is showing the Tedwren platform admin area (admin menus + /admin pages) rather
    // than the tenant console. Set once at init from the deployment flag and the signed-in user's role.
    private bool _isAdminArea;
    private string _userName = string.Empty;
    private string _userRole = string.Empty;
    private string? _userAvatarUrl;
    private AppSidebar.EnvironmentInfo? _environment;
    private string _activeRoute = "/";
    private string _pageTitle = "Dashboard";
    private IReadOnlyList<NotificationEntry> _notifications = Array.Empty<NotificationEntry>();

    private bool _isDark;
    private bool _paletteOpen;

    // Gate on the auth check: the shell and routed @Body only render once sign-in is confirmed, so an
    // unauthenticated page never calls the API (and crashes on the 401) before the /login redirect lands.
    private bool _ready;
    private IReadOnlyList<CommandItem> _commandItems = Array.Empty<CommandItem>();
    private DotNetObjectReference<MainLayout>? _selfRef;

    // Maps a gated nav route to the module a customer must hold for it to appear (SF-22). Routes absent from
    // this map are core console features and are always shown.
    private static readonly IReadOnlyDictionary<string, string> GatedRouteModules = new Dictionary<string, string>
    {
        ["/workforce"] = "workforce",
        ["/compliance"] = "compliance",
        ["/compliance-packs"] = "compliance",
        ["/inductions"] = "inductions",
        ["/induction-records"] = "inductions",
        ["/forms"] = "forms",
        ["/form-submissions"] = "forms",
        ["/time-attendance"] = "time",
        ["/attendance"] = "time",
        ["/permits"] = "permits",
        ["/reports"] = "reports",
        ["/integrations"] = "integrations",
    };

    protected override async Task OnInitializedAsync()
    {
        // Require sign-in for the console (D1). Unauthenticated users go to the login page.
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var user = await CurrentUser.GetCurrentAsync();
        _userName = user.Name;
        _userRole = user.Role;
        _userAvatarUrl = user.AvatarUrl;

        // Platform administrators (Administrator in the Tedwren tenant) see the admin area instead of the
        // tenant console, when this deployment enables it. The admin surfaces are not purchasable modules,
        // so they bypass entitlement gating and the first-run onboarding wizard.
        _isAdminArea = AdminArea.Enabled && Auth.IsPlatformAdmin;
        if (_isAdminArea)
        {
            _navItems = ShellChrome.AdminNavItems;
            _platforms = Array.Empty<string>();
            _selectedPlatform = string.Empty;
        }
        else
        {
            await Tenant.InitializeAsync();

            // First run against an empty database has no companies: send the operator to onboarding to
            // provision the first organisation. This only fires under DataSource=Database with an empty
            // Companies table. Fails open on lookup error.
            if (await ShouldOnboardAsync())
            {
                Nav.NavigateTo("/onboarding");
                return;
            }

            _navItems = await GatedNavItemsAsync(ShellChrome.NavItems);
            _platforms = ShellChrome.Platforms;
            _selectedPlatform = ShellChrome.DefaultPlatform;
        }

        _notifications = await BuildNotificationsAsync();

        var env = ShellChrome.Environment;
        _environment = new AppSidebar.EnvironmentInfo(env.Name, env.Version, env.Build, env.IsHealthy);

        _commandItems = await BuildCommandItemsAsync();

        Nav.LocationChanged += OnLocationChanged;
        UpdateActiveRoute();

        // Auth confirmed and the shell is populated: allow the routed page to render.
        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("tedwren.shortcuts.register", _selfRef);
            var stored = await JS.InvokeAsync<string>("tedwren.theme.get");
            if (stored == "dark" && !_isDark)
            {
                _isDark = true;
                StateHasChanged();
            }
        }
        catch { /* JS not available (e.g. prerender) */ }
    }

    [JSInvokable]
    public void OnCommandKey()
    {
        _paletteOpen = true;
        StateHasChanged();
    }

    private void OpenPalette() => _paletteOpen = true;

    private async Task OnCommandSelect(CommandItem item)
    {
        if (item.Href == "action:logout")
        {
            await Auth.LogoutAsync();
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        Nav.NavigateTo(item.Href);
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        try { await JS.InvokeVoidAsync("tedwren.theme.set", _isDark ? "dark" : "light"); }
        catch { /* ignore */ }
    }

    private async Task<IReadOnlyList<CommandItem>> BuildCommandItemsAsync()
    {
        var items = new List<CommandItem>();

        foreach (var nav in _navItems)
        {
            items.Add(new CommandItem(nav.Label, "Pages", nav.Icon, nav.Href, "Go to page"));
        }

        items.Add(new CommandItem("Sign out", "Account", MudBlazor.Icons.Material.Outlined.Logout, "action:logout", "End your session"));

        // Search index built from real API data (companies, operatives, sites).
        foreach (var c in await Org.GetCompaniesAsync())
        {
            items.Add(new CommandItem(c.Name, "Companies", MudBlazor.Icons.Material.Outlined.Business,
                $"/organisation/{c.Slug}", c.Trade));
        }

        foreach (var o in await Workforce.ListOperativesAsync())
        {
            items.Add(new CommandItem(o.Name, "Operatives", MudBlazor.Icons.Material.Outlined.Engineering,
                $"/workforce/{o.Slug}", $"{o.Trade} · {o.Company}"));
        }

        foreach (var s in await SitesSvc.GetSitesAsync())
        {
            items.Add(new CommandItem(s.Name, "Sites", MudBlazor.Icons.Material.Outlined.Apartment,
                $"/sites/{s.Slug}", s.Region));
        }

        return items;
    }

    // Builds the top-bar notifications from real upcoming qualification expiries (SF-9).
    private async Task<IReadOnlyList<NotificationEntry>> BuildNotificationsAsync()
    {
        var upcoming = await Expiry.GetUpcomingAsync(30);
        return upcoming
            .Take(10)
            .Select(e => new NotificationEntry(
                MudBlazor.Icons.Material.Outlined.WarningAmber,
                "Qualification expiring",
                $"{e.QualificationName} — {e.StatusLabel}",
                e.ExpiresOn?.ToString("dd MMM yyyy") ?? string.Empty,
                e.DaysUntilExpiry <= 7 ? StatusKind.Danger : StatusKind.Warning,
                Unread: true))
            .ToList();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateActiveRoute();
        StateHasChanged();
    }

    private void UpdateActiveRoute()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        _activeRoute = relative == "/" ? "/" : "/" + relative.TrimStart('/').Split('?', '#')[0];

        var rel = _activeRoute.TrimStart('/');
        if (rel.Length == 0)
        {
            _pageTitle = _navItems.FirstOrDefault(n => n.Href == "/")?.Label ?? "Dashboard";
            return;
        }

        // Longest-prefix match so sub-routes (e.g. /organisation/add) inherit their
        // section's title; otherwise fall back to a title-cased last segment.
        var match = _navItems
            .Where(n => n.Href != "/" && rel.StartsWith(n.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(n => n.Href.Length)
            .FirstOrDefault();

        _pageTitle = match?.Label ?? Titleize(rel.Split('/')[^1]);
    }

    private static string Titleize(string segment)
    {
        var words = segment.Replace('-', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    // Removes nav items for modules the customer has not purchased (SF-22). Fails open on error so a
    // transient entitlement lookup failure never leaves the operator with an empty sidebar; the server
    // still enforces entitlements on every data call (Q2).
    private async Task<IReadOnlyList<NavItem>> GatedNavItemsAsync(IReadOnlyList<NavItem> all)
    {
        try
        {
            var entitlements = await Entitlements.GetForCompanyAsync(Tenant.CurrentCompanyId);
            var enabled = entitlements.Where(e => e.Enabled)
                .Select(e => e.Key)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return all
                .Where(n => !GatedRouteModules.TryGetValue(n.Href, out var moduleKey) || enabled.Contains(moduleKey))
                .ToList();
        }
        catch
        {
            return all;
        }
    }

    // True when there are no companies yet, so the first-run onboarding wizard should take over. Guarded so
    // it never fires while already on the wizard, and fails closed (no redirect) on a lookup error.
    private async Task<bool> ShouldOnboardAsync()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?', '#')[0];
        if (relative.StartsWith("/onboarding", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        try
        {
            var companies = await Org.GetCompaniesAsync();
            return companies.Count == 0;
        }
        catch
        {
            return false;
        }
    }

    // Signs the operator out from the profile dropdown, mirroring the command-palette logout: clear the token
    // and force a full reload to /login so no stale authenticated state survives.
    private async Task SignOut()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void OnNavigate(NavItem item) => Nav.NavigateTo(item.Href);

    private void OnPlatformSelected(string platform) => _selectedPlatform = platform;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_selfRef is not null)
        {
            try { _ = JS.InvokeVoidAsync("tedwren.shortcuts.unregister"); } catch { /* ignore */ }
            _selfRef.Dispose();
        }
    }
}
