@inherits LayoutComponentBase

@* Minimal, distraction-free shell for the onboarding wizard: a plain, centered card area on a sunken
   background. No app bar, no sidebar, no console navigation — a brand-new customer (or a tester adding a
   client) sets up their organisation without the full app chrome. The wizard itself carries the brand
   mark in its top-left, so the shell stays chrome-free. *@

<MudThemeProvider Theme="@TedwrenTheme.Instance" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="onboarding-shell">
    <main class="onboarding-shell__content" role="main">
        @Body
    </main>
</div>
