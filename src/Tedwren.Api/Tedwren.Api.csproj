<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Direct reference overrides the vulnerable Microsoft.OpenApi 2.0.0 pulled in transitively
         by Microsoft.AspNetCore.OpenApi (advisory GHSA-v5pm-xwqc-g5wc / NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedwren.Abstractions\Tedwren.Abstractions.csproj" />
    <ProjectReference Include="..\Tedwren.Application\Tedwren.Application.csproj" />
    <ProjectReference Include="..\Tedwren.DataAccess\Tedwren.DataAccess.csproj" />
    <ProjectReference Include="..\Tedwren.DataAccess.Commercial\Tedwren.DataAccess.Commercial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The email logo is embedded and served from an anonymous endpoint so email clients can load it by
         absolute URL (SVG isn't rendered by Outlook/Gmail, so a PNG is used). -->
    <EmbeddedResource Include="Assets\logo.png" LogicalName="Tedwren.Api.Assets.logo.png" />
  </ItemGroup>

</Project>
