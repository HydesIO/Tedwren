{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSource": {
    "Mode": "Mock",
    "Provider": "SqlServer"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "ConnectionStrings": {
    "SqlServer": "",
    "PostgreSql": ""
  },
  "Jobs": {
    "SchedulerEnabled": true,
    "InitialDelaySeconds": 30,
    "IntervalHours": 24
  }
}
