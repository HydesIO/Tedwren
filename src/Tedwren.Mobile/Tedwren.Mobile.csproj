<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tedwren.Mobile — the .NET MAUI field app head (Android + iOS only). Thin by design: logic lives in
    Tedwren.Mobile.Core (unit-tested) and the design system + controls in Tedwren.Mobile.Controls. Builds on a
    MAUI-capable machine/CI with the maui-android / maui-ios workloads — see docs/mobile-app-build.md. The app
    UI is authored in C# (no XAML pages) so it stays buildable and reviewable; the design tokens are merged from
    the control kit's resource dictionaries.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tedwren.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App identity -->
    <ApplicationTitle>Tedwren</ApplicationTitle>
    <ApplicationId>io.hydes.tedwren</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the Tedwren "T" mark (white/transparent) on the brand-orange tile. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#E8590C" />

    <!-- Splash: primary-colour (brand-orange) background with the white Tedwren logo. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#E8590C" BaseSize="160,160" />

    <!-- Fonts (Inter) are bundled once the OFL .ttf files are added — see Resources/Fonts/README.md. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Encrypted local store (M5): SQLCipher-backed SQLite. .Core (no default bundle) + the e_sqlcipher bundle
         so the DB is AES-256 encrypted at rest with the key held in the OS secure enclave (ISecureStore). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedwren.Mobile.Core\Tedwren.Mobile.Core.csproj" />
    <ProjectReference Include="..\Tedwren.Mobile.Controls\Tedwren.Mobile.Controls.csproj" />
  </ItemGroup>

  <!-- Android biometric prompt (M8, BiometricPrompt). Android-only; the version tracks the installed MAUI
       workload's AndroidX set — confirm/adjust on the first CI build (docs/mobile-store-readiness.md). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.29" />
  </ItemGroup>

  <!-- Apple privacy manifest (M8) — required for App Store submission; declares data use + required-reason APIs. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" />
  </ItemGroup>

</Project>
